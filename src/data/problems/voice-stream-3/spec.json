    {"argsPy": "w = 10**5\nL = \"abcdefghijklmnopqrstuvwxyz\"\nops = [\"StreamReceiver\", \"set_delay\"]; xs = [[w], [200000]]\nfor i in range(1, 60001):\n    ops += [\"receive\", \"play\"]; xs += [[i, L[i % 26], 2 * i], [2 * i + 1]]\nops.append(\"play\"); xs.append([400000])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 6 * 10^4 packets wait behind a gap, a play after each", "perf": true},
    {"argsPy": "r = rng(8)\nL = \"abcdefghijklmnopqrstuvwxyz\"\nops = [\"StreamReceiver\", \"set_delay\"]; xs = [[256], [60]]\norder = []\nfor s in range(100000):\n    if r.random() < 0.05:\n        continue\n    order.append((20 * s + r.randint(0, 100), s))\n    if r.random() < 0.05:\n        order.append((20 * s + r.randint(0, 400), s))\norder.sort()\nfor k, (at, s) in enumerate(order):\n    ops.append(\"receive\"); xs.append([s, L[s % 26], at])\n    if k % 4 == 3:\n        ops.append(\"play\"); xs.append([at])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 10^5 seqs, 5% lost, silence fills the gaps", "perf": true},
