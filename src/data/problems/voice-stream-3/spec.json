{
  "id": "voice-stream-3",
  "title": "Voice Stream: Latency Budget",
  "difficulty": "M",
  "topics": ["design", "hash map", "queue", "sliding window"],
  "kind": "design",
  "className": "StreamReceiver",
  "starter": "class StreamReceiver:\n\n    def __init__(self, window: int):\n        pass\n\n    def receive(self, seq: int, data: str, t: int) -> bool:\n        pass\n\n    def play(self, t: int) -> List[Optional[str]]:\n        pass\n\n    def set_delay(self, delay: int) -> None:\n        pass\n",
  "tests": [
    {"ops": ["StreamReceiver", "set_delay", "receive", "receive", "play", "play", "receive"], "args": [[8], [100], [0, "good", 0], [2, "ning", 10], [50], [110], [1, "mor", 120]], "expected": [null, null, true, true, ["good"], [null, "ning"], false], "show": true},
    {"ops": ["StreamReceiver", "set_delay", "receive", "receive", "play"], "args": [[8], [50], [3, "how", 0], [1, "mor", 40], [60]], "expected": [null, null, true, true, [null, "mor", null, "how"]], "show": true},
    {"ops": ["StreamReceiver", "set_delay", "receive", "receive", "play", "play"], "args": [[8], [50], [1, "mor", 0], [3, "how", 30], [60], [80]], "expected": [null, null, true, true, [null, "mor"], [null, "how"]], "show": true},
    {"ops": ["StreamReceiver", "receive", "receive", "play"], "args": [[8], [0, "ba", 0], [2, "di", 0], [1000000000]], "expected": [null, true, true, ["ba"]], "label": "no delay set: a gap still waits forever"},
    {"ops": ["StreamReceiver", "set_delay", "receive", "play", "play"], "args": [[8], [30], [1, "ce", 10], [39], [40]], "expected": [null, null, true, [], [null, "ce"]], "label": "waited exactly the delay"},
    {"ops": ["StreamReceiver", "set_delay", "receive", "play"], "args": [[8], [0], [2, "di", 5], [5]], "expected": [null, null, true, [null, null, "di"]], "label": "delay 0: no waiting while audio is buffered"},
    {"ops": ["StreamReceiver", "set_delay", "receive", "play", "receive", "play", "play"], "args": [[8], [10], [0, "ba", 0], [100], [3, "fo", 200], [205], [210]], "expected": [null, null, true, ["ba"], true, [], [null, null, "fo"]], "label": "no silence once the buffer is empty"},
    {"ops": ["StreamReceiver", "set_delay", "receive", "receive", "play", "play"], "args": [[8], [50], [0, "ba", 0], [2, "di", 40], [60], [90]], "expected": [null, null, true, true, ["ba"], [null, "di"]], "label": "the oldest packet has already played"},
