    {"argsPy": "r = rng(303)\nops, xs = [\"Checkout\"], [[]]\nfor i in range(300):\n    ops.append(\"add_weighed\"); xs.append([\"W\" + str(i), \"Produce\", r.randint(1, 10**5)])\n    ops.append(\"add_product\"); xs.append([\"U\" + str(i), \"Packet\", r.randint(1, 10**4)])\nfor _ in range(500):\n    if r.random() < 0.7:\n        ops.append(\"scan\"); xs.append([\"W\" + str(r.randrange(300)), r.choice([500, 1500, r.randint(1, 10**4)])])\n    else:\n        ops.append(\"scan\"); xs.append([\"U\" + str(r.randrange(300)), r.randint(1, 100)])\nfor _ in range(500):\n    ops.append(\"total\"); xs.append([])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 500 weighed and unit scans, then 500 totals", "perf": true},
