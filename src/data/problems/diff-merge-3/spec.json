{
  "id": "diff-merge-3",
  "title": "Diff & Merge: Three-Way Merge",
  "difficulty": "H",
  "topics": ["design", "dynamic programming", "two pointers"],
  "kind": "design",
  "className": "DiffTool",
  "starter": "class DiffTool:\n\n    def __init__(self):\n        pass\n\n    def diff(self, a: List[str], b: List[str]) -> List[str]:\n        pass\n\n    def unified(self, a: List[str], b: List[str], context: int) -> List[str]:\n        pass\n\n    def merge(self, base: List[str], ours: List[str], theirs: List[str]) -> List[str]:\n        pass\n",
  "tests": [
    {"ops": ["DiffTool", "merge"], "args": [[], [["flour", "sugar", "eggs", "milk", "salt"], ["flour", "brown sugar", "eggs", "oat milk", "salt"], ["flour", "sugar", "eggs", "oat milk", "salt", "vanilla"]]], "expected": [null, ["flour", "brown sugar", "eggs", "oat milk", "salt", "vanilla"]], "show": true},
    {"ops": ["DiffTool", "merge"], "args": [[], [["host = alpha", "port = 80", "debug = off"], ["host = alpha", "port = 8080", "debug = off"], ["host = alpha", "port = 443", "debug = off"]]], "expected": [null, ["host = alpha", "<<<<<<< ours", "port = 8080", "=======", "port = 443", ">>>>>>> theirs", "debug = off"]], "show": true},
    {"ops": ["DiffTool", "merge"], "args": [[], [["one", "two", "three", "four"], ["one", "TWO", "three", "four"], ["one", "two", "THREE", "four"]]], "expected": [null, ["one", "<<<<<<< ours", "TWO", "three", "=======", "two", "THREE", ">>>>>>> theirs", "four"]], "show": true},
    {"ops": ["DiffTool", "merge"], "args": [[], [["a", "b", "c"], ["a", "b", "c"], ["a", "b", "c"]]], "expected": [null, ["a", "b", "c"]], "label": "nothing changed"},
    {"ops": ["DiffTool", "merge"], "args": [[], [[], [], []]], "expected": [null, []], "label": "all three files empty"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["a", "b", "c"], ["a", "x", "c", "d"], ["a", "b", "c"]]], "expected": [null, ["a", "x", "c", "d"]], "label": "only ours changed"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["a", "b", "c"], ["a", "B", "c"], ["a", "B", "c"]]], "expected": [null, ["a", "B", "c"]], "label": "both made the same edit"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["a", "b", "c"], ["a", "c"], ["a", "c"]]], "expected": [null, ["a", "c"]], "label": "both deleted the same line"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["a", "b", "c"], ["a", "c"], ["a", "B", "c"]]], "expected": [null, ["a", "<<<<<<< ours", "=======", "B", ">>>>>>> theirs", "c"]], "label": "ours deleted a line that theirs changed"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["a", "b"], ["a", "x", "b"], ["a", "y", "b"]]], "expected": [null, ["a", "<<<<<<< ours", "x", "=======", "y", ">>>>>>> theirs", "b"]], "label": "both inserted different lines in the same place"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["a", "b"], ["a", "x", "b"], ["a", "x", "b"]]], "expected": [null, ["a", "x", "b"]], "label": "both inserted the same line in the same place"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["m"], ["s", "m"], ["m", "e"]]], "expected": [null, ["s", "m", "e"]], "label": "insertions at the two ends"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["a"], ["a", "x"], ["a", "y"]]], "expected": [null, ["a", "<<<<<<< ours", "x", "=======", "y", ">>>>>>> theirs"]], "label": "both appended different lines"},
    {"ops": ["DiffTool", "merge"], "args": [[], [[], ["p"], ["q"]]], "expected": [null, ["<<<<<<< ours", "p", "=======", "q", ">>>>>>> theirs"]], "label": "empty base, two different new files"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["a", "b"], [], ["a", "B"]]], "expected": [null, ["<<<<<<< ours", "=======", "a", "B", ">>>>>>> theirs"]], "label": "one side emptied the file, the other edited it"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["1", "2", "3", "4", "5"], ["1", "two", "3", "4", "5"], ["1", "2", "3", "four", "5"]]], "expected": [null, ["1", "two", "3", "four", "5"]], "label": "one stable line between two edits is enough"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["1", "2", "3", "4", "5"], ["1", "two", "3", "four", "5"], ["1", "2", "three", "4", "5"]]], "expected": [null, ["1", "<<<<<<< ours", "two", "3", "four", "=======", "2", "three", "4", ">>>>>>> theirs", "5"]], "label": "one chunk spans edits from both sides"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["y", "x", "y"], ["x", "y", "x"], ["x", "x", "y", "y"]]], "expected": [null, ["x", "x", "y", "y", "x"]], "label": "repeated lines: the merge follows diff's choices"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["", "a", ""], ["", "a", "b", ""], ["a", ""]]], "expected": [null, ["a", "b", ""]], "label": "empty lines"},
    {"ops": ["DiffTool", "merge", "diff", "unified", "merge"], "args": [[], [["k", "l"], ["k", "L"], ["k", "l", "m"]], [["k", "l"], ["k", "L"]], [["k", "l"], ["k", "l", "m"], 0], [["k", "l"], ["k"], ["l"]]], "expected": [null, ["k", "<<<<<<< ours", "L", "=======", "l", "m", ">>>>>>> theirs"], [" k", "-l", "+L"], ["@@ -2,0 +3,1 @@", "+m"], ["<<<<<<< ours", "k", "=======", "l", ">>>>>>> theirs"]], "label": "merge, diff and unified in one test"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["p", "r", "r", "p", "p", "r", "r", "r"], ["r", "r", "r", "p", "p", "r", "r"], ["p", "r", "r", "r", "p", "p", "r", "r"]]], "expected": [null, ["r", "r", "r", "p", "p", "r", "r"]], "label": "random 1"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["s", "s", "s", "q", "r", "r", "q", "s", "s", "r", "q", "r", "s", "q"], ["s", "s", "s", "q", "r", "r", "q", "s", "r", "q", "r", "s"], ["p", "s", "s", "s", "q", "r", "q", "s", "s", "r", "q", "s", "T", "q"]]], "expected": [null, ["p", "s", "s", "s", "q", "r", "q", "s", "r", "q", "s", "<<<<<<< ours", "=======", "T", "q", ">>>>>>> theirs"]], "label": "random 2"},
    {"ops": ["DiffTool", "merge"], "args": [[], [["s", "p", "r", "s", "q", "p", "s", "q", "s", "p", "q", "r", "r", "s", "t", "r", "t", "p", "r", "p", "t", "t", "p", "r", "r", "r", "t", "s", "s", "p", "r", "q", "s", "r", "t", "s", "q", "t", "s", "t"], ["s", "p", "r", "t", "q", "r", "s", "O", "q", "s", "p", "O", "r", "r", "s", "t", "r", "t", "p", "p", "t", "t", "p", "r", "p", "r", "r", "t", "s", "s", "t", "r", "q", "s", "r", "t", "s", "q", "t", "s", "t"], ["r", "s", "q", "p", "s", "q", "s", "p", "q", "r", "r", "s", "t", "r", "t", "p", "r", "r", "p", "t", "t", "p", "r", "r", "r", "t", "s", "s", "p", "r", "q", "s", "r", "T", "t", "T", "q", "t", "s", "t", "t"]]], "expected": [null, ["r", "t", "q", "r", "s", "O", "q", "s", "p", "O", "r", "r", "s", "t", "r", "t", "p", "<<<<<<< ours", "=======", "r", "r", ">>>>>>> theirs", "p", "t", "t", "p", "r", "p", "r", "r", "t", "s", "s", "t", "r", "q", "s", "r", "T", "t", "T", "q", "t", "s", "t", "t"]], "label": "random 3"},
    {"argsPy": "r = rng(3030)\nbase = ['line ' + str(k) for k in range(1, 9951)]\ndef edit(tag):\n    plan = {r.randint(4800, 5200): r.choice('rrid') for _ in range(40)}\n    out = []\n    for k, line in enumerate(base):\n        kind = plan.get(k)\n        if kind == 'r':\n            out.append(tag + ' ' + str(k))\n        elif kind == 'i':\n            out += [line, tag + ' new ' + str(k)]\n        elif kind is None:\n            out.append(line)\n    return out\nours = edit('ours')\ntheirs = edit('theirs')\nargs = {'ops': ['DiffTool', 'merge', 'merge'], 'args': [[], [base, ours, theirs], [base, theirs, ours]]}", "expected": null, "label": "large: 10^4-line files, both sides edit the middle, merged both ways", "perf": true},
    {"argsPy": "r = rng(500500)\nwords = ['{', '}', '', 'x += 1', 'y -= 1', 'return x', 'print(y)', 'if x:']\nbase = [r.choice(words) for _ in range(460)]\ndef edit():\n    plan = {r.randint(0, 459): r.choice('rid') for _ in range(40)}\n    out = []\n    for k, line in enumerate(base):\n        kind = plan.get(k)\n        if kind == 'r':\n            out.append(r.choice(words))\n        elif kind == 'i':\n            out += [line, r.choice(words)]\n        elif kind is None:\n            out.append(line)\n    return out\nours = edit()\ntheirs = edit()\nargs = {'ops': ['DiffTool', 'merge'], 'args': [[], [base, ours, theirs]]}", "expected": [null, ["print(y)", "}", "print(y)", "return x", "{", "return x", "}", "print(y)", "return x", "}", "return x", "", "", "y -= 1", "if x:", "print(y)", "{", "{", "if x:", "if x:", "x += 1", "print(y)", "print(y)", "x += 1", "y -= 1", "print(y)", "print(y)", "print(y)", "}", "", "if x:", "{", "return x", "if x:", "", "if x:", "return x", "}", "{", "<<<<<<< ours", "{", "=======", "return x", ">>>>>>> theirs", "", "", "return x", "", "if x:", "y -= 1", "}", "<<<<<<< ours", "", "if x:", "=======", ">>>>>>> theirs", "y -= 1", "print(y)", "", "x += 1", "return x", "x += 1", "x += 1", "if x:", "if x:", "}", "y -= 1", "", "", "y -= 1", "y -= 1", "return x", "if x:", "if x:", "y -= 1", "{", "if x:", "print(y)", "print(y)", "", "y -= 1", "x += 1", "if x:", "return x", "", "print(y)", "print(y)", "{", "y -= 1", "print(y)", "x += 1", "return x", "}", "", "if x:", "{", "y -= 1", "if x:", "}", "}", "x += 1", "}", "", "}", "x += 1", "if x:", "y -= 1", "", "{", "print(y)", "print(y)", "print(y)", "}", "x += 1", "x += 1", "}", "<<<<<<< ours", "print(y)", "=======", "}", "{", ">>>>>>> theirs", "", "", "if x:", "print(y)", "return x", "y -= 1", "{", "}", "if x:", "}", "}", "print(y)", "{", "", "x += 1", "}", "y -= 1", "print(y)", "y -= 1", "y -= 1", "if x:", "}", "print(y)", "{", "return x", "{", "", "return x", "print(y)", "}", "print(y)", "print(y)", "y -= 1", "if x:", "}", "print(y)", "", "x += 1", "return x", "{", "", "y -= 1", "print(y)", "if x:", "{", "y -= 1", "print(y)", "return x", "return x", "", "x += 1", "if x:", "x += 1", "y -= 1", "{", "{", "<<<<<<< ours", "x += 1", "=======", "{", ">>>>>>> theirs", "print(y)", "if x:", "if x:", "{", "return x", "}", "if x:", "print(y)", "{", "if x:", "print(y)", "if x:", "}", "if x:", "", "return x", "{", "if x:", "x += 1", "{", "{", "}", "", "print(y)", "print(y)", "}", "x += 1", "y -= 1", "{", "y -= 1", "", "}", "print(y)", "y -= 1", "y -= 1", "{", "", "y -= 1", "return x", "print(y)", "y -= 1", "{", "y -= 1", "return x", "x += 1", "x += 1", "y -= 1", "{", "if x:", "", "{", "{", "{", "}", "", "y -= 1", "x += 1", "{", "y -= 1", "", "", "return x", "return x", "", "x += 1", "{", "", "x += 1", "if x:", "if x:", "x += 1", "x += 1", "", "y -= 1", "{", "y -= 1", "x += 1", "", "return x", "x += 1", "return x", "{", "print(y)", "", "}", "}", "x += 1", "y -= 1", "return x", "y -= 1", "if x:", "x += 1", "", "}", "}", "return x", "print(y)", "", "}", "", "x += 1", "if x:", "}", "if x:", "{", "", "x += 1", "}", "return x", "print(y)", "", "}", "x += 1", "y -= 1", "if x:", "y -= 1", "print(y)", "{", "", "if x:", "return x", "{", "x += 1", "", "return x", "}", "x += 1", "", "y -= 1", "if x:", "x += 1", "{", "print(y)", "{", "y -= 1", "", "x += 1", "x += 1", "return x", "}", "y -= 1", "print(y)", "y -= 1", "if x:", "}", "", "if x:", "y -= 1", "if x:", "y -= 1", "x += 1", "y -= 1", "{", "", "", "}", "print(y)", "print(y)", "", "y -= 1", "y -= 1", "x += 1", "print(y)", "", "{", "{", "return x", "y -= 1", "y -= 1", "", "if x:", "}", "}", "return x", "if x:", "if x:", "y -= 1", "{", "}", "y -= 1", "if x:", "y -= 1", "if x:", "return x", "if x:", "}", "", "}", "{", "y -= 1", "y -= 1", "}", "}", "{", "}", "x += 1", "{", "", "", "if x:", "x += 1", "return x", "return x", "{", "", "return x", "y -= 1", "if x:", "if x:", "}", "return x", "print(y)", "", "if x:", "{", "}", "", "x += 1", "x += 1", "}", "if x:", "x += 1", "x += 1", "if x:", "{", "return x", "{", "", "", "{", "x += 1", "x += 1", "}", "print(y)", "y -= 1", "print(y)", "}", "x += 1", "return x", "print(y)", "if x:", "print(y)", "{", "print(y)", "if x:", "x += 1", "{", "y -= 1", "}", "", "{", "{", "}", "return x", "print(y)", "print(y)", "print(y)", "print(y)", "print(y)", "{", "}", "y -= 1", "", "if x:", "", "x += 1", "x += 1", "", "y -= 1", "if x:", "y -= 1", "{", "if x:", "return x", "y -= 1", "x += 1", "print(y)", "", "{", "}", "return x", "x += 1", "{", "y -= 1", "{", "", "print(y)", "}", "}", "}", "if x:", "return x", "x += 1", "{", "x += 1", "", "{", "return x", "}", "}", "}", "}", "return x"]], "label": "large: 460-line files of repeated lines, edits everywhere", "perf": true},
    {"ops": ["DiffTool", "unified"], "args": [[], [["red", "orange", "yellow", "green", "blue"], ["red", "orange", "gold", "green", "blue"], 1]], "expected": [null, ["@@ -2,3 +2,3 @@", " orange", "-yellow", "+gold", " green"]], "label": "step 2: example 1"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["ant", "bee", "cat", "dog", "eel", "fox", "gnu", "hen", "owl"], ["ant", "BEE", "cat", "dog", "fox", "gnu", "hen", "OWL"], 1]], "expected": [null, ["@@ -1,6 +1,5 @@", " ant", "-bee", "+BEE", " cat", " dog", "-eel", " fox", "@@ -8,2 +7,2 @@", " hen", "-owl", "+OWL"]], "label": "step 2: example 2"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["intro", "body"], ["body", "outro"], 0]], "expected": [null, ["@@ -1,1 +0,0 @@", "-intro", "@@ -2,0 +2,1 @@", "+outro"]], "label": "step 2: example 3"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["x", "y"], ["x", "y"], 3]], "expected": [null, []], "label": "step 2: identical files: no hunks"},
    {"ops": ["DiffTool", "unified"], "args": [[], [[], [], 3]], "expected": [null, []], "label": "step 2: both files empty"},
    {"ops": ["DiffTool", "unified"], "args": [[], [[], ["p", "q"], 3]], "expected": [null, ["@@ -0,0 +1,2 @@", "+p", "+q"]], "label": "step 2: a new file"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["p", "q"], [], 3]], "expected": [null, ["@@ -1,2 +0,0 @@", "-p", "-q"]], "label": "step 2: a deleted file"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["line 1", "line 2", "line 3", "line 4", "line 5", "line 6", "line 7", "line 8", "line 9", "line 10"], ["line 1", "two", "line 3", "line 4", "line 5", "line 6", "seven", "line 8", "line 9", "line 10"], 2]], "expected": [null, ["@@ -1,9 +1,9 @@", " line 1", "-line 2", "+two", " line 3", " line 4", " line 5", " line 6", "-line 7", "+seven", " line 8", " line 9"]], "label": "step 2: context 2: four kept lines between two changes, one hunk"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["line 1", "line 2", "line 3", "line 4", "line 5", "line 6", "line 7", "line 8", "line 9", "line 10"], ["line 1", "two", "line 3", "line 4", "line 5", "line 6", "line 7", "eight", "line 9", "line 10"], 2]], "expected": [null, ["@@ -1,4 +1,4 @@", " line 1", "-line 2", "+two", " line 3", " line 4", "@@ -6,5 +6,5 @@", " line 6", " line 7", "-line 8", "+eight", " line 9", " line 10"]], "label": "step 2: context 2: five kept lines between two changes, two hunks"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["p", "q", "r", "s"], ["P", "Q", "r", "S"], 0]], "expected": [null, ["@@ -1,2 +1,2 @@", "-p", "-q", "+P", "+Q", "@@ -4,1 +4,1 @@", "-s", "+S"]], "label": "step 2: context 0: touching changes share a hunk, one kept line splits"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["line 1", "line 2", "line 3", "line 4", "line 5", "line 6", "line 7", "line 8", "line 9", "line 10", "line 11", "line 12"], ["first", "line 2", "line 3", "line 4", "line 5", "line 6", "line 7", "line 8", "line 9", "line 10", "line 11", "last"], 3]], "expected": [null, ["@@ -1,4 +1,4 @@", "-line 1", "+first", " line 2", " line 3", " line 4", "@@ -9,4 +9,4 @@", " line 9", " line 10", " line 11", "-line 12", "+last"]], "label": "step 2: less context available at the ends"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["a", "b", "c", "d"], ["a", "B", "c", "d", "e"], 50]], "expected": [null, ["@@ -1,4 +1,5 @@", " a", "-b", "+B", " c", " d", "+e"]], "label": "step 2: context longer than the files: one hunk"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["k", "l", "m"], ["k", "m"], 10000]], "expected": [null, ["@@ -1,3 +1,2 @@", " k", "-l", " m"]], "label": "step 2: context 10^4"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["a", "b", "c"], ["a", "b", "new", "c"], 0]], "expected": [null, ["@@ -2,0 +3,1 @@", "+new"]], "label": "step 2: an insertion with context 0 starts at the line before it in a"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["a", "b", "old", "c"], ["a", "b", "c"], 0]], "expected": [null, ["@@ -3,1 +2,0 @@", "-old"]], "label": "step 2: a deletion with context 0 starts at the line before it in b"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["a"], ["a", "z"], 0]], "expected": [null, ["@@ -1,0 +2,1 @@", "+z"]], "label": "step 2: an insertion at the very end"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["line 1", "line 2", "line 3", "line 4", "line 5", "line 6", "line 7", "line 8", "line 9", "line 10"], ["line 1", "two", "line 3", "line 4", "five", "line 6", "line 7", "eight", "line 9", "line 10"], 1]], "expected": [null, ["@@ -1,9 +1,9 @@", " line 1", "-line 2", "+two", " line 3", " line 4", "-line 5", "+five", " line 6", " line 7", "-line 8", "+eight", " line 9"]], "label": "step 2: three changes chained into one hunk"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["", "x", "", "y"], ["x", "", "", "y", ""], 1]], "expected": [null, ["@@ -1,4 +1,5 @@", "-", " x", " ", "+", " y", "+"]], "label": "step 2: empty lines"},
    {"ops": ["DiffTool", "diff", "unified", "unified"], "args": [[], [["a", "b", "c", "d", "e"], ["a", "c", "d", "E"]], [["a", "b", "c", "d", "e"], ["a", "c", "d", "E"], 1], [["a", "b", "c", "d", "e"], ["a", "c", "d", "E"], 0]], "expected": [null, [" a", "-b", " c", " d", "-e", "+E"], ["@@ -1,5 +1,4 @@", " a", "-b", " c", " d", "-e", "+E"], ["@@ -2,1 +1,0 @@", "-b", "@@ -5,1 +4,1 @@", "-e", "+E"]], "label": "step 2: diff and unified on the same files"},
    {"ops": ["DiffTool", "unified"], "args": [[], [["p", "q", "r", "r", "p", "p", "s", "q", "s", "s", "s", "p", "p", "p"], ["p", "T", "q", "r", "r", "p", "q", "s", "p", "q", "s", "s", "s", "p", "p", "s"], 1]], "expected": [null, ["@@ -1,2 +1,3 @@", " p", "+T", " q", "@@ -5,4 +6,5 @@", " p", "-p", "+q", " s", "+p", " q", "@@ -13,2 +15,2 @@", " p", "-p", "+s"]], "label": "step 2: random 1"},
