    {"argsPy": "r = rng(101)\nops, xs, t = ['RateLimiter'], [[5, 600000]], 0\nhot = ['h' + str(i) for i in range(10)]\nfor _ in range(50000):\n    t += r.randint(0, 36000)\n    c = r.choice(hot) if r.random() < 0.5 else 'c' + str(r.randint(1, 9990))\n    ops.append('allow'); xs.append([c, t])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "step 1: large: 50,000 calls from 10,000 clients, t up to 10^9", "perf": true},
