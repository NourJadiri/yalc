{
  "id": "rate-limiter-2",
  "title": "Rate Limiter: Costs and Stacked Limits",
  "difficulty": "M",
  "topics": ["design", "hash map", "rate limiting"],
  "kind": "design",
  "className": "RateLimiter",
  "starter": "class RateLimiter:\n\n    def __init__(self, capacity: int, interval: int):\n        pass\n\n    def add_limit(self, capacity: int, interval: int) -> None:\n        pass\n\n    def allow(self, client: str, t: int, cost: int = 1) -> bool:\n        pass\n",
  "tests": [
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow"], "args": [[10, 100], ["a", 0, 7], ["a", 0, 4], ["a", 0, 3], ["a", 250, 3], ["a", 300, 3]], "expected": [null, true, false, true, false, true], "show": true},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow"], "args": [[2, 1000], [1, 100], ["c", 0], ["c", 50], ["c", 100], ["c", 200]], "expected": [null, null, true, false, true, false], "show": true},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow"], "args": [[50, 10], [5, 1000], ["d", 0, 6], ["d", 1000000, 6], ["d", 1000000, 5]], "expected": [null, null, false, false, true], "show": true},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow"], "args": [[5, 100], ["a", 0, 5], ["a", 0, 1], ["a", 499, 5], ["a", 500, 5]], "expected": [null, true, false, false, true], "label": "cost equal to a full bucket"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow"], "args": [[3, 10], ["a", 0, 4], ["a", 0, 3], ["a", 1000000000, 4], ["a", 1000000000, 3]], "expected": [null, false, true, false, true], "label": "a cost above capacity never passes"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow"], "args": [[10, 10], ["a", 0, 8], ["a", 5, 3], ["a", 5, 2], ["a", 10, 1], ["a", 10, 1]], "expected": [null, true, false, true, true, false], "label": "a refused request takes nothing"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[10, 100], ["a", 0, 10], ["a", 250, 3], ["a", 299, 3], ["a", 300, 3], ["a", 350, 1], ["a", 400, 1]], "expected": [null, true, false, false, true, false, true], "label": "partial refill with costs"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 100], ["a", 0], ["a", 0, 1], ["a", 0], ["a", 100, 1], ["a", 200], ["a", 200, 1]], "expected": [null, true, true, false, true, true, false], "label": "cost given as 1 and left out are the same"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 100], [2, 1000], ["c", 0], ["c", 50], ["c", 100], ["c", 200], ["c", 1000], ["c", 1100]], "expected": [null, null, true, false, true, false, true, false], "label": "the first limit refuses, the second keeps its tokens"},
    {"ops": ["RateLimiter", "add_limit", "add_limit", "add_limit", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 1000], [3, 1000], [1, 100], [10, 10], [10, 10], ["a", 0], ["a", 50], ["a", 100], ["a", 150], ["a", 200], ["a", 250], ["a", 300]], "expected": [null, null, null, null, null, true, false, true, false, true, false, false], "label": "the third of five limits refuses, the first two keep their tokens"},
    {"ops": ["RateLimiter", "add_limit", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[10, 1000], [20, 500], [4, 10], ["a", 0, 4], ["a", 20, 4], ["a", 20, 2], ["a", 40, 4], ["a", 1000, 4], ["a", 1000, 3]], "expected": [null, null, null, true, false, true, false, true, false], "label": "the last limit refuses a big request, a small one still fits"},
    {"ops": ["RateLimiter", "add_limit", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[4, 50], [6, 200], [10, 1000], ["a", 0, 3], ["a", 10, 2], ["a", 100, 2], ["a", 150, 2], ["a", 400, 2], ["a", 600, 1], ["a", 1000, 3], ["a", 5000, 4], ["a", 5000, 1], ["a", 5050, 1], ["a", 5200, 2]], "expected": [null, null, null, true, false, true, false, true, true, true, true, false, false, false], "label": "each limit is the tight one in turn"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 100], [3, 100], ["a", 0, 2], ["a", 0, 2], ["a", 100, 2], ["a", 150, 1], ["a", 250, 2]], "expected": [null, null, true, false, true, false, false], "label": "the same limit added twice"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[5, 100], [2, 1000], ["a", 0, 2], ["b", 0, 2], ["a", 10, 1], ["b", 1000, 2], ["a", 1000, 2], ["c", 1000, 3]], "expected": [null, null, true, true, false, false, false, false], "label": "every client gets a bucket for every limit"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[100000, 1000000], [20000, 10], ["a", 0, 10000], ["a", 0, 10000], ["a", 0, 10000], ["a", 99990, 10000], ["a", 100000, 10000], ["a", 1000000000, 10000]], "expected": [null, null, true, true, false, false, true, true], "label": "largest cost against large buckets"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 100], [5, 10000], ["u", 0], ["u", 0], ["u", 0], ["u", 0], ["u", 300], ["u", 300], ["u", 300], ["u", 600], ["u", 600], ["u", 600], ["u", 10000], ["u", 20000], ["u", 20000]], "expected": [null, null, true, true, true, false, true, true, false, false, false, false, true, true, false], "label": "a burst limit under a slow budget"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[5, 3], [1, 3], ["c", 20], ["c", 20, 1], ["a", 24, 1], ["b", 29, 3], ["a", 42, 3], ["a", 42, 2], ["b", 42], ["c", 42], ["c", 51, 3], ["a", 51], ["c", 62, 3], ["a", 77, 3], ["b", 91], ["c", 91, 4], ["b", 97], ["a", 102], ["a", 104, 1], ["c", 104, 1], ["b", 115, 1], ["c", 125, 3], ["b", 131, 2], ["a", 131, 1], ["a", 137, 2], ["a", 150, 2], ["b", 150, 3], ["b", 150, 2], ["b", 150], ["c", 164, 4], ["c", 164, 3], ["c", 164, 4], ["a", 164, 4], ["b", 164], ["a", 173, 3], ["c", 180, 3], ["a", 194, 3], ["c", 194, 2], ["a", 199, 4], ["a", 210, 4], ["b", 210, 1], ["b", 210, 2]], "expected": [null, null, true, false, true, false, false, false, true, true, false, true, false, false, true, false, true, true, false, true, true, false, false, true, false, false, false, false, true, false, false, false, false, true, false, false, false, false, false, false, true, false], "label": "random 1"},
    {"ops": ["RateLimiter", "add_limit", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[6, 3], [3, 3], [3, 10], ["a", 19, 3], ["a", 19, 3], ["a", 19, 2], ["c", 30, 4], ["b", 30, 1], ["c", 44], ["c", 44, 3], ["b", 44, 1], ["b", 56, 1], ["a", 62, 3], ["c", 69, 3], ["a", 69], ["b", 79, 4], ["c", 83, 1], ["a", 89, 3], ["b", 89, 4], ["b", 89, 3], ["b", 92, 2], ["b", 92, 2], ["c", 99, 3], ["a", 112], ["a", 124, 2], ["c", 135], ["a", 135, 2], ["c", 146], ["b", 146, 2], ["c", 146, 4], ["a", 148, 2], ["b", 148, 4], ["a", 148, 3], ["b", 159, 3], ["a", 167, 4], ["c", 169, 1], ["a", 169, 2], ["a", 180, 2], ["b", 180], ["c", 180, 1], ["c", 188, 1], ["a", 188], ["a", 193]], "expected": [null, null, null, true, false, false, false, true, true, false, true, true, true, true, false, false, true, false, false, true, false, false, false, true, true, true, true, true, true, false, false, false, false, false, false, true, true, true, true, true, true, false, true], "label": "random 2"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 5], [3, 20], ["b", 3, 3], ["c", 8, 4], ["b", 8, 3], ["c", 21], ["b", 21, 1], ["b", 31, 1], ["a", 31, 2], ["c", 31, 1], ["b", 31, 1], ["b", 46, 1], ["c", 61, 3], ["a", 61, 1], ["a", 63, 3], ["b", 63], ["c", 74, 1], ["c", 74], ["c", 79, 2], ["a", 79, 2], ["c", 79, 4], ["c", 87, 4], ["b", 90, 2], ["c", 90, 3], ["b", 90, 2], ["b", 100, 3], ["c", 108, 1], ["b", 112, 2], ["b", 116, 4], ["a", 120, 4], ["b", 120, 3], ["b", 120], ["a", 130, 2], ["b", 140, 1], ["c", 140], ["c", 150, 3], ["c", 150, 2], ["b", 150], ["a", 150, 1], ["a", 150], ["c", 150, 3], ["c", 150, 2]], "expected": [null, null, false, false, false, true, true, true, false, true, false, true, false, true, false, true, true, false, false, false, false, false, false, false, false, false, true, false, false, false, false, true, false, true, true, false, false, true, true, false, false, false], "label": "random 3"},
    {"argsPy": "r = rng(303)\nops = ['RateLimiter', 'add_limit', 'add_limit', 'add_limit', 'add_limit']\nxs = [[100000, 10], [50000, 50], [20000, 200], [100000, 1000], [90000, 100]]\nt = 0\nhot = ['h' + str(i) for i in range(20)]\nfor _ in range(39996):\n    t += r.randint(0, 45000)\n    c = r.choice(hot) if r.random() < 0.5 else 'c' + str(r.randint(1, 9980))\n    ops.append('allow'); xs.append([c, t, r.randint(1, 10000)])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: 40,000 calls, 5 limits, costs up to 10^4", "perf": true},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 1000], ["ana", 0], ["ana", 0], ["ana", 400], ["ben", 400], ["ana", 1000], ["ana", 1000]], "expected": [null, true, true, false, true, true, false], "label": "step 1: example 1"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 100], ["x", 0], ["x", 0], ["x", 150], ["x", 200], ["x", 250]], "expected": [null, true, true, true, true, false], "label": "step 1: example 2"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 10], ["k", 5], ["k", 1000], ["k", 1000], ["k", 1000], ["k", 1000], ["k", 1005], ["k", 1010]], "expected": [null, true, true, true, true, false, false, true], "label": "step 1: example 3"},
    {"ops": ["RateLimiter", "allow", "allow", "allow"], "args": [[1, 1], ["a", 0], ["a", 0], ["a", 1]], "expected": [null, true, false, true], "label": "step 1: smallest limiter"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 100], ["a", 0], ["a", 99], ["a", 100], ["a", 150], ["a", 250], ["a", 300]], "expected": [null, true, false, true, false, true, false], "label": "step 1: capacity 1: one request per interval"},
    {"ops": ["RateLimiter", "allow", "allow", "allow"], "args": [[1, 10], ["a", 0], ["a", 5], ["a", 10]], "expected": [null, true, false, true], "label": "step 1: a refusal takes nothing"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 100], ["a", 0], ["a", 0], ["a", 10], ["a", 20], ["a", 30], ["a", 40], ["a", 50], ["a", 60], ["a", 70], ["a", 80], ["a", 90], ["a", 100], ["a", 100]], "expected": [null, true, true, false, false, false, false, false, false, false, false, false, true, false], "label": "step 1: refusals in a row keep the refill"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[5, 1000], ["a", 7], ["a", 7], ["a", 7], ["a", 7], ["a", 7], ["a", 7]], "expected": [null, true, true, true, true, true, false], "label": "step 1: a burst within one millisecond"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 1000], ["a", 0], ["b", 0], ["a", 1], ["c", 1], ["b", 999], ["b", 1000], ["a", 1000]], "expected": [null, true, true, false, true, false, true, true], "label": "step 1: clients never share a bucket"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 1000000], ["old", 0], ["late", 1000000000], ["late", 1000000000], ["late", 1000000000], ["late", 1000000000], ["old", 1000000000]], "expected": [null, true, true, true, true, false, true], "label": "step 1: a new client starts full, however late"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 100], ["a", 0], ["a", 5030], ["a", 5030], ["a", 5030], ["a", 5100], ["a", 5130]], "expected": [null, true, true, true, false, false, true], "label": "step 1: time spent full is not saved up"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 100], ["a", 0], ["a", 0], ["a", 0], ["a", 150], ["a", 300], ["a", 300], ["a", 450], ["a", 450], ["a", 600], ["a", 600]], "expected": [null, true, true, true, true, true, true, true, false, true, true], "label": "step 1: requests 1.5 intervals apart"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 1], ["a", 0], ["a", 0], ["a", 0], ["a", 1], ["a", 1], ["a", 3], ["a", 3], ["a", 3]], "expected": [null, true, true, false, true, false, true, true, false], "label": "step 1: one token per millisecond"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 1000000], ["a", 0], ["a", 999999], ["a", 1000000], ["a", 1999999], ["a", 2000000], ["a", 1000000000], ["a", 1000000000]], "expected": [null, true, false, true, false, true, true, false], "label": "step 1: long interval, slow refill"},
