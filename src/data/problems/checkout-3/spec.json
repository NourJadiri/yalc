    {"argsPy": "r = rng(404)\nops, xs = [\"Checkout\"], [[]]\nops += [\"add_weighed\", \"add_product\", \"add_percent_off\", \"add_multibuy\"]\nxs += [[\"HOT\", \"Hot Produce\", 1999], [\"DEAL\", \"Deal Pack\", 349], [\"HOT\", 15], [\"DEAL\", 3, 900]]\nfor c in range(20):\n    t = r.randint(1, 10**6)\n    ops.append(\"add_spend_discount\"); xs.append([t, r.randint(1, min(t, 10**5))])\nfor _ in range(500):\n    if r.random() < 0.5:\n        ops.append(\"scan\"); xs.append([\"HOT\", r.randint(1, 10**4)])\n    else:\n        ops.append(\"scan\"); xs.append([\"DEAL\"] + ([r.randint(1, 5)] if r.random() < 0.5 else []))\n    ops.append(\"total\"); xs.append([])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: two hot skus on promotion, a total after every scan", "perf": true},
    {"argsPy": "r = rng(505)\nops, xs = [\"Checkout\"], [[]]\nfor i in range(300):\n    ops.append(\"add_product\"); xs.append([\"U\" + str(i), \"Pack\", r.randint(50, 5000)])\n    ops.append(\"add_weighed\"); xs.append([\"W\" + str(i), \"Loose\", r.randint(100, 10**5)])\nfor c in range(20):\n    t = r.randint(10**4, 10**7)\n    ops.append(\"add_spend_discount\"); xs.append([t, r.randint(1, min(t, 10**6))])\nfor k in range(500):\n    if k % 10 == 0:\n        i = str(r.randrange(60))\n        if r.random() < 0.5:\n            ops.append(\"add_multibuy\"); xs.append([\"U\" + i, r.randint(2, 6), r.randint(1, 30000)])\n        else:\n            ops.append(\"add_percent_off\"); xs.append([r.choice(\"UW\") + i, r.randint(1, 100)])\n    i = str(r.randrange(60) if r.random() < 0.5 else r.randrange(300))\n    if r.random() < 0.5:\n        ops.append(\"scan\"); xs.append([\"U\" + i, r.randint(1, 12)])\n    else:\n        ops.append(\"scan\"); xs.append([\"W\" + i, r.randint(1, 10**4)])\nfor _ in range(500):\n    ops.append(\"total\"); xs.append([])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 500 lines, 50 promotions, then 500 totals", "perf": true},
