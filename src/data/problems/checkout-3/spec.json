  "className": "Checkout",
  "starter": "class Checkout:\n\n    def __init__(self):\n        pass\n\n    def add_product(self, sku: str, name: str, price: int) -> bool:\n        pass\n\n    def add_weighed(self, sku: str, name: str, price_per_kg: int) -> bool:\n        pass\n\n    def scan(self, sku: str, qty: int = 1) -> bool:\n        pass\n\n    def total(self) -> int:\n        pass\n\n    def add_multibuy(self, sku: str, n: int, price: int) -> bool:\n        pass\n\n    def add_percent_off(self, sku: str, percent: int) -> bool:\n        pass\n\n    def add_spend_discount(self, threshold: int, amount: int) -> bool:\n        pass\n",
  "tests": [
    {"ops": ["Checkout", "add_product", "add_multibuy", "scan", "scan", "total", "scan", "total"], "args": [[], ["MILK", "Milk", 129], ["MILK", 2, 200], ["MILK"], ["MILK"], [], ["MILK", 3], []], "expected": [null, true, true, true, true, 200, true, 529], "show": true},
    {"ops": ["Checkout", "add_weighed", "add_product", "scan", "scan", "scan", "total", "add_percent_off", "total"], "args": [[], ["CHEESE", "Cheese", 2500], ["BREAD", "Bread", 250], ["CHEESE", 50], ["BREAD"], ["CHEESE", 54], [], ["CHEESE", 10], []], "expected": [null, true, true, true, true, true, 510, true, 483], "show": true},
    {"ops": ["Checkout", "add_product", "add_spend_discount", "add_spend_discount", "add_spend_discount", "scan", "total", "scan", "total"], "args": [[], ["WINE", "Wine", 999], [2000, 300], [1500, 500], [1000, 1001], ["WINE", 2], [], ["WINE"], []], "expected": [null, true, true, true, false, true, 1498, true, 2497], "show": true},
    {"ops": ["Checkout", "add_product", "add_multibuy", "scan", "total", "scan", "total", "scan", "total", "scan", "total"], "args": [[], ["SOUP", "Soup", 100], ["SOUP", 3, 250], ["SOUP"], [], ["SOUP", 2], [], ["SOUP"], [], ["SOUP", 5], []], "expected": [null, true, true, true, 100, true, 250, true, 350, true, 750], "label": "multibuy: leftover units pay the unit price"},
    {"ops": ["Checkout", "add_product", "add_multibuy", "scan", "scan", "scan", "scan", "total", "scan", "scan", "scan", "total"], "args": [[], ["YOG", "Yogurt", 99], ["YOG", 4, 300], ["YOG"], ["YOG"], ["YOG"], ["YOG"], [], ["YOG", 3], ["YOG", 2], ["YOG", 3], []], "expected": [null, true, true, true, true, true, true, 300, true, true, true, 900], "label": "multibuy: groups form across lines"},
    {"ops": ["Checkout", "add_product", "scan", "total", "add_multibuy", "total", "scan", "total"], "args": [[], ["COLA", "Cola", 150], ["COLA", 5], [], ["COLA", 6, 700], [], ["COLA"], []], "expected": [null, true, true, 750, true, 750, true, 700], "label": "multibuy added after scanning"},
    {"ops": ["Checkout", "add_product", "add_weighed", "add_multibuy", "add_multibuy", "add_multibuy", "add_multibuy", "add_multibuy", "add_multibuy", "scan", "total", "add_multibuy", "total", "add_multibuy", "add_percent_off", "total"], "args": [[], ["A", "Apple Juice", 100], ["B", "Beans", 1000], ["Z", 2, 150], ["B", 2, 150], ["A", 1, 50], ["A", 0, 50], ["A", 2, 200], ["A", 2, 250], ["A", 4], [], ["A", 2, 199], [], ["A", 2, 150], ["A", 50], []], "expected": [null, true, true, false, false, false, false, false, false, true, 400, true, 398, false, false, 398], "label": "multibuy refusals change nothing"},
    {"ops": ["Checkout", "add_product", "add_multibuy", "scan", "total"], "args": [[], ["BULK", "Bulk Flour", 100000], ["BULK", 100, 9999999], ["BULK", 250], []], "expected": [null, true, true, true, 24999998], "label": "multibuy with the largest group"},
    {"ops": ["Checkout", "add_product", "add_percent_off", "add_percent_off", "add_percent_off", "add_percent_off", "scan", "total", "add_percent_off", "total", "add_percent_off", "add_multibuy", "total"], "args": [[], ["P", "Pizza", 200], ["Q", 10], ["P", 0], ["P", 101], ["P", 200], ["P"], [], ["P", 100], [], ["P", 10], ["P", 2, 300], []], "expected": [null, true, false, false, false, false, true, 200, true, 0, false, false, 0], "label": "percent off: refusals, and 100 makes it free"},
    {"ops": ["Checkout", "add_product", "add_product", "add_product", "add_percent_off", "add_percent_off", "add_percent_off", "scan", "total", "scan", "total", "scan", "total"], "args": [[], ["A", "Gum", 49], ["B", "Mints", 50], ["C", "Chocolate", 150], ["A", 1], ["B", 1], ["C", 1], ["A"], [], ["B"], [], ["C"], []], "expected": [null, true, true, true, true, true, true, true, 49, true, 98, true, 246], "label": "percent off saves 0, 1 or 2 cents"},
    {"ops": ["Checkout", "add_product", "add_percent_off", "scan", "total", "scan", "total"], "args": [[], ["PIE", "Pie", 125], ["PIE", 10], ["PIE"], [], ["PIE"], []], "expected": [null, true, true, true, 112, true, 224], "label": "percent off rounds each line, halves up"},
    {"ops": ["Checkout", "add_weighed", "add_percent_off", "scan", "total", "scan", "total"], "args": [[], ["HAM", "Ham", 2999], ["HAM", 25], ["HAM", 333], [], ["HAM", 1], []], "expected": [null, true, true, true, 749, true, 751], "label": "percent off on a weighed line rounds twice"},
    {"ops": ["Checkout", "add_product", "add_percent_off", "scan", "scan", "total"], "args": [[], ["TEA", "Tea", 450], ["TEA", 20], ["TEA"], ["TEA", 3], []], "expected": [null, true, true, true, true, 1440], "label": "percent off set before scanning"},
    {"ops": ["Checkout", "add_product", "add_product", "add_multibuy", "scan", "scan", "scan", "total", "scan", "total"], "args": [[], ["A", "Apples", 100], ["B", "Bagels", 100], ["A", 2, 150], ["A"], ["B"], ["B"], [], ["A"], []], "expected": [null, true, true, true, true, true, true, 300, true, 350], "label": "a promotion on one sku leaves the others alone"},
    {"ops": ["Checkout", "add_product", "add_spend_discount", "scan", "total", "scan", "total", "add_spend_discount", "total"], "args": [[], ["X", "Coffee", 500], [1000, 100], ["X"], [], ["X"], [], [1001, 200], []], "expected": [null, true, true, true, 500, true, 900, true, 900], "label": "spend discount at exactly the threshold"},
    {"ops": ["Checkout", "add_product", "add_multibuy", "add_spend_discount", "scan", "scan", "total", "add_spend_discount", "total"], "args": [[], ["A", "Olive Oil", 600], ["A", 2, 1000], [1200, 150], ["A"], ["A"], [], [1000, 100], []], "expected": [null, true, true, true, true, true, 1000, true, 900], "label": "spend discount looks at the total after item promotions"},
    {"ops": ["Checkout", "add_product", "add_spend_discount", "scan", "total", "add_percent_off", "total"], "args": [[], ["A", "Wine", 1000], [2000, 300], ["A", 2], [], ["A", 10], []], "expected": [null, true, true, true, 1700, true, 1800], "label": "a late promotion can drop the basket below a coupon"},
    {"ops": ["Checkout", "add_spend_discount", "add_spend_discount", "add_spend_discount", "add_spend_discount", "add_product", "scan", "total"], "args": [[], [0, 0], [500, 0], [500, 501], [500, 500], ["A", "Cake", 250], ["A", 2], []], "expected": [null, false, false, false, true, true, true, 0], "label": "spend discount refusals, and a total of 0"},
    {"ops": ["Checkout", "add_product", "scan", "add_spend_discount", "total", "add_spend_discount", "add_spend_discount", "total", "add_spend_discount", "total", "add_spend_discount", "total"], "args": [[], ["A", "Steak", 1000], ["A", 5], [3000, 400], [], [1000, 400], [5000, 600], [], [6000, 900], [], [4000, 700], []], "expected": [null, true, true, true, 4600, true, true, 4400, true, 4400, true, 4300], "label": "the largest qualifying amount wins"},
