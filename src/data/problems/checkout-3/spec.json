    {"ops": ["Checkout", "add_product", "add_weighed", "add_weighed", "add_product", "scan", "scan", "total"], "args": [[], ["OATS", "Oats", 189], ["OATS", "Loose Oats", 400], ["CORN", "Corn", 350], ["CORN", "Corn Can", 99], ["OATS", 2], ["CORN", 2000], []], "expected": [null, true, false, true, false, true, true, 1078], "label": "step 2: a sku is refused as the other kind, prices stay"},
