{
  "id": "voice-stream-2",
  "title": "Voice Stream: Play in Order",
  "difficulty": "M",
  "topics": ["design", "hash map", "sliding window"],
  "kind": "design",
  "className": "StreamReceiver",
  "starter": "class StreamReceiver:\n\n    def __init__(self, window: int):\n        pass\n\n    def receive(self, seq: int, data: str, t: int) -> bool:\n        pass\n\n    def play(self, t: int) -> List[str]:\n        pass\n",
  "tests": [
    {"ops": ["StreamReceiver", "receive", "play", "receive", "receive", "play", "receive", "play"], "args": [[8], [1, "mor", 10], [15], [0, "good", 20], [3, "how", 25], [30], [2, "ning", 40], [45]], "expected": [null, true, [], true, true, ["good", "mor"], true, ["ning", "how"]], "show": true},
    {"ops": ["StreamReceiver", "receive", "play", "receive", "receive", "receive", "receive", "play"], "args": [[8], [0, "one", 0], [5], [0, "one", 10], [2, "three", 15], [2, "three", 20], [1, "two", 25], [30]], "expected": [null, true, ["one"], false, true, false, true, ["two", "three"]], "show": true},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "play"], "args": [[2], [1, "mor", 0], [2, "ning", 5], [3, "how", 10], [0, "good", 15], [20]], "expected": [null, true, true, true, false, []], "show": true},
    {"ops": ["StreamReceiver", "play"], "args": [[4], [0]], "expected": [null, []], "label": "play before any packet"},
    {"ops": ["StreamReceiver", "receive", "receive", "play", "play"], "args": [[4], [0, "ba", 5], [1, "ce", 10], [15], [20]], "expected": [null, true, true, ["ba", "ce"], []], "label": "play twice in a row"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "play", "receive", "play"], "args": [[8], [3, "fo", 5], [2, "di", 10], [1, "ce", 15], [20], [0, "ba", 25], [30]], "expected": [null, true, true, true, [], true, ["ba", "ce", "di", "fo"]], "label": "seq 0 arrives last"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "play", "play", "receive", "play"], "args": [[8], [0, "ba", 5], [2, "di", 10], [3, "fo", 15], [4, "gu", 20], [25], [30], [1, "ce", 35], [40]], "expected": [null, true, true, true, true, ["ba"], [], true, ["ce", "di", "fo", "gu"]], "label": "a gap holds back everything behind it"},
    {"ops": ["StreamReceiver", "receive", "play", "receive", "receive", "receive", "receive", "receive", "play"], "args": [[8], [5, "ha", 5], [10], [0, "ba", 15], [1, "ce", 20], [2, "di", 25], [3, "fo", 30], [4, "gu", 35], [40]], "expected": [null, true, [], true, true, true, true, true, ["ba", "ce", "di", "fo", "gu", "ha"]], "label": "the first packet isn't seq 0"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "play", "receive", "play"], "args": [[1], [0, "ba", 5], [2, "di", 10], [1, "ce", 15], [20], [3, "fo", 25], [30]], "expected": [null, true, true, false, ["ba"], true, []], "label": "window 1: a late packet is lost for good"},
    {"ops": ["StreamReceiver", "receive", "receive", "play", "receive", "play"], "args": [[100000], [0, "a", 0], [1000000000, "far", 1], [2], [1, "b", 3], [4]], "expected": [null, true, true, ["a"], false, []], "label": "a jump of a billion strands playback"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "play"], "args": [[4], [1, "b", 5], [1, "x", 10], [0, "a", 15], [20]], "expected": [null, true, false, true, ["a", "b"]], "label": "a dropped copy doesn't replace the kept one"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "play"], "args": [[4], [0, "la", 5], [1, "la", 10], [2, "la", 15], [20]], "expected": [null, true, true, true, ["la", "la", "la"]], "label": "the same audio under different seqs"},
    {"ops": ["StreamReceiver", "receive", "play", "receive", "receive", "receive", "play", "receive", "receive", "receive", "play"], "args": [[2], [0, "ba", 5], [10], [1, "ce", 15], [2, "di", 20], [3, "fo", 25], [30], [0, "ba", 35], [2, "di", 40], [4, "gu", 45], [50]], "expected": [null, true, ["ba"], true, true, true, ["ce", "di", "fo"], false, false, true, ["gu"]], "label": "played seqs come back after the window moved on"},
