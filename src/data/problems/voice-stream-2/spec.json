    {"argsPy": "w = 10**5\nL = \"abcdefghijklmnopqrstuvwxyz\"\nops = [\"StreamReceiver\"]; xs = [[w]]\nfor i in range(1, 40001):\n    ops += [\"receive\", \"play\"]; xs += [[i, L[i % 26], 2 * i], [2 * i + 1]]\nops += [\"receive\", \"play\"]; xs += [[0, \"a\", 80002], [80003]]\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 4 * 10^4 packets wait for seq 0, a play after each", "perf": true},
    {"argsPy": "r = rng(5)\nL = \"abcdefghijklmnopqrstuvwxyz\"\nops = [\"StreamReceiver\"]; xs = [[64]]\norder = []\nfor s in range(50000):\n    order.append((s + r.randint(0, 30), s))\n    if r.random() < 0.1:\n        order.append((s + r.randint(0, 80), s))\norder.sort()\nt = 0\nfor k, (_, s) in enumerate(order):\n    t += r.randint(0, 2)\n    ops.append(\"receive\"); xs.append([s, L[s % 26], t])\n    if k % 3 == 2:\n        ops.append(\"play\"); xs.append([t])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 5 * 10^4 jittered packets with copies", "perf": true},
