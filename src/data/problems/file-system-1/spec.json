{
  "id": "file-system-1",
  "title": "File System: Folders and Files",
  "difficulty": "M",
  "topics": ["design", "trie", "hash map"],
  "kind": "design",
  "className": "FileSystem",
  "starter": "class FileSystem:\n\n    def __init__(self):\n        pass\n\n    def mkdir(self, path: str) -> bool:\n        pass\n\n    def write(self, path: str, content: str) -> bool:\n        pass\n\n    def read(self, path: str) -> Optional[str]:\n        pass\n\n    def ls(self, path: str) -> List[str]:\n        pass\n",
  "tests": [
    {"ops": ["FileSystem", "mkdir", "write", "write", "ls", "ls", "read"], "args": [[], ["/docs/drafts"], ["/docs/todo.txt", "call bob"], ["/docs/drafts/a.md", "hi"], ["/docs"], ["/docs/todo.txt"], ["/docs/drafts/a.md"]], "expected": [null, true, true, true, ["drafts", "todo.txt"], ["todo.txt"], "hi"], "show": true},
    {"ops": ["FileSystem", "write", "mkdir", "write", "mkdir", "mkdir", "write", "read"], "args": [[], ["/logs/a.txt", "x"], ["/logs"], ["/logs/a.txt", "x"], ["/logs/a.txt/old"], ["/logs/a.txt"], ["/logs", "y"], ["/logs"]], "expected": [null, false, true, true, false, false, false, null], "show": true},
    {"ops": ["FileSystem", "ls", "write", "write", "read", "write", "read", "ls", "ls"], "args": [[], ["/"], ["/b", "old"], ["/b", "new"], ["/b"], ["/a", ""], ["/a"], ["/"], ["/c"]], "expected": [null, [], true, true, "new", true, "", ["a", "b"], []], "show": true},
    {"ops": ["FileSystem", "ls", "read", "mkdir", "ls", "read"], "args": [[], ["/"], ["/"], ["/"], ["/"], ["/nothing"]], "expected": [null, [], null, true, [], null], "label": "a new file system"},
    {"ops": ["FileSystem", "mkdir", "ls", "ls", "ls", "ls", "ls"], "args": [[], ["/a/b/c/d"], ["/"], ["/a"], ["/a/b"], ["/a/b/c"], ["/a/b/c/d"]], "expected": [null, true, ["a"], ["b"], ["c"], ["d"], []], "label": "mkdir makes every missing folder"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "mkdir", "ls", "read", "mkdir", "ls"], "args": [[], ["/x"], ["/x/f", "1"], ["/x"], ["/"], ["/x"], ["/x/f"], ["/x/y"], ["/x"]], "expected": [null, true, true, true, true, ["f"], "1", true, ["f", "y"]], "label": "mkdir on folders that already exist"},
    {"ops": ["FileSystem", "write", "mkdir", "read", "ls", "ls"], "args": [[], ["/notes", "keep"], ["/notes"], ["/notes"], ["/notes"], ["/"]], "expected": [null, true, false, "keep", ["notes"], ["notes"]], "label": "mkdir onto an existing file changes nothing"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "ls", "ls", "read", "write", "mkdir", "ls"], "args": [[], ["/a/b"], ["/a/b/f.txt", ""], ["/a/b/f.txt/c/d"], ["/a/b/f.txt/c"], ["/a/b"], ["/a/b/f.txt"], ["/top", "t"], ["/top/x"], ["/"]], "expected": [null, true, true, false, [], ["f.txt"], "", true, false, ["a", "top"]], "label": "mkdir through a file changes nothing"},
    {"ops": ["FileSystem", "write", "mkdir", "write", "ls", "mkdir", "write", "read"], "args": [[], ["/a/b/c.txt", "x"], ["/a"], ["/a/b/c.txt", "x"], ["/a"], ["/a/b"], ["/a/b/c.txt", "x"], ["/a/b/c.txt"]], "expected": [null, false, true, false, [], true, true, "x"], "label": "write never makes folders"},
    {"ops": ["FileSystem", "write", "write", "read", "read", "ls", "ls"], "args": [[], ["/f", "1"], ["/f/g", "2"], ["/f/g"], ["/f"], ["/f"], ["/f/g"]], "expected": [null, true, false, null, "1", ["f"], []], "label": "write under a file"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "ls", "read", "ls", "read"], "args": [[], ["/d/e"], ["/d/e", "x"], ["/", "x"], ["/d/e"], ["/d/e"], ["/"], ["/"]], "expected": [null, true, false, false, [], null, ["d"], null], "label": "write onto a folder or the root"},
    {"ops": ["FileSystem", "mkdir", "write", "ls", "read", "write", "ls"], "args": [[], ["/x.txt"], ["/x.txt", "a"], ["/x.txt"], ["/x.txt"], ["/x.txt/y", "b"], ["/x.txt"]], "expected": [null, true, false, [], null, true, ["y"]], "label": "a folder named like a file"},
    {"ops": ["FileSystem", "write", "write", "read", "write", "read", "ls", "write", "read"], "args": [[], ["/f", "first"], ["/f", "second"], ["/f"], ["/f", ""], ["/f"], ["/"], ["/f", "third"], ["/f"]], "expected": [null, true, true, "second", true, "", ["f"], true, "third"], "label": "overwriting keeps one file"},
    {"ops": ["FileSystem", "mkdir", "read", "read", "ls", "mkdir", "ls", "ls", "ls", "read"], "args": [[], ["/d"], ["/d"], ["/d/x"], ["/x"], ["/x/y"], ["/x/y/z"], ["/x/z"], ["/xy"], ["/x/y/z"]], "expected": [null, true, null, null, [], true, [], [], [], null], "label": "folders and missing paths"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "write", "write", "mkdir", "write", "write", "mkdir", "write", "mkdir", "write", "ls"], "args": [[], ["/s"], ["/s/zeta", ""], ["/s/_tmp"], ["/s/10", ""], ["/s/9", ""], ["/s/-dash"], ["/s/.dot", ""], ["/s/a_b", ""], ["/s/a.b"], ["/s/a-b", ""], ["/s/alpha"], ["/s/a", ""], ["/s"]], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, ["-dash", ".dot", "10", "9", "_tmp", "a", "a-b", "a.b", "a_b", "alpha", "zeta"]], "label": "ls sorts by character code"},
    {"ops": ["FileSystem", "mkdir", "write", "ls", "ls"], "args": [[], ["/a/b/c"], ["/a/b/c/report.v2.txt", "r"], ["/a/b/c/report.v2.txt"], ["/a/b/c"]], "expected": [null, true, true, ["report.v2.txt"], ["report.v2.txt"]], "label": "ls of a file gives only its name"},
    {"ops": ["FileSystem", "mkdir", "mkdir", "write", "mkdir", "read", "read", "ls", "ls", "write", "read", "ls"], "args": [[], ["/a"], ["/b"], ["/a/x", "in a"], ["/b/x"], ["/a/x"], ["/b/x"], ["/a/x"], ["/b/x"], ["/b/x/x", "in b"], ["/b/x/x"], ["/b"]], "expected": [null, true, true, true, true, "in a", null, ["x"], [], true, "in b", ["x"]], "label": "the same name in two folders"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "write", "ls", "ls", "read", "read", "mkdir", "ls", "ls"], "args": [[], ["/a"], ["/ab", "t"], ["/a/c"], ["/abc", "u"], ["/a"], ["/"], ["/a"], ["/ab"], ["/ab/x"], ["/ab"], ["/a/c"]], "expected": [null, true, true, true, true, ["c"], ["a", "ab", "abc"], null, "t", false, ["ab"], []], "label": "a name that starts another name"},
    {"ops": ["FileSystem", "mkdir", "write", "ls", "read", "mkdir", "write", "write", "mkdir", "ls", "read", "ls"], "args": [[], ["/abcdefghijklmnopqrst/99999999999999999999"], ["/abcdefghijklmnopqrst/z-._0123456789abcdef", "ok"], ["/abcdefghijklmnopqrst"], ["/abcdefghijklmnopqrst/z-._0123456789abcdef"], ["/..."], ["/.../-", "x"], ["/.../_", "y"], ["/.../.a"], ["/..."], ["/.../-"], ["/"]], "expected": [null, true, true, ["99999999999999999999", "z-._0123456789abcdef"], "ok", true, true, true, true, ["-", ".a", "_"], "x", ["...", "abcdefghijklmnopqrst"]], "label": "long names and names of dots and dashes"},
    {"argsPy": "p = \"/d\" * 99\nargs = {\"ops\": [\"FileSystem\", \"mkdir\", \"write\", \"read\", \"ls\", \"ls\", \"mkdir\", \"ls\"], \"args\": [[], [p + \"/d\"], [p + \"/f\", \"deep\"], [p + \"/f\"], [p], [p + \"/d\"], [p + \"/f\"], [\"/d\"]]}", "expected": [null, true, true, "deep", ["d", "f"], [], false, ["d"]], "label": "a path of 100 names"},
    {"ops": ["FileSystem", "read", "mkdir", "write", "mkdir", "read", "mkdir", "read", "write", "ls", "write", "ls", "ls", "mkdir", "read", "ls", "ls", "ls", "mkdir", "mkdir", "write", "write", "read", "ls", "write", "ls", "mkdir", "write", "write", "mkdir", "read", "write", "ls", "read", "read", "write", "ls", "write", "read", "mkdir", "ls"], "args": [[], ["/_c"], ["/a.b"], ["/a.b/a", "yy"], ["/a.b/b"], ["/a.b/a"], ["/a"], ["/a.b/a.b"], ["/a.b/b/_c", ""], ["/"], ["/a/a", "yzx"], ["/_c/b/_c"], ["/a/a/a"], ["/a.b/b/a"], ["/a.b/b/a"], ["/a.b/a"], ["/a"], ["/a.b/a"], ["/a.b/_c"], ["/a.b/a"], ["/a.b/b/_c", ""], ["/b/a", ""], ["/a/a.b/b"], ["/a.b/b"], ["/a.b/_c/_c", ""], ["/a.b/b/a"], ["/a.b/a"], ["/a.b/b/a", "yy"], ["/a.b/a.b", " "], ["/a"], ["/a.b/b/_c"], ["/a/a", "xx "], ["/a/a"], ["/a.b/_c/_c"], ["/a/b"], ["/b", "yx"], ["/a/b"], ["/a/a", "x"], ["/b/_c/b"], ["/a/a.b/_c"], ["/b"]], "expected": [null, null, true, true, true, "yy", true, null, true, ["a", "a.b"], true, [], [], true, null, ["a"], ["a"], ["a"], true, false, true, false, null, ["_c", "a"], true, [], false, false, true, true, "", true, ["a"], "", null, true, [], true, null, true, ["b"]], "label": "random 1"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "ls", "write", "ls", "ls", "write", "ls", "read", "ls", "mkdir", "write", "ls", "write", "read", "mkdir", "ls", "ls", "read", "mkdir", "mkdir", "write", "mkdir", "ls", "read", "write", "write", "ls", "read", "ls", "mkdir", "mkdir", "write", "mkdir", "read", "ls", "mkdir", "mkdir", "write"], "args": [[], ["/b"], ["/b", " yy"], ["/_c"], ["/b/b"], ["/b", ""], ["/_c"], ["/"], ["/_c/_c", " "], ["/_c/_c"], ["/_c/_c"], ["/_c"], ["/b/b"], ["/b/b/a", "yzx"], ["/b/b"], ["/b/b/a", "y"], ["/a"], ["/a"], ["/a"], ["/_c"], ["/_c"], ["/b/b/a.b"], ["/b/b/a.b"], ["/b/a", "z "], ["/b/b/a.b"], ["/"], ["/_c/_c"], ["/b", "y"], ["/a.b", " "], ["/_c"], ["/b/a"], ["/a"], ["/_c/_c"], ["/b/b/b"], ["/b/a.b/a", ""], ["/a"], ["/_c/b/a.b"], ["/b"], ["/_c/_c"], ["/a/a.b"], ["/_c", "x"]], "expected": [null, true, false, true, [], false, [], ["_c", "b"], true, ["_c"], " ", ["_c"], true, true, ["a"], true, null, true, [], ["_c"], null, true, true, true, true, ["_c", "a", "b"], " ", false, true, ["_c"], "z ", [], false, true, false, true, null, ["a", "b"], false, true, false], "label": "random 2"},
    {"ops": ["FileSystem", "ls", "ls", "ls", "read", "ls", "ls", "ls", "ls", "ls", "read", "mkdir", "ls", "write", "read", "ls", "write", "ls", "mkdir", "read", "write", "read", "mkdir", "read", "write", "ls", "write", "ls", "ls", "ls", "mkdir", "ls", "write", "read", "ls", "mkdir", "read", "ls", "read", "mkdir", "ls"], "args": [[], ["/a"], ["/a.b"], ["/"], ["/"], ["/b"], ["/b"], ["/b/b"], ["/a.b"], ["/b"], ["/b"], ["/_c"], ["/a.b"], ["/_c", "x "], ["/_c/a.b"], ["/"], ["/b", "y"], ["/_c"], ["/b"], ["/b"], ["/b", "zx"], ["/_c/a.b"], ["/a"], ["/b"], ["/a.b/_c/a.b", "x "], ["/b"], ["/a/a/_c", ""], ["/a/_c"], ["/a"], ["/"], ["/_c/a"], ["/b"], ["/_c/a/_c", "zy "], ["/a/b"], ["/_c/a"], ["/a/a"], ["/_c/a/_c"], ["/a.b/a.b"], ["/_c/a/_c"], ["/_c/a/_c"], ["/b"]], "expected": [null, [], [], [], null, [], [], [], [], [], null, true, [], false, null, ["_c"], true, [], false, "y", true, null, true, "zx", false, ["b"], false, [], [], ["_c", "a", "b"], true, ["b"], true, null, ["_c"], true, "zy ", [], "zy ", false, ["b"]], "label": "random 3"},
    {"ops": ["FileSystem", "ls", "write", "ls", "read", "read", "write", "read", "ls", "ls", "ls", "mkdir", "mkdir", "ls", "read", "write", "ls", "mkdir", "ls", "read", "read", "write", "read", "read", "write", "mkdir", "ls", "ls", "write", "mkdir", "write", "ls", "mkdir", "mkdir", "mkdir", "write", "mkdir", "write", "ls", "mkdir", "mkdir"], "args": [[], ["/_c"], ["/", "x"], ["/a.b"], ["/a.b/b"], ["/_c"], ["/a", ""], ["/_c/a.b"], ["/a"], ["/b"], ["/_c"], ["/_c"], ["/b"], ["/b"], ["/a"], ["/b/a", "xxz"], ["/_c"], ["/a"], ["/a"], ["/"], ["/a"], ["/b", "y"], ["/b/b"], ["/a"], ["/b/_c", ""], ["/b/a"], ["/"], ["/b"], ["/_c", ""], ["/a.b"], ["/_c/b", " "], ["/a.b/a"], ["/_c/_c"], ["/a.b"], ["/_c/_c/_c"], ["/b", "z"], ["/_c/_c"], ["/_c/b", ""], ["/_c/b"], ["/_c/_c/b"], ["/b/a.b"]], "expected": [null, [], false, [], null, null, true, null, ["a"], [], [], true, true, [], "", true, [], false, ["a"], null, "", false, null, "", true, false, ["_c", "a", "b"], ["_c", "a"], false, true, true, [], true, true, true, false, true, true, ["b"], true, true], "label": "random 4"},
    {"argsPy": "r = rng(1)\nops, xs = [\"FileSystem\"], [[]]\nfor i in range(50):\n    for j in range(10):\n        d = \"/g\" + str(i) + \"/d\" + str(j)\n        ops.append(\"mkdir\"); xs.append([d])\n        for k in range(9):\n            ops.append(\"write\"); xs.append([d + \"/f\" + str(k), \"x\" * r.randint(0, 9)])\nfor _ in range(10000):\n    d = \"/g\" + str(r.randint(0, 49))\n    if r.random() < 0.8:\n        d += \"/d\" + str(r.randint(0, 9))\n    ops.append(\"ls\"); xs.append([d])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 10,000 ls calls in a tree of 5,050 entries", "perf": true}
  ]
}
