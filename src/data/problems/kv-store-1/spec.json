    {"ops": ["KVStore", "set", "set", "set", "delete", "count", "set", "count"], "args": [[], ["a", 2], ["b", 2], ["a", 3], ["b"], [2], ["c", 2], [2]], "expected": [null, null, null, null, true, 0, null, 1], "label": "a value's count falls back to zero"},
    {"ops": ["KVStore", "set", "delete", "count", "get", "get"], "args": [[], ["a", 1], ["b"], [1], ["a"], ["b"]], "expected": [null, null, false, 1, 1, null], "label": "deleting a missing key changes nothing"},
    {"ops": ["KVStore", "get", "count", "get", "set", "delete", "set", "set", "set", "delete", "delete", "set", "set", "get", "set", "get", "set", "set", "get", "count", "delete", "count", "set", "count", "set", "set", "set", "get", "set", "delete", "set", "set", "set", "set", "set", "get", "count", "get", "set", "set", "count"], "args": [[], ["e"], [1], ["e"], ["e", 1], ["b"], ["c", -1], ["f", 3], ["d", 1], ["e"], ["e"], ["e", -2], ["b", -1], ["d"], ["e", -1], ["f"], ["a", 3], ["f", 0], ["e"], [-2], ["c"], [2], ["a", 2], [1], ["c", 1], ["a", 3], ["b", -2], ["f"], ["a", 2], ["f"], ["a", 0], ["d", -2], ["f", -2], ["d", 1], ["e", -1], ["b"], [-1], ["d"], ["d", -1], ["e", 0], [-2]], "expected": [null, null, 0, null, null, false, null, null, null, true, false, null, null, 1, null, 3, null, null, -1, 0, true, 0, null, 1, null, null, null, 0, null, true, null, null, null, null, null, -2, 1, 1, null, null, 2], "label": "random 1"},
    {"ops": ["KVStore", "get", "get", "set", "get", "count", "count", "get", "delete", "set", "set", "get", "delete", "set", "get", "count", "count", "delete", "get", "get", "count", "set", "delete", "get", "delete", "set", "count", "set", "set", "set", "set", "set", "set", "delete", "set", "count", "set", "set", "set", "set", "set"], "args": [[], ["f"], ["c"], ["a", 0], ["f"], [3], [-1], ["f"], ["d"], ["c", -1], ["b", -2], ["c"], ["a"], ["a", 3], ["a"], [1], [-2], ["b"], ["e"], ["f"], [2], ["a", 1], ["f"], ["d"], ["e"], ["f", -2], [3], ["c", 3], ["c", -2], ["c", 0], ["e", 2], ["d", 1], ["a", -1], ["a"], ["e", -2], [-1], ["f", 0], ["c", 1], ["f", 3], ["d", 0], ["c", 1]], "expected": [null, null, null, null, null, 0, 0, null, false, null, null, -1, true, null, 3, 0, 1, true, null, null, 0, null, false, null, false, null, 0, null, null, null, null, null, null, true, null, 0, null, null, null, null, null], "label": "random 2"},
    {"ops": ["KVStore", "set", "count", "delete", "set", "delete", "set", "set", "count", "count", "count", "count", "count", "get", "count", "set", "count", "get", "delete", "delete", "set", "count", "get", "delete", "get", "get", "set", "set", "set", "count", "get", "get", "delete", "set", "count", "set", "set", "count", "set", "delete", "count"], "args": [[], ["f", 3], [-1], ["f"], ["b", 3], ["b"], ["b", 3], ["d", -1], [2], [0], [-2], [0], [3], ["b"], [0], ["b", 1], [2], ["d"], ["d"], ["f"], ["e", 3], [3], ["e"], ["b"], ["f"], ["b"], ["b", 2], ["c", 1], ["c", 1], [2], ["b"], ["b"], ["b"], ["f", 3], [1], ["d", -2], ["d", 3], [3], ["f", 1], ["c"], [0]], "expected": [null, null, 0, true, null, true, null, null, 0, 0, 0, 0, 1, 3, 0, null, 0, -1, true, false, null, 1, 3, true, null, null, null, null, null, 1, 2, 2, true, null, 1, null, null, 3, null, true, 0], "label": "random 3"},
    {"ops": ["KVStore", "set", "get", "set", "delete", "get", "delete", "set", "set", "count", "count", "get", "get", "set", "set", "set", "count", "get", "count", "count", "count", "get", "set", "count", "delete", "get", "get", "get", "set", "set", "delete", "delete", "set", "set", "set", "get", "set", "get", "count", "get", "delete"], "args": [[], ["f", 3], ["b"], ["c", 0], ["f"], ["d"], ["d"], ["a", 0], ["c", 0], [0], [3], ["b"], ["f"], ["a", 3], ["e", 0], ["c", -1], [1], ["d"], [-2], [3], [2], ["f"], ["a", 3], [2], ["c"], ["b"], ["c"], ["a"], ["a", 0], ["a", -1], ["a"], ["e"], ["d", 3], ["d", 1], ["d", 1], ["a"], ["d", -1], ["e"], [-2], ["d"], ["e"]], "expected": [null, null, null, null, true, null, false, null, null, 2, 0, null, null, null, null, null, 0, null, 0, 1, 0, null, null, 0, true, null, null, 3, null, null, true, true, null, null, null, null, null, null, 0, -1, false], "label": "random 4"},
    {"argsPy": "r = rng(101)\nops, xs = [\"KVStore\"], [[]]\nkeys = [\"k\" + str(i) for i in range(50000)]\nfor k in keys:\n    ops.append(\"set\"); xs.append([k, r.randint(0, 999)])\nkinds = [\"count\"] * 25000 + [\"set\"] * 10000 + [\"delete\"] * 5000 + [\"get\"] * 9999\nr.shuffle(kinds)\nfor kind in kinds:\n    ops.append(kind)\n    if kind == \"count\":\n        xs.append([r.randint(0, 1100)])\n    elif kind == \"set\":\n        xs.append([r.choice(keys), r.randint(0, 999)])\n    else:\n        xs.append([r.choice(keys)])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 50,000 keys, 25,000 counts", "perf": true}
