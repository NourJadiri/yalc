{
  "id": "kv-store-1",
  "title": "Key-Value Store: Store and Count",
  "difficulty": "E",
  "topics": ["design", "hash map", "counting"],
  "kind": "design",
  "className": "KVStore",
  "starter": "class KVStore:\n\n    def __init__(self):\n        pass\n\n    def set(self, key: str, value: int) -> None:\n        pass\n\n    def get(self, key: str) -> int | None:\n        pass\n\n    def delete(self, key: str) -> bool:\n        pass\n\n    def count(self, value: int) -> int:\n        pass\n",
  "tests": [
    {"ops": ["KVStore", "set", "set", "set", "count", "get", "get", "set", "count", "count"], "args": [[], ["apple", 3], ["pear", 3], ["plum", 8], [3], ["pear"], ["fig"], ["pear", 8], [3], [8]], "expected": [null, null, null, null, 2, 3, null, null, 1, 2], "show": true},
    {"ops": ["KVStore", "set", "get", "delete", "delete", "get", "count"], "args": [[], ["x", 0], ["x"], ["x"], ["x"], ["x"], [0]], "expected": [null, null, 0, true, false, null, 0], "show": true},
    {"ops": ["KVStore", "get", "delete", "count", "count"], "args": [[], ["a"], ["a"], [0], [7]], "expected": [null, null, false, 0, 0], "label": "get, delete and count on an empty store"},
    {"ops": ["KVStore", "set", "set", "count", "count", "get"], "args": [[], ["a", 1], ["a", 2], [1], [2], ["a"]], "expected": [null, null, null, 0, 1, 2], "label": "overwrite moves the key to its new value"},
    {"ops": ["KVStore", "set", "set", "count", "delete", "count"], "args": [[], ["a", 5], ["a", 5], [5], ["a"], [5]], "expected": [null, null, null, 1, true, 0], "label": "overwrite with the same value"},
    {"ops": ["KVStore", "set", "set", "set", "set", "count", "count", "count"], "args": [[], ["a", 1], ["a", 2], ["a", 3], ["a", 1], [1], [2], [3]], "expected": [null, null, null, null, null, 1, 0, 0], "label": "a chain of overwrites"},
    {"ops": ["KVStore", "set", "set", "set", "set", "count", "count", "get", "get"], "args": [[], ["a", 1], ["b", 2], ["a", 2], ["b", 1], [1], [2], ["a"], ["b"]], "expected": [null, null, null, null, null, 1, 1, 2, 1], "label": "two keys swap values"},
    {"ops": ["KVStore", "set", "set", "delete", "count", "get", "get"], "args": [[], ["a", 4], ["b", 4], ["a"], [4], ["a"], ["b"]], "expected": [null, null, null, true, 1, null, 4], "label": "delete takes the key out of its count"},
    {"ops": ["KVStore", "set", "delete", "delete", "count"], "args": [[], ["a", 1], ["a"], ["a"], [1]], "expected": [null, null, true, false, 0], "label": "delete twice"},
    {"ops": ["KVStore", "set", "delete", "set", "count", "get", "set", "count", "count"], "args": [[], ["a", 1], ["a"], ["a", 1], [1], ["a"], ["a", 9], [1], [9]], "expected": [null, null, true, null, 1, 1, null, 0, 1], "label": "set again after a delete"},
    {"ops": ["KVStore", "set", "set", "count", "delete", "get", "get", "count"], "args": [[], ["z", 0], ["y", 0], [0], ["z"], ["z"], ["y"], [0]], "expected": [null, null, null, 2, true, null, 0, 1], "label": "zero is an ordinary value"},
    {"ops": ["KVStore", "set", "set", "set", "count", "count", "set", "count", "count"], "args": [[], ["a", -5], ["b", -5], ["c", 5], [-5], [5], ["b", 5], [-5], [5]], "expected": [null, null, null, null, 2, 1, null, 1, 2], "label": "negative values"},
    {"ops": ["KVStore", "set", "set", "count", "count", "get", "get", "count"], "args": [[], ["hi", 1000000000], ["lo", -1000000000], [1000000000], [-1000000000], ["hi"], ["lo"], [0]], "expected": [null, null, null, 1, 1, 1000000000, -1000000000, 0], "label": "largest and smallest values"},
    {"ops": ["KVStore", "set", "set", "set", "set", "delete", "count", "get", "get", "get"], "args": [[], ["a", 1], ["aa", 1], ["a1", 1], ["1a", 2], ["aa"], [1], ["a"], ["aa"], ["1a"]], "expected": [null, null, null, null, null, true, 2, 1, null, 2], "label": "similar keys are different keys"},
    {"ops": ["KVStore", "set", "set", "count", "get", "delete", "get", "count"], "args": [[], ["abcdefghij", 3], ["0123456789", 3], [3], ["abcdefghij"], ["0123456789"], ["0123456789"], [3]], "expected": [null, null, null, 2, 3, true, null, 1], "label": "ten-character keys"},
