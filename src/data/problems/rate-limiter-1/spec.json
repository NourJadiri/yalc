{
  "id": "rate-limiter-1",
  "title": "Rate Limiter: Token Bucket",
  "difficulty": "M",
  "topics": ["design", "hash map", "rate limiting"],
  "kind": "design",
  "className": "RateLimiter",
  "starter": "class RateLimiter:\n\n    def __init__(self, capacity: int, interval: int):\n        pass\n\n    def allow(self, client: str, t: int) -> bool:\n        pass\n",
  "tests": [
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 1000], ["ana", 0], ["ana", 0], ["ana", 400], ["ben", 400], ["ana", 1000], ["ana", 1000]], "expected": [null, true, true, false, true, true, false], "show": true},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 100], ["x", 0], ["x", 0], ["x", 150], ["x", 200], ["x", 250]], "expected": [null, true, true, true, true, false], "show": true},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 10], ["k", 5], ["k", 1000], ["k", 1000], ["k", 1000], ["k", 1000], ["k", 1005], ["k", 1010]], "expected": [null, true, true, true, true, false, false, true], "show": true},
    {"ops": ["RateLimiter", "allow", "allow", "allow"], "args": [[1, 1], ["a", 0], ["a", 0], ["a", 1]], "expected": [null, true, false, true], "label": "smallest limiter"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 100], ["a", 0], ["a", 99], ["a", 100], ["a", 150], ["a", 250], ["a", 300]], "expected": [null, true, false, true, false, true, false], "label": "capacity 1: one request per interval"},
    {"ops": ["RateLimiter", "allow", "allow", "allow"], "args": [[1, 10], ["a", 0], ["a", 5], ["a", 10]], "expected": [null, true, false, true], "label": "a refusal takes nothing"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 100], ["a", 0], ["a", 0], ["a", 10], ["a", 20], ["a", 30], ["a", 40], ["a", 50], ["a", 60], ["a", 70], ["a", 80], ["a", 90], ["a", 100], ["a", 100]], "expected": [null, true, true, false, false, false, false, false, false, false, false, false, true, false], "label": "refusals in a row keep the refill"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[5, 1000], ["a", 7], ["a", 7], ["a", 7], ["a", 7], ["a", 7], ["a", 7]], "expected": [null, true, true, true, true, true, false], "label": "a burst within one millisecond"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 1000], ["a", 0], ["b", 0], ["a", 1], ["c", 1], ["b", 999], ["b", 1000], ["a", 1000]], "expected": [null, true, true, false, true, false, true, true], "label": "clients never share a bucket"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 1000000], ["old", 0], ["late", 1000000000], ["late", 1000000000], ["late", 1000000000], ["late", 1000000000], ["old", 1000000000]], "expected": [null, true, true, true, true, false, true], "label": "a new client starts full, however late"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 100], ["a", 0], ["a", 5030], ["a", 5030], ["a", 5030], ["a", 5100], ["a", 5130]], "expected": [null, true, true, true, false, false, true], "label": "time spent full is not saved up"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 100], ["a", 0], ["a", 0], ["a", 0], ["a", 150], ["a", 300], ["a", 300], ["a", 450], ["a", 450], ["a", 600], ["a", 600]], "expected": [null, true, true, true, true, true, true, true, false, true, true], "label": "requests 1.5 intervals apart"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 1], ["a", 0], ["a", 0], ["a", 0], ["a", 1], ["a", 1], ["a", 3], ["a", 3], ["a", 3]], "expected": [null, true, true, false, true, false, true, true, false], "label": "one token per millisecond"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 1000000], ["a", 0], ["a", 999999], ["a", 1000000], ["a", 1999999], ["a", 2000000], ["a", 1000000000], ["a", 1000000000]], "expected": [null, true, false, true, false, true, true, false], "label": "long interval, slow refill"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow"], "args": [[100000, 1000000], ["a", 0], ["b", 0], ["a", 1000000000], ["a", 1000000000]], "expected": [null, true, true, true, true], "label": "largest capacity and interval"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 3], ["a", 8], ["c", 13], ["b", 13], ["a", 13], ["a", 13], ["c", 24], ["c", 24], ["c", 24], ["a", 24], ["c", 24], ["a", 24], ["c", 25], ["c", 25], ["b", 29], ["c", 30], ["a", 36], ["b", 38], ["c", 39], ["c", 45], ["b", 45], ["a", 57], ["c", 60], ["b", 65], ["c", 66], ["a", 69], ["a", 69], ["b", 74], ["b", 84], ["a", 86], ["c", 93], ["b", 93], ["a", 93], ["a", 93], ["b", 94], ["c", 102], ["a", 102], ["c", 107], ["b", 107], ["b", 119], ["c", 123]], "expected": [null, true, true, true, true, false, true, false, false, true, false, false, false, false, true, true, true, true, true, true, true, true, true, true, true, true, false, true, true, true, true, true, true, false, false, true, true, true, true, true, true], "label": "random 1"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[4, 3], ["a", 11], ["c", 11], ["c", 17], ["a", 20], ["c", 29], ["c", 29], ["c", 36], ["c", 36], ["c", 44], ["c", 44], ["c", 48], ["a", 48], ["c", 49], ["c", 54], ["c", 54], ["a", 61], ["c", 73], ["a", 73], ["a", 79], ["b", 86], ["a", 86], ["a", 97], ["a", 97], ["a", 100], ["a", 100], ["c", 105], ["a", 117], ["b", 120], ["c", 120], ["a", 120], ["b", 131], ["b", 139], ["a", 150], ["b", 158], ["c", 160], ["c", 160], ["c", 160], ["a", 164], ["b", 173], ["b", 173]], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true], "label": "random 2"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[4, 10], ["b", 18], ["a", 24], ["a", 24], ["c", 31], ["b", 35], ["c", 43], ["c", 43], ["c", 46], ["b", 46], ["c", 54], ["b", 60], ["c", 63], ["b", 63], ["a", 69], ["b", 69], ["a", 72], ["b", 72], ["a", 72], ["a", 72], ["c", 72], ["b", 72], ["a", 78], ["b", 78], ["a", 78], ["b", 84], ["c", 84], ["b", 92], ["b", 93], ["c", 103], ["c", 103], ["b", 103], ["a", 103], ["c", 114], ["a", 114], ["a", 124], ["b", 132], ["b", 132], ["a", 141], ["c", 148], ["c", 148]], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false, false, false, true, true, true, false, true, true, true, true, true, true, true, true, true, true, true, true], "label": "random 3"},
    {"argsPy": "r = rng(101)\nops, xs, t = ['RateLimiter'], [[5, 600000]], 0\nhot = ['h' + str(i) for i in range(10)]\nfor _ in range(50000):\n    t += r.randint(0, 36000)\n    c = r.choice(hot) if r.random() < 0.5 else 'c' + str(r.randint(1, 9990))\n    ops.append('allow'); xs.append([c, t])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: 50,000 calls from 10,000 clients, t up to 10^9", "perf": true},
    {"argsPy": "r = rng(202)\nops, xs, t = ['RateLimiter'], [[400, 1]], 0\nfor _ in range(50000):\n    if r.random() < 0.002:\n        t += r.randint(1, 18000000)\n    ops.append('allow'); xs.append(['solo', t])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: one client, 50,000 calls, a token every millisecond", "perf": true}
  ]
}
