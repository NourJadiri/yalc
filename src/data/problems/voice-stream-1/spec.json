{
  "id": "voice-stream-1",
  "title": "Voice Stream: Drop Duplicates",
  "difficulty": "M",
  "topics": ["design", "sliding window", "circular buffer"],
  "kind": "design",
  "className": "StreamReceiver",
  "starter": "class StreamReceiver:\n\n    def __init__(self, window: int):\n        pass\n\n    def receive(self, seq: int, data: str, t: int) -> bool:\n        pass\n",
  "tests": [
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive"], "args": [[3], [0, "good", 0], [2, "ning", 20], [1, "mor", 25], [2, "ning", 40], [0, "good", 45]], "expected": [null, true, true, true, false, false], "show": true},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[3], [5, "how", 0], [3, "are", 10], [2, "you", 20], [9, "to", 30], [7, "day", 40], [6, "so", 50]], "expected": [null, true, true, false, true, true, false], "show": true},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[4], [0, "hel", 0], [1, "lo", 10], [1000, "wor", 20], [1, "lo", 30], [998, "ld", 40], [1000, "wor", 50]], "expected": [null, true, true, true, false, true, false], "show": true},
    {"ops": ["StreamReceiver", "receive"], "args": [[1], [7, "a", 0]], "expected": [null, true], "label": "one packet"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[1], [3, "fo", 0], [3, "fo", 10], [2, "di", 20], [4, "gu", 30], [6, "je", 40], [5, "ha", 50], [6, "je", 60]], "expected": [null, true, false, false, true, true, false, false], "label": "window 1: only rising seqs are kept"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive"], "args": [[10], [100, "ha", 0], [95, "ba", 10], [90, "ti", 20], [91, "vo", 30], [100, "ha", 40]], "expected": [null, true, true, false, true, false], "label": "the first packet needn't be seq 0"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive"], "args": [[5], [20, "ce", 0], [16, "wa", 10], [15, "vo", 20], [16, "wa", 30]], "expected": [null, true, true, false, false], "label": "both edges of the window"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive"], "args": [[50], [9, "mu", 0], [9, "mu", 10], [9, "mu", 20]], "expected": [null, true, false, false], "label": "copies of top"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive"], "args": [[4], [5, "ha", 0], [3, "fo", 10], [7, "ki", 20], [5, "ha", 30], [3, "fo", 40]], "expected": [null, true, true, true, false, false], "label": "a kept seq stays a duplicate until the window leaves it"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[4], [2, "di", 0], [3, "fo", 10], [9, "mu", 20], [6, "je", 30], [6, "je", 40], [10, "na", 50], [7, "ki", 60], [3, "fo", 70]], "expected": [null, true, true, true, true, false, true, true, false], "label": "a slot reused after the window slides"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[100000], [0, "a", 0], [1000000000, "b", 1], [999900001, "c", 2], [999900000, "d", 3], [0, "a", 4], [1000000000, "b", 5]], "expected": [null, true, true, true, false, false, false], "label": "a jump of a billion, widest window"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[100000], [16, "wa", 0], [13, "su", 3], [25, "je", 6], [9, "mu", 9], [30, "pe", 12], [11, "pe", 15], [9, "mu", 18], [5, "ha", 21], [24, "ha", 24], [22, "fo", 27], [22, "fo", 30], [17, "yu", 33], [21, "di", 36], [8, "lo", 39], [3, "fo", 42], [29, "na", 45], [0, "ba", 48], [7, "ki", 51], [12, "ro", 54], [26, "ki", 57], [23, "gu", 60], [13, "su", 63], [8, "lo", 66], [27, "lo", 69], [16, "wa", 72], [25, "je", 75], [10, "na", 78], [20, "ce", 81], [27, "lo", 84], [21, "di", 87]], "expected": [null, true, true, true, true, true, true, false, true, true, true, false, true, true, true, true, true, true, true, true, true, true, false, false, true, false, false, true, true, false, false], "label": "the window covers every seq"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[2], [0, "ba", 0], [1, "ce", 10], [2, "di", 20], [3, "fo", 30], [4, "gu", 40], [5, "ha", 50], [6, "je", 60], [7, "ki", 70]], "expected": [null, true, true, true, true, true, true, true, true], "label": "rising seqs"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[5], [9, "mu", 0], [8, "lo", 10], [7, "ki", 20], [6, "je", 30], [5, "ha", 40], [4, "gu", 50], [3, "fo", 60]], "expected": [null, true, true, true, true, true, false, false], "label": "falling seqs"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[3], [0, "ba", 0], [0, "ba", 10], [1, "ce", 20], [1, "ce", 30], [2, "di", 40], [2, "di", 50]], "expected": [null, true, false, true, false, true, false], "label": "every packet sent twice"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[2], [4, "gu", 0], [4, "gu", 10], [5, "ha", 20], [4, "gu", 30], [6, "je", 40], [4, "gu", 50], [5, "ha", 60]], "expected": [null, true, false, true, false, true, false, false], "label": "the same seq while the window moves"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[8], [0, "ba", 0], [4, "gu", 10], [2, "di", 20], [6, "je", 30], [1, "ce", 40], [3, "fo", 50], [5, "ha", 60], [7, "ki", 70]], "expected": [null, true, true, true, true, true, true, true, true], "label": "out of order but inside the window"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive"], "args": [[3], [3, "x", 5], [1, "y", 5], [3, "x", 5], [2, "z", 5]], "expected": [null, true, true, false, true], "label": "all at the same time"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[5], [4, "gu", 28], [2, "di", 43], [1, "ce", 53], [4, "gu", 61], [5, "ha", 75], [2, "di", 81], [2, "di", 88], [3, "fo", 101], [7, "ki", 115], [8, "lo", 125], [4, "gu", 137], [3, "fo", 150], [11, "pe", 163], [13, "su", 169], [10, "na", 169], [15, "vo", 169], [16, "wa", 170], [18, "zo", 172], [16, "wa", 183], [18, "zo", 198], [21, "di", 207], [16, "wa", 207], [16, "wa", 208], [21, "di", 222], [16, "wa", 236], [15, "vo", 241], [16, "wa", 255], [16, "wa", 257], [16, "wa", 267], [22, "fo", 278], [17, "yu", 286]], "expected": [null, true, true, true, false, true, false, false, true, true, true, false, false, true, true, true, true, true, true, false, false, true, false, false, false, false, false, false, false, false, true, false], "label": "random 1"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[4], [3, "fo", 32], [0, "ba", 45], [5, "ha", 46], [0, "ba", 52], [8, "lo", 58], [5, "ha", 73], [10, "na", 74], [7, "ki", 88], [10, "na", 96], [8, "lo", 99], [12, "ro", 99], [13, "su", 102], [14, "ti", 108], [15, "vo", 117], [12, "ro", 123], [17, "yu", 137], [13, "su", 148], [13, "su", 160], [20, "ce", 171], [21, "di", 178], [19, "ba", 189], [22, "fo", 199], [25, "je", 211], [23, "gu", 214], [28, "mu", 219], [31, "ro", 234], [25, "je", 238], [31, "ro", 242], [32, "su", 247], [35, "wa", 261], [30, "pe", 261], [31, "ro", 266], [28, "mu", 268], [28, "mu", 279], [38, "ba", 281], [40, "di", 282], [28, "mu", 295], [36, "yu", 310]], "expected": [null, true, true, true, false, true, false, true, true, false, false, true, true, true, true, false, true, false, false, true, true, true, true, true, true, true, true, false, false, true, true, false, false, false, false, true, true, false, false], "label": "random 2"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[1], [1, "ce", 13], [1, "ce", 18], [4, "gu", 20], [7, "ki", 21], [3, "fo", 33], [9, "mu", 33], [9, "mu", 46], [10, "na", 53], [11, "pe", 58], [13, "su", 61], [13, "su", 69], [10, "na", 69], [11, "pe", 73], [11, "pe", 75], [12, "ro", 80], [16, "wa", 84], [16, "wa", 89], [13, "su", 101], [19, "ba", 108], [19, "ba", 110], [15, "vo", 113], [20, "ce", 121], [23, "gu", 121], [23, "gu", 121], [26, "ki", 121], [28, "mu", 127], [25, "je", 139], [31, "ro", 143], [31, "ro", 145], [33, "ti", 149], [35, "wa", 160]], "expected": [null, true, false, true, true, false, true, false, true, true, true, false, false, false, false, false, true, false, false, true, false, false, true, true, false, true, true, false, true, false, true, true], "label": "random 3"},
    {"ops": ["StreamReceiver", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive", "receive"], "args": [[1], [3, "fo", 36], [5, "ha", 39], [8, "lo", 54], [9, "mu", 59], [6, "je", 65], [12, "ro", 69], [15, "vo", 77], [13, "su", 87], [15, "vo", 93], [17, "yu", 96], [19, "ba", 109], [19, "ba", 121], [20, "ce", 130], [23, "gu", 140], [25, "je", 146], [26, "ki", 160], [28, "mu", 168], [25, "je", 169], [29, "na", 183], [28, "mu", 196], [32, "su", 207], [26, "ki", 215], [32, "su", 228], [33, "ti", 242], [36, "yu", 247], [36, "yu", 249], [33, "ti", 252], [38, "ba", 256], [40, "di", 262], [42, "gu", 268], [43, "ha", 271], [46, "lo", 284], [49, "pe", 297], [48, "na", 300]], "expected": [null, true, true, true, true, false, true, true, false, false, true, true, false, true, true, true, true, true, false, true, false, true, false, false, true, true, false, false, true, true, true, true, true, true, false], "label": "random 4"},
    {"argsPy": "r = rng(1)\nw = 10**5\nops = [\"StreamReceiver\"]; xs = [[w]]\nhi = t = 0\nfor i in range(100000):\n    x = r.random()\n    if x < 0.6:\n        hi += r.randint(1, 3); s = hi\n    elif x < 0.9:\n        s = max(0, hi - r.randint(0, 2 * w))\n    else:\n        s = max(0, hi - r.randint(0, 20))\n    t += r.randint(0, 2)\n    ops.append(\"receive\"); xs.append([s, \"abcdefghijklmnopqrstuvwxyz\"[s % 26], t])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 10^5 packets, window 10^5", "perf": true},
    {"argsPy": "r = rng(2)\nw = 10**5\nL = \"abcdefghijklmnopqrstuvwxyz\"\nops = [\"StreamReceiver\"]; xs = [[w]]\nhi = t = 0\nfor k in range(2500):\n    hi += r.randint(w // 2, w); t += 1\n    ops.append(\"receive\"); xs.append([hi, L[hi % 26], t])\n    sent = [hi]\n    for j in range(39):\n        x = r.random()\n        if x < 0.4: s = r.choice(sent)\n        elif x < 0.6: s = max(0, hi - w - r.randint(0, 1000))\n        else: s = max(0, hi - r.randint(1, w - 1))\n        sent.append(s); t += 1\n        ops.append(\"receive\"); xs.append([s, L[s % 26], t])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 2500 jumps of up to a whole window", "perf": true}
  ]
}
