{
  "id": "diff-merge-1",
  "title": "Diff & Merge: Line Diff",
  "difficulty": "M",
  "topics": ["design", "dynamic programming", "string"],
  "kind": "design",
  "className": "DiffTool",
  "starter": "class DiffTool:\n\n    def __init__(self):\n        pass\n\n    def diff(self, a: List[str], b: List[str]) -> List[str]:\n        pass\n",
  "tests": [
    {"ops": ["DiffTool", "diff"], "args": [[], [["milk", "eggs", "bread"], ["milk", "flour", "bread"]]], "expected": [null, [" milk", "-eggs", "+flour", " bread"]], "show": true},
    {"ops": ["DiffTool", "diff"], "args": [[], [["title", "intro", "body"], ["draft", "title", "intro", "notes"]]], "expected": [null, ["+draft", " title", " intro", "-body", "+notes"]], "show": true},
    {"ops": ["DiffTool", "diff"], "args": [[], [["log", "ok", "ok"], ["ok"]]], "expected": [null, ["-log", "-ok", " ok"]], "show": true},
    {"ops": ["DiffTool", "diff"], "args": [[], [[], []]], "expected": [null, []], "label": "both files empty"},
    {"ops": ["DiffTool", "diff"], "args": [[], [[], ["p", "q"]]], "expected": [null, ["+p", "+q"]], "label": "old file empty: every line is added"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["p", "q"], []]], "expected": [null, ["-p", "-q"]], "label": "new file empty: every line is deleted"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["a", "b", "a"], ["a", "b", "a"]]], "expected": [null, [" a", " b", " a"]], "label": "identical files"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["old"], ["new"]]], "expected": [null, ["-old", "+new"]], "label": "one line replaced: the delete comes first"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["p", "q"], ["q", "p"]]], "expected": [null, ["-p", " q", "+p"]], "label": "two lines swapped"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["s", "s"], ["s"]]], "expected": [null, [" s", "-s"]], "label": "the shared top is taken before the shared bottom"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["1", "2", "3"], ["1", "2", "new", "3"]]], "expected": [null, [" 1", " 2", "+new", " 3"]], "label": "a pure insertion between the shared ends"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["p", "q", "r", "s"], ["q", "r", "s", "p"]]], "expected": [null, ["-p", " q", " r", " s", "+p"]], "label": "a line moved down"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["q", "r", "s", "p"], ["p", "q", "r", "s"]]], "expected": [null, ["+p", " q", " r", " s", "-p"]], "label": "a line moved up: the add has to come first"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["y", "x", "x", "y"], ["x", "y", "y"]]], "expected": [null, ["-y", " x", "-x", "+y", " y"]], "label": "repeated lines"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["", "x"], ["x", ""]]], "expected": [null, ["-", " x", "+"]], "label": "empty lines"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["- item", "+ item", " item"], ["+ item", "- item"]]], "expected": [null, ["-- item", " + item", "- item", "+- item"]], "label": "lines that start with -, + or a space"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["Hello", "world "], ["hello", "world"]]], "expected": [null, ["-Hello", "-world ", "+hello", "+world"]], "label": "case and trailing spaces matter"},
    {"ops": ["DiffTool", "diff", "diff", "diff"], "args": [[], [["a", "b"], ["b", "c"]], [["b", "c"], ["a", "b"]], [["a", "b"], ["a", "b"]]], "expected": [null, ["-a", " b", "+c"], ["+a", " b", "-c"], [" a", " b"]], "label": "the tool keeps no state"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["y", "z", "z", "z", "x", "x", "z", "y", "z", "z", "y"], ["y", "z", "x", "y", "y", "x", "x", "z", "y"]]], "expected": [null, [" y", " z", "-z", "-z", " x", "-x", "-z", " y", "-z", "+y", "+x", "+x", " z", " y"]], "label": "random 1"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["return x", "", "print(y)", "{", "return x", "# todo", "y = 2", "# todo", "x = 1", "{", "", "# todo", "return x", "", "return x", "x = 1", "# todo", "y = 2"], ["x = 1", "}", "return x", "print(y)", "}", "{", "{", "x = 1", "# todo", "y = 2"]]], "expected": [null, ["+x = 1", "+}", " return x", "-", " print(y)", "+}", " {", "-return x", "-# todo", "-y = 2", "-# todo", "-x = 1", " {", "-", "-# todo", "-return x", "-", "-return x", " x = 1", " # todo", " y = 2"]], "label": "random 2"},
    {"ops": ["DiffTool", "diff"], "args": [[], [["r", "r", "q", "q", "q", "p", "q", "r", "p", "s", "q", "p", "r", "q", "p", "r", "s", "s", "q", "r", "r", "q", "s", "s", "r", "q", "q", "q"], ["r", "r", "q", "r", "p", "r", "r", "s", "q", "s", "s", "q", "r", "q", "q", "r", "r", "r", "s", "r", "r", "q", "q", "q"]]], "expected": [null, [" r", " r", " q", "-q", "-q", "-p", "-q", " r", " p", "-s", "-q", "-p", " r", "-q", "-p", " r", " s", "+q", " s", "+s", " q", " r", "-r", " q", "-s", "+q", "+r", "+r", "+r", " s", "+r", " r", " q", " q", " q"]], "label": "random 3"},
    {"argsPy": "r = rng(2026)\nwords = ['{', '}', '', 'x += 1', 'y -= 1', 'return x', 'print(y)', 'if x:']\ntop = ['line ' + str(k) for k in range(1, 4751)]\nbottom = ['line ' + str(k) for k in range(5251, 10001)]\nmid_a = [r.choice(words) for _ in range(500)]\nmid_b = [r.choice(words) for _ in range(500)]\nmid_a[0], mid_b[0], mid_a[-1], mid_b[-1] = 'old start', 'new start', 'old end', 'new end'\nargs = {'ops': ['DiffTool', 'diff'], 'args': [[], [top + mid_a + bottom, top + mid_b + bottom]]}", "expected": null, "label": "large: 10^4-line files, 500 lines differ in the middle", "perf": true},
    {"argsPy": "a = ['line ' + str(k) for k in range(1, 10001)]\nb = a[:2] + ['line 3, edited', 'a new line'] + a[3:]\nargs = {'ops': ['DiffTool', 'diff'], 'args': [[], [a, b]]}", "expected": null, "label": "large: 10^4-line files, one edit near the top", "perf": true},
    {"argsPy": "r = rng(500)\nwords = ['{', '}', '', 'x += 1', 'y -= 1', 'return x', 'print(y)', 'if x:']\na = ['first a'] + [r.choice(words) for _ in range(498)] + ['last a']\nb = ['first b'] + [r.choice(words) for _ in range(498)] + ['last b']\nargs = {'ops': ['DiffTool', 'diff'], 'args': [[], [a, b]]}", "expected": [null, ["-first a", "-if x:", "-if x:", "-y -= 1", "+first b", "+return x", " print(y)", " x += 1", " }", "-return x", "+print(y)", "+print(y)", " }", "-{", "-x += 1", "+", " return x", "-x += 1", "+{", " print(y)", " y -= 1", "-{", "+print(y)", " }", "-return x", " if x:", "-y -= 1", "-return x", " ", "-if x:", "+y -= 1", " }", "+", " x += 1", "+y -= 1", "+}", "+print(y)", "+print(y)", "+{", "+if x:", " return x", "-", "+if x:", " return x", "+y -= 1", "+x += 1", "+print(y)", "+print(y)", "+x += 1", "+if x:", " return x", " return x", " if x:", "+y -= 1", "+print(y)", " ", "-}", "-{", "+x += 1", " ", "-if x:", "-if x:", "+return x", "+x += 1", "+y -= 1", "+return x", " ", "-if x:", "-if x:", "+}", "+x += 1", "+return x", " print(y)", "-", "+}", " if x:", "+return x", "+}", " y -= 1", "+x += 1", "+x += 1", "+", "+if x:", "+x += 1", " y -= 1", "+return x", "+return x", " {", " if x:", "+print(y)", "+print(y)", "+{", "+print(y)", "+if x:", " return x", "-y -= 1", " return x", " return x", "-{", "-}", " return x", "-y -= 1", " if x:", " ", "+", "+if x:", " return x", " print(y)", "-{", "+print(y)", " return x", "-y -= 1", "-{", "-{", "-{", "+print(y)", " {", "+x += 1", " {", "-", " print(y)", "-}", "-if x:", " x += 1", "-x += 1", " y -= 1", "+", "+}", "+}", "+if x:", "+{", " print(y)", " y -= 1", " if x:", " if x:", "-", "+return x", "+print(y)", "+x += 1", " if x:", "+", "+}", " {", "+if x:", "+if x:", " {", "+y -= 1", " ", " }", "+", "+x += 1", "+y -= 1", "+x += 1", " if x:", "+{", "+{", "+print(y)", " }", " return x", "+}", "+y -= 1", "+if x:", " return x", "-print(y)", "+y -= 1", "+if x:", " ", " y -= 1", "-return x", "+y -= 1", "+}", "+x += 1", "+", "+x += 1", " {", " print(y)", "+}", "+", "+print(y)", " if x:", "-x += 1", "-{", "-{", "-{", " return x", "-return x", "+}", "+print(y)", " return x", "-y -= 1", " print(y)", " {", "-{", "+print(y)", " if x:", "+return x", "+y -= 1", "+", "+{", "+y -= 1", "+}", "+return x", "+}", " print(y)", "+y -= 1", "+}", " if x:", " ", " x += 1", "-return x", " {", "+", " y -= 1", "-}", "+x += 1", "+y -= 1", " }", " {", "-return x", "+}", " if x:", "-{", "-return x", " x += 1", "+}", " x += 1", "-", " print(y)", "+if x:", " {", "-y -= 1", "-return x", "-return x", " {", " x += 1", " y -= 1", "-", " }", "-if x:", "-if x:", "+", "+", " print(y)", " if x:", " {", " return x", "-", "-return x", " if x:", "-}", " print(y)", "-y -= 1", "-x += 1", "-{", " print(y)", "-return x", " if x:", "-return x", "-return x", "-return x", "+}", " return x", "+if x:", " ", "-return x", " }", "-print(y)", "-", " {", " if x:", "-}", " if x:", " ", "-print(y)", "-", "-x += 1", " }", "-x += 1", "-{", "+", " x += 1", "-{", "+y -= 1", "+y -= 1", "+return x", " x += 1", " y -= 1", "-if x:", "-print(y)", "+return x", "+", " x += 1", "-}", " y -= 1", " {", " return x", "-x += 1", "-print(y)", "-}", "+if x:", " {", "+x += 1", " ", "+if x:", "+x += 1", "+x += 1", "+if x:", "+return x", "+return x", " {", "+print(y)", "+if x:", "+print(y)", "+if x:", "+print(y)", "+print(y)", "+if x:", " return x", "+y -= 1", "+y -= 1", "+y -= 1", "+y -= 1", " x += 1", "-{", "-{", "+x += 1", "+print(y)", " }", "+y -= 1", "+x += 1", " return x", "-if x:", "+}", " y -= 1", "+}", "+", "+y -= 1", "+", " return x", "-{", " return x", " return x", "+if x:", "+y -= 1", "+x += 1", "+x += 1", " return x", " ", "+y -= 1", "+print(y)", "+}", "+}", "+if x:", "+x += 1", "+y -= 1", " return x", "-{", "+}", " return x", " y -= 1", "-if x:", "+}", "+", "+print(y)", "+", " x += 1", "-{", "+if x:", "+print(y)", " ", " return x", "+if x:", "+y -= 1", "+print(y)", "+", "+y -= 1", "+if x:", "+print(y)", "+y -= 1", " x += 1", " return x", "+x += 1