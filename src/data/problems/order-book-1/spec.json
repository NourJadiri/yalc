    {"argsPy": "r = rng(2024)\nbuyers = [\"ada\", \"ben\", \"cy\", \"dee\", \"eli\", \"flo\"]\nsellers = [\"gus\", \"hal\", \"ida\", \"jo\", \"kai\", \"lu\"]\nops, xs = [\"OrderBook\"], [[]]\nfor _ in range(7500):\n    ops += [\"buy\", \"sell\"]\n    xs += [[r.choice(buyers), r.randint(4000, 4999), r.randint(1, 50)],\n           [r.choice(sellers), r.randint(5001, 6000), r.randint(1, 50)]]\nfor k in range(22500):\n    if k % 8 == 7:\n        ops.append(\"top\"); xs.append([])\n    elif k % 2:\n        ops.append(\"buy\"); xs.append([r.choice(buyers), r.randint(4950, 5050), r.randint(1, 50)])\n    else:\n        ops.append(\"sell\"); xs.append([r.choice(sellers), r.randint(4950, 5050), r.randint(1, 50)])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: deep book, constant crossing", "perf": true},
    {"argsPy": "r = rng(7)\nsellers = [\"mo\", \"nia\", \"oz\", \"pat\", \"quin\"]\nops, xs = [\"OrderBook\"], [[]]\nfor _ in range(2):\n    for _ in range(10000):\n        ops.append(\"sell\"); xs.append([r.choice(sellers), r.randint(1, 10000), 1])\n    ops += [\"top\", \"buy\", \"top\"]\n    xs += [[], [\"rex\", 10000, 10000], []]\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: sweeps through 10,000 one-share orders", "perf": true}
