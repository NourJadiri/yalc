{
  "id": "order-book-1",
  "title": "Order Book: Match on Arrival",
  "difficulty": "M",
  "topics": ["design", "heap", "simulation"],
  "kind": "design",
  "className": "OrderBook",
  "starter": "class OrderBook:\n\n    def __init__(self):\n        pass\n\n    def buy(self, trader: str, price: int, qty: int) -> List[List[int]]:\n        pass\n\n    def sell(self, trader: str, price: int, qty: int) -> List[List[int]]:\n        pass\n\n    def top(self) -> List[int]:\n        pass\n",
  "tests": [
    {"ops": ["OrderBook", "sell", "sell", "sell", "buy", "top"], "args": [[], ["ann", 103, 5], ["bob", 101, 3], ["cat", 102, 4], ["dan", 102, 9], []], "expected": [null, [], [], [], [[4, 2, 101, 3], [4, 3, 102, 4]], [102, 103]], "show": true},
    {"ops": ["OrderBook", "buy", "buy", "sell", "sell", "top"], "args": [[], ["ann", 50, 4], ["bob", 50, 6], ["cat", 50, 3], ["dan", 49, 5], []], "expected": [null, [], [], [[1, 3, 50, 3]], [[1, 4, 50, 1], [2, 4, 50, 4]], [50, 0]], "show": true},
    {"ops": ["OrderBook", "top", "buy", "sell", "sell", "buy", "top"], "args": [[], [], ["ann", 10, 2], ["bob", 8, 2], ["cat", 9, 1], ["dan", 9, 1], []], "expected": [null, [0, 0], [], [[1, 2, 10, 2]], [], [[4, 3, 9, 1]], [0, 0]], "show": true},
    {"ops": ["OrderBook", "top"], "args": [[], []], "expected": [null, [0, 0]], "label": "empty book"},
    {"ops": ["OrderBook", "buy", "top"], "args": [[], ["ann", 7, 3], []], "expected": [null, [], [7, 0]], "label": "one bid, no asks"},
    {"ops": ["OrderBook", "sell", "top"], "args": [[], ["ann", 7, 3], []], "expected": [null, [], [0, 7]], "label": "one ask, no bids"},
    {"ops": ["OrderBook", "sell", "buy", "top"], "args": [[], ["ann", 100, 10], ["bob", 99, 5], []], "expected": [null, [], [], [99, 100]], "label": "a buy below the best ask doesn't trade"},
    {"ops": ["OrderBook", "sell", "buy", "top"], "args": [[], ["ann", 100, 10], ["bob", 100, 4], []], "expected": [null, [], [[2, 1, 100, 4]], [0, 100]], "label": "a buy at exactly the ask price trades"},
    {"ops": ["OrderBook", "buy", "sell", "top"], "args": [[], ["ann", 100, 10], ["bob", 100, 10], []], "expected": [null, [], [[1, 2, 100, 10]], [0, 0]], "label": "a sell at exactly the bid price trades"},
    {"ops": ["OrderBook", "buy", "buy", "sell", "top"], "args": [[], ["ann", 10000, 3], ["bob", 9000, 3], ["cat", 1, 4], []], "expected": [null, [], [], [[1, 3, 10000, 3], [2, 3, 9000, 1]], [9000, 0]], "label": "a sell at 1 trades at the bids' prices"},
    {"ops": ["OrderBook", "sell", "buy", "top", "buy", "top"], "args": [[], ["ann", 20, 6], ["bob", 25, 6], [], ["cat", 30, 1], []], "expected": [null, [], [[2, 1, 20, 6]], [0, 0], [], [30, 0]], "label": "equal quantities empty both orders"},
    {"ops": ["OrderBook", "sell", "sell", "sell", "sell", "buy", "top"], "args": [[], ["ann", 12, 2], ["bob", 10, 1], ["cat", 11, 3], ["dan", 10, 2], ["eve", 15, 10], []], "expected": [null, [], [], [], [], [[5, 2, 10, 1], [5, 4, 10, 2], [5, 3, 11, 3], [5, 1, 12, 2]], [15, 0]], "label": "a buy sweeps every ask, then rests"},
    {"ops": ["OrderBook", "buy", "buy", "buy", "buy", "sell", "top"], "args": [[], ["ann", 8, 1], ["bob", 9, 2], ["cat", 8, 2], ["dan", 9, 1], ["eve", 7, 5], []], "expected": [null, [], [], [], [], [[2, 5, 9, 2], [4, 5, 9, 1], [1, 5, 8, 1], [3, 5, 8, 1]], [8, 0]], "label": "a sell takes the highest bids first, oldest first"},
    {"ops": ["OrderBook", "sell", "sell", "buy", "buy", "buy", "top"], "args": [[], ["ann", 30, 5], ["bob", 30, 5], ["cat", 30, 3], ["dan", 30, 4], ["eve", 30, 3], []], "expected": [null, [], [], [[3, 1, 30, 3]], [[4, 1, 30, 2], [4, 2, 30, 2]], [[5, 2, 30, 3]], [0, 0]], "label": "a partly filled order keeps its place in line"},
    {"ops": ["OrderBook", "buy", "buy", "buy", "buy", "buy", "sell", "top"], "args": [[], ["ann", 40, 1], ["bob", 40, 2], ["cat", 40, 3], ["dan", 40, 4], ["eve", 40, 5], ["fay", 40, 12], []], "expected": [null, [], [], [], [], [], [[1, 6, 40, 1], [2, 6, 40, 2], [3, 6, 40, 3], [4, 6, 40, 4], [5, 6, 40, 2]], [40, 0]], "label": "five orders at one price fill in arrival order"},
    {"ops": ["OrderBook", "buy", "sell", "buy", "buy", "top"], "args": [[], ["ann", 50, 5], ["bob", 48, 8], ["cat", 47, 1], ["dan", 49, 2], []], "expected": [null, [], [[1, 2, 50, 5]], [], [[4, 2, 48, 2]], [47, 48]], "label": "the rest of an incoming order trades later under its id"},
    {"ops": ["OrderBook", "buy", "sell", "buy", "sell", "top"], "args": [[], ["ann", 95, 4], ["ann", 105, 4], ["bob", 97, 2], ["cat", 96, 3], []], "expected": [null, [], [], [], [[3, 4, 97, 2]], [95, 96]], "label": "one trader on both sides"},
    {"ops": ["OrderBook", "sell", "sell", "buy", "buy", "top"], "args": [[], ["ann", 10000, 10000], ["bob", 9999, 10000], ["cat", 10000, 10000], ["dan", 10000, 10000], []], "expected": [null, [], [], [[3, 2, 9999, 10000]], [[4, 1, 10000, 10000]], [0, 0]], "label": "largest prices and quantities"},
