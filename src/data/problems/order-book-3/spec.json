    {"argsPy": "r = rng(4242)\nbuyers = [\"ada\", \"ben\", \"cy\", \"dee\", \"eli\", \"flo\"]\nsellers = [\"gus\", \"hal\", \"ida\", \"jo\", \"kai\", \"lu\"]\nops, xs = [\"OrderBook\"], [[]]\nfor k in range(30000):\n    if k % 3:\n        ops.append(\"buy\"); xs.append([r.choice(buyers), r.randint(4000, 4999), r.randint(1, 50)])\n    else:\n        ops.append(\"sell\"); xs.append([r.choice(sellers), r.randint(5001, 6000), r.randint(1, 50)])\nids = list(range(1, 30001))\nr.shuffle(ids)\nfor k, oid in enumerate(ids[:25000]):\n    ops.append(\"cancel\"); xs.append([oid])\n    if k % 10 == 0:\n        ops.append(\"top\"); xs.append([])\n    if k % 25 == 0:\n        if r.random() < 0.5:\n            ops.append(\"buy\"); xs.append([r.choice(buyers), r.randint(5001, 6000), r.randint(1, 100)])\n        else:\n            ops.append(\"sell\"); xs.append([r.choice(sellers), r.randint(4000, 4999), r.randint(1, 100)])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "step 2: large: cancel most of 30,000 resting orders", "perf": true},
