{
  "id": "order-book-3",
  "title": "Order Book: Amend Orders",
  "difficulty": "M",
  "topics": ["design", "heap", "hash map", "lazy deletion"],
  "kind": "design",
  "className": "OrderBook",
  "starter": "class OrderBook:\n\n    def __init__(self):\n        pass\n\n    def buy(self, trader: str, price: int, qty: int) -> List[List[int]]:\n        pass\n\n    def sell(self, trader: str, price: int, qty: int) -> List[List[int]]:\n        pass\n\n    def top(self) -> List[int]:\n        pass\n\n    def cancel(self, order_id: int) -> bool:\n        pass\n\n    def amend(self, order_id: int, qty: int) -> bool:\n        pass\n",
  "tests": [
    {"ops": ["OrderBook", "sell", "sell", "amend", "buy"], "args": [[], ["ann", 40, 5], ["bob", 40, 5], [1, 2], ["cat", 40, 4]], "expected": [null, [], [], true, [[3, 1, 40, 2], [3, 2, 40, 2]]], "show": true},
    {"ops": ["OrderBook", "sell", "sell", "amend", "buy", "top"], "args": [[], ["ann", 40, 5], ["bob", 40, 5], [1, 8], ["cat", 40, 6], []], "expected": [null, [], [], true, [[3, 2, 40, 5], [3, 1, 40, 1]], [0, 40]], "show": true},
    {"ops": ["OrderBook", "buy", "buy", "sell", "amend", "sell", "amend", "amend"], "args": [[], ["ann", 25, 10], ["bob", 25, 3], ["cat", 25, 4], [1, 8], ["dan", 25, 5], [2, 3], [9, 1]], "expected": [null, [], [], [[1, 3, 25, 4]], true, [[2, 4, 25, 3], [1, 4, 25, 2]], false, false], "show": true},
    {"ops": ["OrderBook", "buy", "buy", "amend", "sell"], "args": [[], ["ann", 30, 4], ["bob", 30, 4], [1, 4], ["cat", 30, 5]], "expected": [null, [], [], true, [[1, 3, 30, 4], [2, 3, 30, 1]]], "label": "amending to the same quantity keeps the place"},
    {"ops": ["OrderBook", "amend"], "args": [[], [1, 5]], "expected": [null, false], "label": "amend on an empty book"},
    {"ops": ["OrderBook", "sell", "cancel", "amend", "top"], "args": [[], ["ann", 10, 5], [1], [1, 3], []], "expected": [null, [], true, false, [0, 0]], "label": "amend a cancelled order"},
    {"ops": ["OrderBook", "sell", "buy", "amend", "amend", "top"], "args": [[], ["ann", 10, 5], ["bob", 10, 5], [1, 5], [2, 1], []], "expected": [null, [], [[2, 1, 10, 5]], false, false, [0, 0]], "label": "amend orders that traded away"},
    {"ops": ["OrderBook", "amend", "buy", "sell"], "args": [[], [1, 1], ["ann", 10, 2], ["bob", 10, 2]], "expected": [null, false, [], [[1, 2, 10, 2]]], "label": "amend an id before it exists"},
    {"ops": ["OrderBook", "buy", "buy", "amend", "amend", "sell", "top"], "args": [[], ["ann", 50, 5], ["bob", 50, 5], [1, 1], [2, 10000], ["cat", 50, 10000], []], "expected": [null, [], [], true, true, [[1, 3, 50, 1], [2, 3, 50, 9999]], [50, 0]], "label": "lower to 1, raise to 10^4"},
    {"ops": ["OrderBook", "sell", "sell", "amend", "cancel", "top", "buy", "top"], "args": [[], ["ann", 20, 1], ["bob", 21, 1], [1, 5], [1], [], ["cat", 21, 2], []], "expected": [null, [], [], true, true, [0, 21], [[3, 2, 21, 1]], [21, 0]], "label": "raise, then cancel"},
    {"ops": ["OrderBook", "sell", "sell", "sell", "amend", "amend", "buy", "top"], "args": [[], ["ann", 60, 2], ["bob", 60, 2], ["cat", 60, 2], [2, 3], [1, 3], ["dan", 60, 9], []], "expected": [null, [], [], [], true, true, [[4, 3, 60, 2], [4, 2, 60, 3], [4, 1, 60, 3]], [60, 0]], "label": "two raises: the later one queues last"},
    {"ops": ["OrderBook", "buy", "buy", "amend", "amend", "sell"], "args": [[], ["ann", 70, 5], ["bob", 70, 5], [1, 9], [1, 2], ["cat", 70, 6]], "expected": [null, [], [], true, true, [[2, 3, 70, 5], [1, 3, 70, 1]]], "label": "raise, then lower: the new place stays"},
    {"ops": ["OrderBook", "sell", "sell", "amend", "sell", "buy", "top"], "args": [[], ["ann", 80, 1], ["bob", 80, 1], [1, 2], ["cat", 80, 1], ["dan", 80, 3], []], "expected": [null, [], [], true, [], [[4, 2, 80, 1], [4, 1, 80, 2]], [0, 80]], "label": "a later arrival queues behind a raised order"},
    {"ops": ["OrderBook", "buy", "buy", "amend", "sell", "top"], "args": [[], ["ann", 90, 3], ["bob", 90, 3], [1, 4], ["cat", 90, 4], []], "expected": [null, [], [], true, [[2, 3, 90, 3], [1, 3, 90, 1]], [90, 0]], "label": "raise a bid"},
    {"ops": ["OrderBook", "sell", "amend", "buy", "top"], "args": [[], ["ann", 15, 2], [1, 7], ["bob", 15, 10], []], "expected": [null, [], true, [[2, 1, 15, 7]], [15, 0]], "label": "a raised order trades its new quantity"},
    {"ops": ["OrderBook", "buy", "sell", "amend", "amend", "top"], "args": [[], ["ann", 10, 5], ["bob", 11, 5], [1, 9], [2, 1], []], "expected": [null, [], [], true, true, [10, 11]], "label": "amending never trades"},
    {"ops": ["OrderBook", "sell", "buy", "sell", "amend", "buy", "top"], "args": [[], ["ann", 33, 10], ["bob", 33, 6], ["cat", 33, 3], [1, 7], ["dan", 33, 5], []], "expected": [null, [], [[2, 1, 33, 6]], [], true, [[4, 3, 33, 3], [4, 1, 33, 2]], [0, 33]], "label": "a raise is measured against what's left"},
