    {"argsPy": "r = rng(3131)\nbuyers = [\"ada\", \"ben\", \"cy\", \"dee\", \"eli\", \"flo\"]\nsellers = [\"gus\", \"hal\", \"ida\", \"jo\", \"kai\", \"lu\"]\nops, xs = [\"OrderBook\"], [[]]\nfor k in range(22000):\n    if k % 3:\n        ops.append(\"buy\"); xs.append([r.choice(buyers), r.randint(4900, 4999), r.randint(1, 50)])\n    else:\n        ops.append(\"sell\"); xs.append([r.choice(sellers), r.randint(5001, 5100), r.randint(1, 50)])\nn = len(ops) - 1\nfor k in range(22000):\n    ops.append(\"amend\"); xs.append([r.randint(1, n), r.randint(1, 100)])\n    if k % 10 == 0:\n        ops.append(\"top\"); xs.append([])\n    if k % 10 == 5:\n        n += 1\n        if r.random() < 0.5:\n            ops.append(\"buy\"); xs.append([r.choice(buyers), r.randint(5001, 5100), r.randint(1, 200)])\n        else:\n            ops.append(\"sell\"); xs.append([r.choice(sellers), r.randint(4900, 4999), r.randint(1, 200)])\n    if k % 20 == 7:\n        ops.append(\"cancel\"); xs.append([r.randint(1, n)])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 22,000 amends on a deep book", "perf": true},
