{
  "id": "file-system-3",
  "title": "File System: Move and Delete",
  "difficulty": "H",
  "topics": ["design", "trie", "tree"],
  "kind": "design",
  "className": "FileSystem",
  "starter": "class FileSystem:\n\n    def __init__(self):\n        pass\n\n    def mkdir(self, path: str) -> bool:\n        pass\n\n    def write(self, path: str, content: str) -> bool:\n        pass\n\n    def read(self, path: str) -> Optional[str]:\n        pass\n\n    def ls(self, path: str) -> List[str]:\n        pass\n\n    def size(self, path: str) -> int:\n        pass\n\n    def rm(self, path: str) -> bool:\n        pass\n\n    def mv(self, src: str, dst: str) -> bool:\n        pass\n",
  "tests": [
    {"ops": ["FileSystem", "mkdir", "write", "write", "mkdir", "mv", "ls", "size", "size", "read"], "args": [[], ["/inbox/q3"], ["/inbox/q3/r.txt", "abcd"], ["/inbox/note", "xy"], ["/archive"], ["/inbox/q3", "/archive/q3-old"], ["/archive"], ["/inbox"], ["/archive"], ["/archive/q3-old/r.txt"]], "expected": [null, true, true, true, true, true, ["q3-old"], 2, 4, "abcd"], "show": true},
    {"ops": ["FileSystem", "mkdir", "write", "mv", "mv", "mv", "ls", "ls"], "args": [[], ["/a/b"], ["/c", "x"], ["/a", "/a/b/z"], ["/a", "/c"], ["/a", "/ab"], ["/"], ["/ab"]], "expected": [null, true, true, false, false, true, ["ab", "c"], ["b"]], "show": true},
    {"ops": ["FileSystem", "mkdir", "write", "write", "rm", "size", "rm", "rm", "ls", "size"], "args": [[], ["/tmp/cache"], ["/tmp/cache/x", "12345"], ["/tmp/y", "12"], ["/tmp/cache"], ["/tmp"], ["/tmp/cache"], ["/"], ["/tmp"], ["/"]], "expected": [null, true, true, true, true, 2, false, false, ["y"], 2], "show": true},
    {"ops": ["FileSystem", "mkdir", "write", "write", "rm", "read", "size", "ls", "write", "size", "read"], "args": [[], ["/d"], ["/d/f", "abc"], ["/d/g", "12"], ["/d/f"], ["/d/f"], ["/d"], ["/d"], ["/d/f", "z"], ["/d"], ["/d/f"]], "expected": [null, true, true, true, true, null, 2, ["g"], true, 3, "z"], "label": "rm a file, then write it again"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "write", "rm", "read", "ls", "size", "size", "ls", "mkdir", "ls", "size", "size"], "args": [[], ["/a/b/c"], ["/a/b/c/f", "1234"], ["/a/b/g", "56"], ["/a/h", "7"], ["/a/b"], ["/a/b/c/f"], ["/a/b/c"], ["/a/b"], ["/a"], ["/a"], ["/a/b"], ["/a/b"], ["/a/b"], ["/"]], "expected": [null, true, true, true, true, true, null, [], -1, 1, ["h"], true, [], 0, 1], "label": "rm a folder takes everything in it"},
    {"ops": ["FileSystem", "write", "rm", "rm", "rm", "rm", "size", "rm", "rm", "size", "ls"], "args": [[], ["/f", "abc"], ["/"], ["/g"], ["/f/x"], ["/f/x/y"], ["/"], ["/f"], ["/f"], ["/"], ["/"]], "expected": [null, true, false, false, false, false, 3, true, false, 0, []], "label": "rm of the root, a missing path, a path through a file"},
    {"ops": ["FileSystem", "mkdir", "mkdir", "write", "mv", "read", "read", "ls", "size", "mv", "size", "size", "ls", "ls"], "args": [[], ["/d"], ["/e"], ["/d/a.txt", "hello"], ["/d/a.txt", "/d/b.txt"], ["/d/b.txt"], ["/d/a.txt"], ["/d"], ["/d"], ["/d/b.txt", "/e/b.txt"], ["/d"], ["/e"], ["/d"], ["/e"]], "expected": [null, true, true, true, true, "hello", null, ["b.txt"], 5, true, 0, 5, [], ["b.txt"]], "label": "rename a file, then move it to another folder"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "mv", "size", "size", "size", "mv", "size", "size", "ls", "read", "size"], "args": [[], ["/a/b/c"], ["/a/b/c/f", "1234"], ["/a/b/g", "56"], ["/a/b/c", "/c"], ["/a"], ["/a/b"], ["/c"], ["/c", "/a/x"], ["/a"], ["/a/b"], ["/a"], ["/a/x/f"], ["/"]], "expected": [null, true, true, true, true, 2, 2, 4, true, 6, 2, ["b", "x"], "1234", 6], "label": "move a folder up, out of its branch"},
    {"ops": ["FileSystem", "mkdir", "mkdir", "write", "write", "mv", "ls", "ls", "size", "size", "read", "size"], "args": [[], ["/a"], ["/b"], ["/a/f", "123"], ["/b/g", "4"], ["/a", "/b/a"], ["/"], ["/b"], ["/b"], ["/b/a"], ["/b/a/f"], ["/"]], "expected": [null, true, true, true, true, true, ["b"], ["a", "g"], 4, 3, "123", 4], "label": "move a folder into a sibling"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "mv", "mv", "mv", "read", "read", "size", "ls", "size"], "args": [[], ["/d"], ["/f", "abc"], ["/d/g", "12"], ["/f", "/d"], ["/d", "/f"], ["/f", "/d/g"], ["/f"], ["/d/g"], ["/d"], ["/"], ["/"]], "expected": [null, true, true, true, false, false, false, "abc", "12", 2, ["d", "f"], 5], "label": "mv onto an existing file or folder changes nothing"},
    {"ops": ["FileSystem", "mkdir", "write", "mv", "mv", "mv", "mv", "ls", "size", "read"], "args": [[], ["/a"], ["/a/f", "x"], ["/a", "/a"], ["/a/f", "/a/f"], ["/", "/b"], ["/a", "/"], ["/"], ["/a"], ["/a/f"]], "expected": [null, true, true, false, false, false, false, ["a"], 1, "x"], "label": "mv onto itself, from the root, to the root"},
    {"ops": ["FileSystem", "mkdir", "write", "mv", "mv", "mv", "mv", "ls", "size", "ls"], "args": [[], ["/a"], ["/f", "xy"], ["/a", "/b/a"], ["/a", "/f/a"], ["/f", "/f/f"], ["/nope", "/a/nope"], ["/"], ["/"], ["/a"]], "expected": [null, true, true, false, false, false, false, ["a", "f"], 2, []], "label": "mv when src is missing, or dst's parent is missing or a file"},
    {"ops": ["FileSystem", "mkdir", "write", "mv", "mv", "mv", "mv", "ls", "size", "size", "mv", "ls", "size"], "args": [[], ["/a/b/c"], ["/a/b/c/f", "123"], ["/a", "/a/b/z"], ["/a", "/a/b/c/z"], ["/a/b", "/a/b/c/d"], ["/a/b/c", "/a/b/c/z"], ["/a/b/c"], ["/a"], ["/"], ["/a/b/c", "/a/z"], ["/a"], ["/a/b"]], "expected": [null, true, true, false, false, false, false, ["f"], 3, 3, true, ["b", "z"], 0], "label": "a folder can't move inside itself"},
    {"ops": ["FileSystem", "mkdir", "mkdir", "write", "mv", "ls", "size", "mv", "mv", "mv", "ls", "size", "read", "ls"], "args": [[], ["/a/x"], ["/ab"], ["/a/x/f", "12"], ["/a", "/ab/a"], ["/ab"], ["/ab"], ["/ab/a", "/ab/a-b"], ["/ab/a-b", "/ab/a.b"], ["/ab", "/abc"], ["/abc"], ["/abc"], ["/abc/a.b/x/f"], ["/"]], "expected": [null, true, true, true, true, ["a"], 2, true, true, true, ["a.b"], 2, "12", ["abc"]], "label": "names that start like the source"},
    {"ops": ["FileSystem", "mkdir", "mkdir", "write", "mv", "write", "write", "size", "size", "size", "mkdir", "write", "size", "rm", "size", "size"], "args": [[], ["/old/p"], ["/new"], ["/old/p/f", "12"], ["/old/p", "/new/p"], ["/new/p/f", "123456"], ["/new/p/g", "7"], ["/old"], ["/new"], ["/new/p"], ["/new/p/q"], ["/new/p/q/h", "89"], ["/new"], ["/new/p/g"], ["/new/p"], ["/"]], "expected": [null, true, true, true, true, true, true, 0, 7, 7, true, true, 9, true, 8, 8], "label": "writes after a move update the new folders"},
    {"ops": ["FileSystem", "mkdir", "write", "mv", "ls", "size", "mkdir", "ls", "write", "ls", "read", "size", "mv", "size", "ls", "read"], "args": [[], ["/a/b"], ["/a/b/f", "xyz"], ["/a", "/c"], ["/a"], ["/a"], ["/a"], ["/a"], ["/a/b", "q"], ["/a"], ["/c/b/f"], ["/"], ["/c", "/a/c"], ["/a"], ["/a"], ["/a/c/b/f"]], "expected": [null, true, true, true, [], -1, true, [], true, ["b"], "xyz", 4, true, 4, ["b", "c"], "xyz"], "label": "the old path is free after a move"},
    {"ops": ["FileSystem", "mkdir", "write", "mv", "mv", "mv", "ls", "read", "size", "mv", "mv", "ls", "size"], "args": [[], ["/x/y"], ["/x/y/f", "abc"], ["/x", "/y"], ["/y", "/z"], ["/z", "/x"], ["/"], ["/x/y/f"], ["/x"], ["/x/y", "/x/z"], ["/x/z", "/x/y"], ["/x"], ["/"]], "expected": [null, true, true, true, true, true, ["x"], "abc", 3, true, true, ["y"], 3], "label": "a ring of renames"},
    {"argsPy": "p = \"\".join(\"/n\" + str(i) for i in range(98))\nq = \"\".join(\"/m\" + str(i) for i in range(98))\ncalls = [(\"mkdir\", p), (\"mkdir\", q), (\"write\", p + \"/f\", \"abcde\"), (\"write\", \"/n0/n1/g\", \"xy\"),\n         (\"mv\", p, q + \"/moved\"), (\"size\", \"/n0\"), (\"size\", \"/m0\"), (\"read\", q + \"/moved/f\"),\n         (\"size\", q + \"/moved\"), (\"rm\", q), (\"size\", \"/m0\"), (\"ls\", q), (\"mv\", \"/n0/n1\", \"/m0/n1\"),\n         (\"size\", \"/m0\"), (\"size\", \"/n0\"), (\"size\", \"/\")]\nargs = {\"ops\": [\"FileSystem\"] + [c[0] for c in calls], \"args\": [[]] + [list(c[1:]) for c in calls]}", "expected": [null, true, true, true, true, true, 2, 5, "abcde", 5, true, 0, [], true, 2, 0, 2], "label": "move and remove 98 names deep"},
    {"ops": ["FileSystem", "write", "ls", "write", "rm", "mkdir", "read", "size", "ls", "write", "read", "mkdir", "mkdir", "write", "size", "size", "write", "read", "size", "mv", "mv", "size", "mkdir", "write", "read", "write", "rm", "mkdir", "mkdir", "ls", "mv", "mkdir", "read", "mv", "write", "rm", "mkdir", "mv", "size", "mv", "size", "ls", "read", "write", "size", "write", "write", "ls", "write", "mv", "size"], "args": [[], ["/ab", "xy"], ["/b/a/ab"], ["/ab", "xxx"], ["/a/b/a"], ["/a"], ["/ab"], ["/a.b/a"], ["/a"], ["/a/a.b", "x"], ["/a/a.b"], ["/a/b"], ["/a.b/ab"], ["/ab", "y y"], ["/a/a.b"], ["/"], ["/a.b/ab/b", "yzy"], ["/a/a.b"], ["/"], ["/ab", "/a/b"], ["/ab", "/a/ab"], ["/b"], ["/a/b"], ["/a/a.b", ""], ["/a/b/ab"], ["/a/ab", "z"], ["/a/b/ab"], ["/a/b/b"], ["/b/a"], ["/a.b/b"], ["/a/b/b", "/a.b"], ["/a.b/a.b"], ["/a/ab"], ["/b/a/ab", "/ab/b"], ["/a/b/b", "z"], ["/a.b/ab/b"], ["/b/b"], ["/", "/a/b/b"], ["/a.b/a"], ["/b/a/a", "/a.b/ab"], ["/a/a.b"], ["/a/b"], ["/a.b/b"], ["/a/ab", "y"], ["/a.b/a.b"], ["/a", ""], ["/a/a.b", "x"], ["/a/b/b"], ["/a.b/ab", "x"], ["/a.b", "/a.b/ab"], ["/a.b/a.b/b"]], "expected": [null, true, [], true, false, true, "xxx", -1, [], true, "x", true, true, true, 1, 4, true, "x", 7, false, true, -1, true, true, null, true, false, true, true, [], false, true, "z", false, false, true, true, false, -1, false, 0, ["b"], null, true, 0, false, true, [], false, false, -1], "label": "random 1"},
    {"ops": ["FileSystem", "mv", "size", "read", "mv", "size", "mkdir", "write", "write", "rm", "mkdir", "mv", "read", "read", "mv", "size", "size", "ls", "ls", "mv", "write", "mv", "write", "write", "rm", "mkdir", "mkdir", "write", "write", "size", "read", "write", "write", "mkdir", "size", "size", "read", "write", "write", "ls", "write", "write", "read", "write", "mv", "ls", "write", "write", "mkdir", "read", "size"], "args": [[], ["/ab", "/"], ["/a/ab/ab"], ["/b"], ["/a.b/a.b/b", "/ab"], ["/ab"], ["/a.b"], ["/a.b/ab", "x "], ["/ab", "xy"], ["/b"], ["/a/b"], ["/a.b", "/a/b"], ["/a.b/ab"], ["/a/b"], ["/a.b/ab/b", "/a/a.b"], ["/a.b/ab"], ["/a.b"], ["/ab"], ["/a.b/ab"], ["/b", "/a.b/a"], ["/a.b/b", "xyz"], ["/ab/a.b/b", "/ab/ab"], ["/a.b/b", ""], ["/a.b/a.b", ""], ["/a.b/ab"], ["/a.b/a"], ["/a"], ["/a.b/b", "x"], ["/a", "xz"], ["/b/b/ab"], ["/a.b"], ["/a/b/a.b", "xz"], ["/ab/ab/a.b", "zy"], ["/a.b/a"], ["/ab/a.b/b"], ["/b"], ["/a/b/a.b"], ["/b", " y"], ["/a.b", "yxx"], ["/ab"], ["/a.b/a.b", "zzz"], ["/a/a.b", "y "], ["/a/b/a.b"], ["/b", "zzx"], ["/a", "/a/b"], ["/b/ab/b"], ["/b", "xyz"], ["/a.b/a/a.b", ""], ["/a/b/b"], ["/a/b/a.b"], ["/a/b/a.b"]], "expected": [null, false, -1, null, false, -1, true, true, true, false, true, false, "x ", null, false, 2, 2, ["ab"], ["ab"], false, true, false, true, true, true, true, true, true, false, -1, null, true, false, true, -1, -1, "xz", true, false, ["ab"], true, true, "xz", true, false, [], true, true, true, "xz", 2], "label": "random 2"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "write", "ls", "rm", "mkdir", "mv", "ls", "mkdir", "size", "mv", "mkdir", "read", "mv", "read", "ls", "size", "size", "write", "size", "size", "rm", "size", "size", "mkdir", "size", "write", "size", "read", "read", "mkdir", "mkdir", "mkdir", "ls", "mkdir", "size", "mkdir", "rm", "write", "size", "mv", "size", "read", "mkdir", "write", "write", "write", "mv", "size"], "args": [[], ["/b/a.b/ab"], ["/a/a/a.b", " "], ["/b/a.b/ab", "xy"], ["/b/a.b/a", "z"], ["/b"], ["/b"], ["/b"], ["/", "/b/a"], ["/a/a.b/a"], ["/b/ab"], ["/a/a"], ["/a.b", "/a.b/a.b"], ["/b/ab/b"], ["/"], ["/b/ab", "/b"], ["/b/ab/a.b"], ["/b/ab"], ["/ab/b/a.b"], ["/b/ab/ab"], ["/b/ab/b", "xyx"], ["/a/a.b/a.b"], ["/b"], ["/b"], ["/ab"], ["/a.b/a/a"], ["/a.b"], ["/a.b"], ["/a.b/a.b", "y"], ["/a.b/a.b"], ["/a.b/a.b"], ["/a.b/b"], ["/a.b/a.b"], ["/a.b/b"], ["/a.b"], ["/a.b/b"], ["/a"], ["/a/ab"], ["/b/a.b/a.b"], ["/ab/a.b/a.b"], ["/a.b/ab", "z"], ["/b"], ["/b/a.b/ab", "/"], ["/ab/a/b"], ["/a.b/ab"], ["/a"], ["/ab", "yz"], ["/ab", ""], ["/a.b/b/b", "x"], ["/a.b/b/b", "/a/a"], ["/a.b/a.b"]], "expected": [null, true, false, false, true, ["a.b"], true, true, false, [], true, -1, false, true, null, false, null, ["b"], -1, -1, false, -1, 0, true, -1, -1, true, 0, true, 1, "y", null, false, true, true, [], true, -1, true, false, true, 0, false, -1, "z", true, true, true, true, true, 1], "label": "random 3"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "read", "write", "size", "write", "write", "read", "ls", "ls", "mkdir", "ls", "write", "mkdir", "rm", "rm", "mkdir", "mkdir", "mkdir", "read", "mkdir", "mkdir", "size", "mv", "rm", "write", "ls", "write", "write", "size", "ls", "rm", "mkdir", "write", "mv", "rm", "mkdir", "write", "read", "mkdir", "mv", "write", "mkdir", "ls", "mkdir", "ls", "size", "size", "mv"], "args": [[], ["/a"], ["/a", ""], ["/a/ab", " "], ["/a/ab"], ["/ab", "z "], ["/a/ab"], ["/a/a/b", "x z"], ["/ab", "z"], ["/"], ["/a"], ["/a"], ["/a/b"], ["/a/ab"], ["/a/b/ab", ""], ["/a/b/ab"], ["/"], ["/a.b"], ["/a/b/a"], ["/a.b/b"], ["/a.b"], ["/a.b/a.b"], ["/ab/ab"], ["/a.b/b"], ["/a.b/ab"], ["/a.b/b", "/a/b/a"], ["/"], ["/ab/a", "z"], ["/a.b/a.b/a"], ["/a.b/b/a.b", "yzx"], ["/a.b/b/ab", "x"], ["/a/ab/a"], ["/ab"], ["/a.b"], ["/b"], ["/a.b", "z"], ["/b/b/ab", "/b"], ["/b/a.b"], ["/a.b"], ["/a.b", "z"], ["/a/b/ab"], ["/a/b/a"], ["/ab", "/a.b"], ["/b/b", " "], ["/a/b/a.b"], ["/a/b/ab"], ["/b/a.b/a"], ["/ab/a"], ["/a/b/a.b"], ["/b"], ["/ab", "/a/b/a.b"]], "expected": [null, true, false, true, " ", true, 1, false, true, null, ["ab"], ["ab"], true, ["ab"], true, false, false, false, true, true, true, null, false, true, -1, false, false, false, [], true, true, -1, ["ab"], true, true, true, false, false, false, true, "", true, false, true, true, ["ab"], true, [], 0, 1, false], "label": "random 4"},
    {"argsPy": "r = rng(3)\nops, xs, inner = [\"FileSystem\", \"mkdir\"], [[], [\"/x/y/z\"]], []\nfor i in range(100):\n    p = \"/c\" + str(i)\n    inner.append(p)\n    for d in range(1, 95):\n        p += \"/d\" + str(d)\n        inner.append(p)\n    ops.append(\"mkdir\"); xs.append([\"/big\" + p])\nfor k in range(1000):\n    ops.append(\"write\"); xs.append([\"/big\" + r.choice(inner) + \"/f\" + str(k), \"x\" * r.randint(0, 100)])\nhere, there = \"/big\", \"/x/y/z/big\"\nfor k in range(7000):\n    ops.append(\"mv\"); xs.append([here, there])\n    here, there = there, here\n    if k % 2 == 0:\n        ops.append(\"size\"); xs.append([\"/x\"])\n    if k % 14 == 1:\n        ops.append(\"size\"); xs.append([here + r.choice(inner)])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: a folder of 10,500 entries moved 7,000 times", "perf": true},
    {"argsPy": "r = rng(33)\nops, xs = [\"FileSystem\"], [[]]\nspots = [\"/s1/a/b/c\", \"/s2/e\", \"/s3/f/g\", \"/s4\"]\nfor s in spots:\n    ops.append(\"mkdir\"); xs.append([s])\nfor c in range(20):\n    here = spots[c % 4] + \"/w\" + str(c)\n    for i in range(50):\n        p = here + \"/k\" + str(i)\n        for d in range(1, 80):\n            p += \"/e\" + str(d)\n        ops.append(\"mkdir\"); xs.append([p])\n        ops.append(\"write\"); xs.append([p + \"/f\", \"x\" * r.randint(0, 100)])\n    for m in range(250):\n        nxt = r.choice(spots) + \"/w\" + str(c)\n        ops.append(\"mv\"); xs.append([here, nxt])\n        here = nxt\n        ops.append(\"size\"); xs.append([\"/\" + here.split(\"/\")[1]])\n    ops.append(\"rm\"); xs.append([here])\n    ops.append(\"size\"); xs.append([\"/\"])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 20 folders of 4,000 entries built, moved and deleted", "perf": true},
    {"ops": ["FileSystem", "mkdir", "write", "write", "size", "size", "size", "size"], "args": [[], ["/music/live"], ["/music/a.mp3", "12345"], ["/music/live/b.mp3", "123"], ["/music"], ["/music/live"], ["/music/a.mp3"], ["/"]], "expected": [null, true, true, true, 8, 3, 5, 8], "label": "step 2: example 1"},
    {"ops": ["FileSystem", "mkdir", "write", "size", "write", "size", "size", "size"], "args": [[], ["/a"], ["/a/f", "hello"], ["/a"], ["/a/f", "hi"], ["/a"], ["/a/f"], ["/"]], "expected": [null, true, true, 5, true, 2, 2, 2], "label": "step 2: example 2"},
    {"ops": ["FileSystem", "mkdir", "write", "size", "size", "size", "write", "size"], "args": [[], ["/e"], ["/e/blank", ""], ["/e/blank"], ["/e"], ["/e/nothing"], ["/e", "oops"], ["/"]], "expected": [null, true, true, 0, 0, -1, false, 0], "label": "step 2: example 3"},
    {"ops": ["FileSystem", "size", "size", "mkdir", "size", "size", "size"], "args": [[], ["/"], ["/x"], ["/x/y"], ["/x"], ["/x/y"], ["/"]], "expected": [null, 0, -1, true, 0, 0, 0], "label": "step 2: a new file system and empty folders"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "write", "write", "size", "size", "size", "size", "size", "size"], "args": [[], ["/a/b/c/d"], ["/a/f1", "1"], ["/a/b/f2", "22"], ["/a/b/c/f3", "333"], ["/a/b/c/d/f4", "4444"], ["/"], ["/a"], ["/a/b"], ["/a/b/c"], ["/a/b/c/d"], ["/a/b/c/d/f4"]], "expected": [null, true, true, true, true, true, 10, 10, 9, 7, 4, 4], "label": "step 2: files at every depth count"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "size", "size", "size", "size"], "args": [[], ["/p/q"], ["/p/q/f", "ab"], ["/p/q/f", "abcdef"], ["/p/q/f"], ["/p/q"], ["/p"], ["/"]], "expected": [null, true, true, true, 6, 6, 6, 6], "label": "step 2: overwrite with longer content"},
