{
  "id": "kv-store-3",
  "title": "Key-Value Store: Crash Recovery",
  "difficulty": "M",
  "topics": ["design", "hash map", "transactions", "write-ahead log"],
  "kind": "design",
  "className": "KVStore",
  "starter": "class KVStore:\n\n    def __init__(self, disk=None):\n        pass\n\n    def set(self, key: str, value: int) -> None:\n        pass\n\n    def get(self, key: str) -> int | None:\n        pass\n\n    def delete(self, key: str) -> bool:\n        pass\n\n    def count(self, value: int) -> int:\n        pass\n\n    def begin(self) -> None:\n        pass\n\n    def rollback(self) -> bool:\n        pass\n\n    def commit(self) -> bool:\n        pass\n\n    def recover(self) -> int:\n        pass\n",
  "tests": [
    {"ops": ["KVStore", "set", "set", "begin", "set", "delete", "crash", "recover", "get", "get", "count", "rollback"], "args": [[], ["a", 1], ["b", 2], [], ["a", 9], ["b"], [], [], ["a"], ["b"], [9], []], "expected": [null, null, null, null, null, true, null, 2, 1, 2, 0, false], "show": true},
    {"ops": ["KVStore", "begin", "set", "begin", "set", "commit", "crash", "recover", "get"], "args": [[], [], ["x", 1], [], ["y", 2], [], [], [], ["y"]], "expected": [null, null, null, null, null, true, null, 0, null], "show": true},
    {"ops": ["KVStore", "set", "begin", "set", "begin", "delete", "commit", "commit", "crash", "recover", "get", "get", "count"], "args": [[], ["k", 5], [], ["m", 5], [], ["k"], [], [], [], [], ["k"], ["m"], [5]], "expected": [null, null, null, null, null, true, true, true, null, 1, null, 5, 1], "show": true},
    {"ops": ["KVStore", "crash", "recover", "get", "count"], "args": [[], [], [], ["a"], [0]], "expected": [null, null, 0, null, 0], "label": "recover when nothing was ever written"},
    {"ops": ["KVStore", "set", "set", "delete", "set", "crash", "recover", "get", "get", "get"], "args": [[], ["a", 1], ["b", 2], ["a"], ["c", 3], [], [], ["a"], ["b"], ["c"]], "expected": [null, null, null, true, null, null, 2, null, 2, 3], "label": "changes outside transactions survive"},
    {"ops": ["KVStore", "begin", "set", "rollback", "crash", "recover", "get", "count"], "args": [[], [], ["a", 1], [], [], [], ["a"], [1]], "expected": [null, null, null, true, null, 0, null, 0], "label": "a rolled-back transaction leaves no trace"},
    {"ops": ["KVStore", "set", "begin", "set", "crash", "recover", "get", "count", "count"], "args": [[], ["a", 1], [], ["a", 2], [], [], ["a"], [2], [1]], "expected": [null, null, null, null, null, 1, 1, 0, 1], "label": "an open transaction's overwrite is lost"},
    {"ops": ["KVStore", "begin", "begin", "set", "commit", "rollback", "crash", "recover", "get"], "args": [[], [], [], ["a", 1], [], [], [], [], ["a"]], "expected": [null, null, null, null, true, true, null, 0, null], "label": "inner commit inside a rolled-back transaction"},
    {"ops": ["KVStore", "begin", "set", "begin", "set", "rollback", "commit", "crash", "recover", "get", "get"], "args": [[], [], ["a", 1], [], ["b", 2], [], [], [], [], ["a"], ["b"]], "expected": [null, null, null, null, null, true, true, null, 1, 1, null], "label": "inner rollback inside a committed transaction"},
    {"ops": ["KVStore", "begin", "set", "delete", "commit", "crash", "recover", "get", "count"], "args": [[], [], ["t", 3], ["t"], [], [], [], ["t"], [3]], "expected": [null, null, null, true, true, null, 0, null, 0], "label": "set, then delete, in one transaction"},
    {"ops": ["KVStore", "set", "begin", "delete", "set", "commit", "crash", "recover", "get", "count"], "args": [[], ["a", 1], [], ["a"], ["a", 7], [], [], [], ["a"], [1]], "expected": [null, null, null, true, null, true, null, 1, 7, 0], "label": "delete, then set again, in one transaction"},
    {"ops": ["KVStore", "set", "set", "set", "crash", "recover", "get", "count", "count"], "args": [[], ["a", 1], ["a", 2], ["a", 3], [], [], ["a"], [1], [3]], "expected": [null, null, null, null, null, 1, 3, 0, 1], "label": "a key's last write wins"},
    {"ops": ["KVStore", "set", "crash", "recover", "set", "crash", "recover", "get", "get"], "args": [[], ["a", 1], [], [], ["b", 2], [], [], ["a"], ["b"]], "expected": [null, null, null, 1, null, null, 2, 1, 2], "label": "two crashes"},
    {"ops": ["KVStore", "begin", "set", "crash", "recover", "rollback", "commit"], "args": [[], [], ["a", 1], [], [], [], []], "expected": [null, null, null, null, 0, false, false], "label": "no transaction is open after recovery"},
    {"ops": ["KVStore", "set", "crash", "recover", "begin", "set", "rollback", "get", "begin", "set", "commit", "crash", "recover", "get"], "args": [[], ["a", 1], [], [], [], ["a", 2], [], ["a"], [], ["a", 3], [], [], [], ["a"]], "expected": [null, null, null, 1, null, null, true, 1, null, null, true, null, 1, 3], "label": "transactions work after recovery"},
    {"ops": ["KVStore", "set", "set", "crash", "recover", "begin", "set", "delete", "set", "crash", "recover", "get", "get", "get", "count", "count"], "args": [[], ["a", 1], ["b", 1], [], [], [], ["a", 2], ["b"], ["c", 2], [], [], ["a"], ["b"], ["c"], [1], [2]], "expected": [null, null, null, null, 2, null, null, true, null, null, 2, 1, 1, null, 2, 0], "label": "a transaction opened after recovery is lost too"},
    {"ops": ["KVStore", "set", "set", "crash", "recover", "count", "set", "crash", "recover", "count"], "args": [[], ["a", 1], ["b", 1], [], [], [1], ["c", 1], [], [], [1]], "expected": [null, null, null, null, 2, 2, null, null, 3, 3], "label": "counts are rebuilt, not added to"},
    {"ops": ["KVStore", "begin", "set", "begin", "set", "commit", "begin", "set", "crash", "recover", "get", "get", "get", "count"], "args": [[], [], ["a", 1], [], ["b", 2], [], [], ["c", 3], [], [], ["a"], ["b"], ["c"], [2]], "expected": [null, null, null, null, null, true, null, null, null, 0, null, null, null, 0], "label": "crash three levels deep"},
    {"ops": ["KVStore", "begin", "set", "begin", "set", "commit", "begin", "set", "rollback", "commit", "crash", "recover", "get", "get", "get"], "args": [[], [], ["a", 1], [], ["b", 2], [], [], ["c", 3], [], [], [], [], ["a"], ["b"], ["c"]], "expected": [null, null, null, null, null, true, null, null, true, true, null, 2, 1, 2, null], "label": "outermost commit after mixed inner commits and rollbacks"},
    {"ops": ["KVStore", "set", "set", "begin", "delete", "commit", "crash", "recover", "get", "get", "count"], "args": [[], ["a", 1], ["b", 2], [], ["a"], [], [], [], ["a"], ["b"], [1]], "expected": [null, null, null, null, true, true, null, 1, null, 2, 0], "label": "a committed transaction's delete survives"},
    {"ops": ["KVStore", "set", "begin", "set", "rollback", "set", "crash", "recover", "get", "count"], "args": [[], ["a", 5], [], ["a", 1], [], ["a", 2], [], [], ["a"], [5]], "expected": [null, null, null, null, true, null, null, 1, 2, 0], "label": "a change after a rolled-back transaction"},
    {"ops": ["KVStore", "begin", "begin", "set", "crash", "recover", "set", "crash", "recover", "begin", "begin", "commit", "get", "set", "begin", "get", "set", "set", "commit", "commit", "delete", "begin", "begin", "commit", "begin", "commit", "count", "begin", "get", "delete", "commit", "set", "set", "begin", "set", "set", "crash", "recover", "crash", "recover", "count", "count", "begin", "commit", "delete", "get", "delete", "begin", "commit", "set", "delete", "rollback", "count", "commit", "commit", "commit", "begin", "delete", "rollback", "set", "delete"], "args": [[], [], [], ["a", 1], [], [], ["b", 1], [], [], [], [], [], ["e"], ["e", 0], [], ["d"], ["b", 2], ["e", 1], [], [], ["e"], [], [], [], [], [], [3], [], ["d"], ["b"], [], ["c", 1], ["b", 3], [], ["c", 3], ["c", 1], [], [], [], [], [2], [2], [], [], ["a"], ["c"], ["b"], [], [], ["d", 0], ["a"], [], [0], [], [], [], [], ["e"], [], ["e", 3], ["a"]], "expected": [null, null, null, null, null, 0, null, null, 1, null, null, true, null, null, null, null, null, null, true, true, true, null, null, true, null, true, 0, null, null, true, true, null, null, null, null, null, null, 1, null, 1, 1, 1, null, true, false, null, true, null, true, null, false, false, 1, false, false, false, null, false, true, null, false], "label": "random 1"},
    {"ops": ["KVStore", "begin", "commit", "set", "begin", "begin", "set", "set", "delete", "get", "set", "count", "set", "begin", "set", "begin", "begin", "begin", "set", "set", "set", "get", "rollback", "rollback", "begin", "get", "set", "begin", "commit", "commit", "crash", "recover", "count", "get", "set", "begin", "delete", "begin", "crash", "recover", "get", "set", "set", "commit", "set", "count", "delete", "delete", "delete", "set", "delete", "count", "get", "crash", "recover", "set", "set", "begin", "get", "begin", "get"], "args": [[], [], [], ["b", 3], [], [], ["c", 0], ["d", 2], ["e"], ["b"], ["d", 1], [1], ["c", 0], [], ["b", 3], [], [], [], ["b", 3], ["d", 1], ["c", 0], ["e"], [], [], [], ["c"], ["a", 3], [], [], [], [], [], [1], ["a"], ["b", 3], [], ["d"], [], [], [], ["c"], ["b", 2], ["e", 1], [], ["c", 1], [1], ["c"], ["b"], ["a"], ["a", 0], ["b"], [2], ["d"], [], [], ["a", 2], ["c", 2], [], ["b"], [], ["c"]], "expected": [null, null, true, null, null, null, null, null, false, 3, null, 1, null, null, null, null, null, null, null, null, null, null, true, true, null, 0, null, null, true, true, null, 1, 0, null, null, null, false, null, null, 1, null, null, null, false, null, 2, true, true, false, null, false, 0, null, null, 2, null, null, null, null, null, 2], "label": "random 2"},
    {"ops": ["KVStore", "delete", "count", "set", "crash", "recover", "crash", "recover", "crash", "recover", "set", "set", "set", "count", "count", "crash", "recover", "set", "count", "rollback", "commit", "count", "begin", "set", "set", "set", "get", "set", "begin", "begin", "count", "begin", "rollback", "commit", "commit", "delete", "delete", "delete", "count", "set", "set", "get", "begin", "set", "count", "get", "begin", "begin", "delete", "set", "rollback", "count", "set", "count", "commit", "set", "get", "count", "set", "count", "commit"], "args": [[], ["b"], [2], ["e", 1], [], [], [], [], [], [], ["e", 3], ["a", 2], ["e", 3], [3], [2], [], [], ["b", 0], [2], [], [], [2], [], ["b", 2], ["c", 2], ["d", 1], ["a"], ["e", 0], [], [], [0], [], [], [], [], ["d"], ["c"], ["d"], [2], ["a", 3], ["c", 0], ["b"], [], ["d", 2], [1], ["d"], [], [], ["c"], ["d", 3], [], [3], ["d", 2], [2], [], ["c", 1], ["c"], [3], ["c", 0], [0], []], "expected": [null, false, 0, null, null, 1, null, 1, null, 1, null, null, null, 1, 1, null, 2, null, 1, false, false, 1, null, null, null, null, 2, null, null, null, 1, null, true, true, true, true, true, false, 2, null, null, 2, null, null, 0, 2, null, null, true, null, true, 1, null, 2, true, null, 1, 1, null, 2, true], "label": "random 3"},
    {"argsPy": "r = rng(303)\nops, xs = [\"KVStore\"], [[]]\nkeys = [\"k\" + str(i) for i in range(20000)]\nfor k in keys:\n    ops.append(\"set\"); xs.append([k, r.randint(0, 999)])\ndef change():\n    if r.random() < 0.8:\n        ops.append(\"set\"); xs.append([r.choice(keys), r.randint(0, 999)])\n    else:\n        ops.append(\"delete\"); xs.append([r.choice(keys)])\n\nsteps = [\"tx\"] * 10000 + [\"auto\"] * 4000\nr.shuffle(steps)\nfor i, step in enumerate(steps):\n    if i % 1750 == 874:\n        ops += [\"crash\", \"recover\"]; xs += [[], []]\n    if step == \"auto\":\n        change()\n        continue\n    ops.append(\"begin\"); xs.append([])\n    for _ in range(r.randint(1, 3)):\n        change()\n    if r.random() < 0.15:\n        ops.append(\"count\"); xs.append([r.randint(0, 999)])\n    ops.append(\"commit\" if r.random() < 0.75 else \"rollback\"); xs.append([])\nops += [\"crash\", \"recover\"]; xs += [[], []]\nfor v in range(10):\n    ops.append(\"count\"); xs.append([v])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 20,000 keys, then 10,000 transactions and 9 crashes", "perf": true},
