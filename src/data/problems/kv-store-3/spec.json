    {"ops": ["KVStore", "begin", "set", "begin", "set", "begin", "set", "commit", "commit", "get", "rollback", "get", "get", "get", "count"], "args": [[], [], ["a", 1], [], ["b", 2], [], ["c", 3], [], [], ["c"], [], ["a"], ["b"], ["c"], [3]], "expected": [null, null, null, null, null, null, null, true, true, 3, true, null, null, null, 0], "label": "step 2: inner commits, then the outer transaction rolls back"},
    {"ops": ["KVStore", "begin", "set", "begin", "set", "set", "rollback", "get", "get", "commit", "get", "count"], "args": [[], [], ["a", 1], [], ["a", 2], ["b", 2], [], ["a"], ["b"], [], ["a"], [2]], "expected": [null, null, null, null, null, null, true, 1, null, true, 1, 0], "label": "step 2: inner rollback keeps the outer transaction's changes"},
