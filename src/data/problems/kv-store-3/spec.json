    {"ops": ["KVStore", "set", "set", "begin", "delete", "count", "rollback", "get", "count"], "args": [[], ["a", 1], ["b", 1], [], ["a"], [1], [], ["a"], [1]], "expected": [null, null, null, null, true, 1, true, 1, 2], "label": "step 2: rollback brings back a deleted key and its count"},
