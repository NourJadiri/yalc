{
  "id": "rate-limiter-4",
  "title": "Rate Limiter: Plans and Monthly Quotas",
  "difficulty": "M",
  "topics": ["design", "hash map", "math", "rate limiting"],
  "kind": "design",
  "className": "RateLimiter",
  "starter": "class RateLimiter:\n\n    def __init__(self, capacity: int, interval: int):\n        pass\n\n    def add_limit(self, capacity: int, interval: int) -> None:\n        pass\n\n    def allow(self, client: str, t: int, cost: int = 1) -> bool:\n        pass\n\n    def set_concurrency(self, slots: int, timeout: int) -> None:\n        pass\n\n    def start(self, client: str, t: int, request_id: str, cost: int = 1) -> bool:\n        pass\n\n    def finish(self, request_id: str, t: int) -> bool:\n        pass\n\n    def add_plan(self, name: str, quota: int, period: int) -> None:\n        pass\n\n    def subscribe(self, client: str, plan: str, t: int) -> bool:\n        pass\n\n    def remaining(self, client: str, t: int) -> int:\n        pass\n",
  "tests": [
    {"ops": ["RateLimiter", "add_plan", "remaining", "subscribe", "allow", "remaining", "allow", "allow", "remaining", "remaining"], "args": [[1000, 1], ["basic", 100, 1000], ["ann", 0], ["ann", "basic", 0], ["ann", 10, 60], ["ann", 20], ["ann", 30, 50], ["ann", 40, 40], ["ann", 999], ["ann", 1000]], "expected": [null, null, -1, true, true, 40, false, true, 0, 100], "show": true},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "allow", "allow", "allow", "allow", "allow", "remaining"], "args": [[1000, 1], ["pro", 50, 100], ["bo", "pro", 30], ["bo", 30, 50], ["bo", 129, 1], ["bo", 180, 50], ["bo", 229, 1], ["bo", 230, 1], ["bo", 230]], "expected": [null, null, true, true, false, true, false, true, 49], "show": true},
    {"ops": ["RateLimiter", "add_plan", "add_plan", "subscribe", "subscribe", "allow", "remaining", "allow", "subscribe", "remaining", "subscribe", "remaining"], "args": [[10, 100], ["trial", 30, 1000000], ["plus", 100, 1000000], ["cy", "gold", 0], ["cy", "trial", 0], ["cy", 0, 20], ["cy", 0], ["cy", 0, 10], ["cy", "gold", 500], ["cy", 500], ["cy", "plus", 500], ["cy", 500]], "expected": [null, null, null, false, true, false, 30, true, false, 20, true, 100], "show": true},
    {"ops": ["RateLimiter", "add_plan", "allow", "remaining", "allow", "remaining"], "args": [[10000, 1], ["p", 5, 100], ["a", 0, 100], ["a", 0], ["a", 0, 100], ["nobody", 5]], "expected": [null, null, true, -1, true, -1], "label": "no plan: no quota, and remaining is -1"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "allow", "allow", "remaining", "allow", "remaining"], "args": [[1000, 1], ["p", 10, 1000], ["a", "p", 0], ["a", 1, 7], ["a", 2, 3], ["a", 3], ["a", 4], ["a", 999]], "expected": [null, null, true, true, true, 0, false, 0], "label": "a request for exactly what is left"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "allow", "remaining", "allow", "allow", "remaining"], "args": [[1000, 1], ["p", 5, 100], ["a", "p", 0], ["a", 0, 6], ["a", 0], ["a", 500, 6], ["a", 500, 5], ["a", 500]], "expected": [null, null, true, false, 5, false, true, 0], "label": "a cost above the quota never passes"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "allow", "allow", "allow", "allow", "remaining", "allow", "allow"], "args": [[1000, 1], ["p", 10, 100], ["a", "p", 0], ["a", 250, 10], ["a", 299, 1], ["a", 300, 10], ["a", 399, 1], ["a", 400], ["a", 950, 4], ["a", 1000, 10]], "expected": [null, null, true, true, false, true, false, 10, true, true], "label": "idle for whole periods, boundaries stay put"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "allow", "remaining", "allow", "remaining", "allow"], "args": [[1000, 1], ["p", 3, 100], ["a", "p", 5], ["a", 5, 3], ["a", 104], ["a", 104, 1], ["a", 105], ["a", 105, 3]], "expected": [null, null, true, true, 0, false, 3, true], "label": "the boundary itself starts a new period"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "allow", "subscribe", "remaining", "allow", "allow", "remaining", "allow", "remaining"], "args": [[1000, 1], ["p", 10, 100], ["a", "p", 0], ["a", 50, 10], ["a", "p", 60], ["a", 60], ["a", 60, 10], ["a", 120, 1], ["a", 159], ["a", 160, 1], ["a", 160]], "expected": [null, null, true, true, true, 10, true, false, 0, true, 9], "label": "subscribing again starts over and moves the boundaries"},
    {"ops": ["RateLimiter", "add_plan", "add_plan", "subscribe", "allow", "subscribe", "remaining", "allow", "allow", "remaining", "allow", "allow", "remaining", "subscribe", "remaining", "allow"], "args": [[1000, 1], ["small", 10, 100], ["big", 50, 1000], ["a", "small", 0], ["a", 0, 8], ["a", "big", 40], ["a", 40], ["a", 40, 45], ["a", 140, 10], ["a", 140], ["a", 1500, 50], ["a", 2100, 50], ["a", 2100], ["a", "small", 2200], ["a", 2200], ["a", 2200, 20]], "expected": [null, null, null, true, true, true, 50, true, false, 5, true, true, 0, true, 10, false], "label": "switching plans changes the quota and the period"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "remaining", "allow", "subscribe", "allow", "subscribe", "remaining", "allow"], "args": [[1000, 1], ["p", 5, 100], ["a", "nope", 0], ["a", 0], ["a", 0, 50], ["a", "p", 1], ["a", 1, 3], ["a", "nope", 2], ["a", 2], ["a", 2, 3]], "expected": [null, null, false, -1, true, true, true, false, 2, false], "label": "an unknown plan changes nothing"},
    {"ops": ["RateLimiter", "add_plan", "add_plan", "subscribe", "allow", "allow", "allow", "subscribe", "allow", "allow", "remaining"], "args": [[5, 1000], ["small", 3, 1000000000], ["big", 100, 1000000000], ["a", "small", 0], ["a", 0, 4], ["a", 0, 3], ["a", 0, 2], ["a", "big", 0], ["a", 0, 2], ["a", 0, 1], ["a", 0]], "expected": [null, null, null, true, false, true, false, true, true, false, 98], "label": "a quota refusal takes no tokens"},
    {"ops": ["RateLimiter", "add_limit", "add_plan", "subscribe", "allow", "allow", "remaining", "allow", "allow", "remaining"], "args": [[4, 100], [10, 10], ["p", 10, 1000000], ["a", "p", 0], ["a", 0, 5], ["a", 0, 4], ["a", 0], ["a", 100, 2], ["a", 400, 4], ["a", 400]], "expected": [null, null, null, true, false, true, 6, false, true, 2], "label": "a token refusal uses no quota"},
    {"ops": ["RateLimiter", "set_concurrency", "add_plan", "subscribe", "start", "start", "remaining", "finish", "remaining", "start", "remaining", "start"], "args": [[1000, 1], [1, 1000], ["p", 10, 1000000], ["a", "p", 0], ["a", 0, "s1", 5], ["a", 0, "s2", 5], ["a", 0], ["s1", 10], ["a", 10], ["a", 10, "s3", 5], ["a", 10], ["a", 20, "s4", 1]], "expected": [null, null, null, true, true, false, 5, true, 5, true, 0, false], "label": "a start refused for a slot uses no quota"},
    {"ops": ["RateLimiter", "set_concurrency", "add_plan", "subscribe", "start", "start", "finish", "remaining", "remaining", "finish", "allow", "allow"], "args": [[1000, 1], [2, 100], ["p", 10, 1000000], ["a", "p", 0], ["a", 0, "s1", 4], ["a", 0, "s2", 4], ["s1", 10], ["a", 10], ["a", 150], ["s2", 150], ["a", 150, 3], ["a", 150, 2]], "expected": [null, null, null, true, true, true, true, 2, 2, false, false, true], "label": "finished and timed-out streams give nothing back"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "subscribe", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "remaining", "remaining"], "args": [[1000, 1], ["p", 10, 100], ["a", "p", 0], ["b", "p", 50], ["a", 60, 10], ["b", 60, 10], ["a", 130, 10], ["b", 130, 1], ["b", 150, 10], ["a", 210, 10], ["b", 210, 1], ["a", 210], ["b", 250]], "expected": [null, null, true, true, true, true, true, false, true, true, false, 0, 10], "label": "every client keeps its own periods"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "allow", "allow", "remaining", "remaining", "allow", "allow", "remaining"], "args": [[1000, 1], ["milli", 2, 1], ["a", "milli", 0], ["a", 0, 2], ["a", 0, 1], ["a", 0], ["a", 999999999], ["a", 1000000000, 2], ["a", 1000000000, 1], ["a", 1000000000]], "expected": [null, null, true, true, false, 0, 2, true, false, 0], "label": "a 1 ms period after a gap of 10^9 periods"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "allow", "allow", "remaining", "remaining"], "args": [[100000, 1], ["max", 1000000000, 1000000000], ["a", "max", 0], ["a", 0, 10000], ["a", 1000000, 10000], ["a", 999999999], ["a", 1000000000]], "expected": [null, null, true, true, true, 999980000, 1000000000], "label": "largest quota and period"},
    {"ops": ["RateLimiter", "add_plan", "subscribe", "remaining", "allow", "remaining", "allow", "allow", "remaining", "allow"], "args": [[3, 10], ["p", 7, 1000], ["z", "p", 100], ["z", 100], ["z", 2000, 3], ["z", 2000], ["z", 2000, 1], ["z", 2030, 3], ["z", 2030], ["z", 2060, 3]], "expected": [null, null, true, 7, true, 4, false, true, 1, false], "label": "subscribed before the first request"},
    {"ops": ["RateLimiter", "add_plan", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "subscribe", "allow", "allow", "remaining", "allow", "subscribe", "allow", "remaining", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "remaining", "subscribe", "allow", "subscribe", "allow", "allow", "allow", "allow", "remaining", "remaining", "allow", "allow", "allow", "remaining", "allow", "subscribe", "subscribe", "allow", "allow", "remaining", "remaining", "allow", "subscribe", "allow"], "args": [[6, 10], ["p0", 9, 27], ["b", 7, 2], ["b", 7, 2], ["a", 8], ["b", 8, 2], ["b", 11], ["b", 11], ["a", 20, 2], ["a", "p0", 27], ["b", 27, 1], ["a", 27], ["a", 36], ["b", 44, 4], ["a", "p0", 44], ["b", 50], ["b", 50], ["a", 58, 3], ["a", 66, 2], ["b", 69, 4], ["b", 75, 2], ["b", 79, 3], ["a", 86, 3], ["b", 90, 4], ["a", 96, 2], ["b", 105, 4], ["a", 105], ["b", 105, 4], ["b", 109], ["a", "p0", 112], ["b", 120], ["a", "p0", 120], ["b", 125, 3], ["b", 133], ["a", 133, 1], ["b", 142, 3], ["a", 143], ["b", 143], ["b", 149, 2], ["b", 149], ["a", 150, 3], ["b", 150], ["b", 150, 4], ["a", "zz", 158], ["b", "p0", 159], ["b", 159, 4], ["a", 159, 3], ["a", 159], ["a", 159], ["a", 159, 2], ["a", "zz", 159], ["a", 159]], "expected": [null, null, true, true, true, true, false, false, true, true, true, true, 8, false, true, true, -1, true, true, true, false, false, true, false, false, false, true, false, -1, true, true, true, true, true, true, false, 8, -1, true, true, true, -1, false, false, true, false, true, 3, 3, false, false, false], "label": "random 1"},
    {"ops": ["RateLimiter", "add_plan", "add_plan", "allow", "allow", "allow", "allow", "allow", "allow", "remaining", "allow", "allow", "allow", "allow", "subscribe", "remaining", "allow", "subscribe", "allow", "allow", "allow", "allow", "subscribe", "allow", "allow", "allow", "allow", "allow", "allow", "remaining", "subscribe", "remaining", "remaining", "allow", "allow", "allow", "allow", "allow", "subscribe", "allow", "allow", "remaining", "allow", "allow", "allow", "allow", "remaining", "allow", "allow", "allow", "allow", "remaining", "allow"], "args": [[8, 10], ["p0", 10, 66], ["p1", 4, 16], ["a", 3, 4], ["b", 3], ["b", 3, 1], ["b", 4, 1], ["a", 5], ["b", 5], ["b", 5], ["a", 5, 1], ["b", 8], ["b", 8], ["b", 8], ["a", "zz", 15], ["b", 21], ["b", 21, 2], ["a", "p1", 21], ["b", 21, 2], ["b", 23, 1], ["a", 32], ["b", 36], ["b", "p0", 43], ["b", 50], ["b", 50, 2], ["a", 54, 4], ["b", 60], ["a", 60], ["a", 69, 1], ["b", 75], ["a", "zz", 75], ["b", 75], ["a", 75], ["a", 75, 2], ["b", 80, 3], ["b", 84, 1], ["b", 92, 2], ["b", 97], ["b", "p0", 97], ["b", 97, 4], ["a", 97, 4], ["a", 98], ["a", 98, 3], ["a", 98, 2], ["b", 98, 2], ["b", 98, 2], ["a", 98], ["a", 99, 2], ["a", 99], ["b", 99, 2], ["b", 99, 2], ["a", 101], ["b", 105]], "expected": [null, null, null, true, true, true, true, true, true, -1, true, true, true, true, false, -1, true, true, false, true, true, true, true, true, false, true, true, false, true, 8, false, 8, 3, true, false, true, true, true, true, false, false, 4, true, false, false, false, 1, false, false, false, false, 4, true], "label": "random 2"},
    {"ops": ["RateLimiter", "set_concurrency", "add_plan", "add_plan", "allow", "allow", "allow", "remaining", "start", "allow", "start", "allow", "start", "start", "finish", "allow", "finish", "allow", "finish", "start", "finish", "allow", "start", "start", "allow", "subscribe", "remaining", "start", "finish", "remaining", "finish", "subscribe", "finish", "allow", "remaining", "subscribe", "allow", "remaining", "start", "remaining", "subscribe", "finish", "allow", "remaining", "allow", "start", "allow", "finish", "allow", "allow", "allow", "start", "finish", "remaining"], "args": [[8, 2], [2, 42], ["p0", 13, 58], ["p1", 15, 66], ["b", 6], ["b", 15, 3], ["a", 15, 2], ["a", 16], ["b", 19, "r0"], ["a", 26], ["b", 28, "r1"], ["b", 36], ["a", 36, "r2", 3], ["b", 39, "r3"], ["r2", 47], ["a", 51], ["r0", 51], ["a", 51], ["r3", 51], ["b", 51, "r4"], ["r0", 51], ["b", 51], ["b", 51, "r5"], ["b", 51, "r6", 1], ["b", 51], ["a", "p1", 51], ["b", 60], ["a", 65, "r7", 4], ["r3", 68], ["a", 68], ["r2", 68], ["a", "p0", 68], ["r6", 68], ["a", 68, 4], ["a", 68], ["b", "p0", 68], ["b", 71], ["b", 74], ["a", 83, "r8", 4], ["b", 83], ["a", "p1", 89], ["r5", 96], ["b", 103, 3], ["a", 103], ["b", 103], ["b", 106, "r9", 3], ["a", 110, 1], ["r6", 110], ["b", 117, 3], ["a", 120, 4], ["a", 120, 3], ["b", 129, "r10", 3], ["r6", 129], ["a", 129]], "expected": [null, null, null, null, true, true, true, -1, true, true, true, false, true, false, true, true, true, true, false, true, false, false, false, false, false, true, -1, true, false, 11, false, true, false, true, 9, true, true, 12, true, 12, true, false, true, 15, true, true, true, false, true, true, true, true, false, 7], "label": "random, with streams"},
    {"argsPy": "r = rng(606)\nops = ['RateLimiter', 'add_plan', 'subscribe']\nxs = [[100000, 1], ['bulk', 150000, 340000], ['solo', 'bulk', 0]]\nt = 0\nfor _ in range(49997):\n    t += r.randint(0, 40)\n    if r.random() < 0.1:\n        ops.append('remaining'); xs.append(['solo', t])\n    else:\n        ops.append('allow'); xs.append(['solo', t, r.randint(1, 20)])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: 50,000 requests against one quota", "perf": true},
    {"argsPy": "r = rng(707)\nops = ['RateLimiter', 'add_limit', 'add_plan', 'add_plan', 'add_plan']\nxs = [[100000, 1], [20000, 5], ['free', 2000, 7], ['team', 50000, 1000], ['max', 1000000000, 1000000000]]\nt = 0\nfor _ in range(49995):\n    t += r.randint(0, 36000)\n    c = 'c' + str(r.randint(1, 10000))\n    x = r.random()\n    if x < 0.08:\n        ops.append('subscribe'); xs.append([c, r.choice(['free', 'team', 'max', 'gold']), t])\n    elif x < 0.25:\n        ops.append('remaining'); xs.append([c, t])\n    else:\n        ops.append('allow'); xs.append([c, t, r.randint(1, 3000)])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: 10,000 clients on plans with short periods", "perf": true},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "start", "allow", "allow", "finish", "start", "finish", "finish"], "args": [[100, 10], [2, 1000], ["a", 0, "r1"], ["a", 5, "r2"], ["a", 6, "r3"], ["a", 7], ["b", 7], ["r1", 20], ["a", 20, "r4"], ["r3", 30], ["r1", 30]], "expected": [null, null, true, true, false, false, true, true, true, false, false], "label": "step 3: example 1"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "allow", "allow", "finish", "start", "start"], "args": [[100, 10], [1, 100], ["a", 0, "s1"], ["a", 50], ["a", 100], ["s1", 120], ["a", 130, "s2"], ["a", 131, "s3"]], "expected": [null, null, true, false, true, false, true, false], "label": "step 3: example 2"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "start", "finish", "finish", "start", "start"], "args": [[5, 100], [2, 10000], ["a", 0, "x", 4], ["a", 0, "y", 2], ["a", 0, "z", 1], ["y", 1], ["x", 1], ["a", 1, "w", 1], ["a", 100, "v", 1]], "expected": [null, null, true, false, true, false, true, false, true], "label": "step 3: example 3"},
    {"ops": ["RateLimiter", "start", "start", "start", "start", "allow", "finish", "finish", "finish", "finish"], "args": [[3, 100], ["a", 0, "r1"], ["a", 0, "r2"], ["a", 0, "r3"], ["a", 0, "r4"], ["a", 0], ["r2", 1000000000], ["r2", 1000000000], ["r4", 1000000000], ["r1", 1000000000]], "expected": [null, true, true, true, false, false, true, false, false, true], "label": "step 3: without set_concurrency, start needs only tokens"},
    {"ops": ["RateLimiter", "set_concurrency", "finish", "start", "finish", "finish", "finish"], "args": [[5, 10], [1, 10], ["ghost", 0], ["a", 0, "real"], ["ghost", 1], ["real", 2], ["real", 3]], "expected": [null, null, false, true, false, true, false], "label": "step 3: finishing an id nobody started"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "finish", "start", "finish", "finish"], "args": [[5, 10], [1, 100], ["a", 0, "s"], ["s", 99], ["a", 99, "s2"], ["s2", 198], ["s2", 199]], "expected": [null, null, true, true, true, true, false], "label": "step 3: finished one millisecond before the deadline"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "finish", "start", "start"], "args": [[5, 10], [1, 100], ["a", 0, "s"], ["s", 100], ["a", 100, "s2"], ["a", 100, "s3"]], "expected": [null, null, true, false, true, false], "label": "step 3: finishing at the deadline is too late"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "allow", "allow", "start", "start"], "args": [[5, 10], [1, 50], ["a", 10, "s1"], ["a", 59, "s2"], ["a", 59], ["a", 60], ["a", 60, "s3"], ["a", 60, "s4"]], "expected": [null, null, true, false, false, true, true, false], "label": "step 3: the slot is free exactly at the deadline"},
    {"ops": ["RateLimiter", "set_concurrency", "allow", "allow", "allow", "start", "allow", "finish", "allow"], "args": [[10, 10], [1, 1000], ["a", 0], ["a", 0], ["a", 0], ["a", 0, "x"], ["a", 0], ["x", 1], ["a", 1]], "expected": [null, null, true, true, true, true, false, true, true], "label": "step 3: allow holds a slot only for an instant"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "start", "start", "finish", "start", "start"], "args": [[5, 10], [1, 1000], ["a", 0, "a1"], ["b", 0, "b1"], ["a", 0, "a2"], ["b", 0, "b2"], ["a1", 5], ["b", 5, "b3"], ["a", 5, "a3"]], "expected": [null, null, true, true, false, false, true, false, true], "label": "step 3: slots are per client"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "finish", "start", "finish", "allow", "allow"], "args": [[2, 1000], [1, 1000000], ["a", 0, "x"], ["a", 0, "y"], ["x", 1], ["a", 1, "z"], ["z", 3], ["a", 3], ["a", 1001]], "expected": [null, null, true, false, true, true, true, false, true], "label": "step 3: a start refused for a slot keeps its tokens"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "finish", "finish", "start"], "args": [[3, 1000], [1, 1000000], ["a", 0, "big", 5], ["a", 0, "small", 1], ["big", 1], ["small", 1], ["a", 1, "next", 2]], "expected": [null, null, false, true, false, true, true], "label": "step 3: a start refused for tokens holds no slot"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "allow", "finish", "finish", "start", "start", "start"], "args": [[10, 10], [2, 100], ["a", 0, "p"], ["a", 0, "q"], ["a", 150], ["p", 160], ["q", 170], ["a", 180, "r"], ["a", 180, "s"], ["a", 180, "u"]], "expected": [null, null, true, true, true, false, false, true, true, false], "label": "step 3: timed out, then finished: no slot comes back twice"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "finish", "start", "start", "allow"], "args": [[10, 10], [1, 100], ["a", 0, "p"], ["p", 500], ["a", 500, "q"], ["a", 500, "r"], ["a", 500]], "expected": [null, null, true, false, true, false, false], "label": "step 3: the timeout is noticed by finish itself"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "finish", "start", "allow", "allow", "allow", "finish"], "args": [[10, 10], [1, 100], ["a", 0, "p"], ["p", 10], ["a", 20, "q"], ["a", 100], ["a", 119], ["a", 120], ["q", 120]], "expected": [null, null, true, true, true, false, false, true, false], "label": "step 3: finished early, its deadline passes later"},
