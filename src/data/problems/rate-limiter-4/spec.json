    {"argsPy": "r = rng(404)\nops = ['RateLimiter', 'set_concurrency']\nxs = [[100000, 1], [10000, 1000000000]]\nfor i in range(10000):\n    ops.append('start'); xs.append(['big', i, 'r' + str(i)])\nt, nxt = 10000, 10000\nfor _ in range(40000):\n    t += r.randint(0, 3)\n    x = r.random()\n    if x < 0.4:\n        ops.append('finish'); xs.append(['r' + str(r.randint(0, nxt - 1)), t])\n    elif x < 0.8:\n        ops.append('start'); xs.append(['big', t, 'r' + str(nxt)]); nxt += 1\n    else:\n        ops.append('allow'); xs.append(['big', t])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "step 3: large: one client keeps 10,000 streams open", "perf": true},
    {"argsPy": "r = rng(505)\nops = ['RateLimiter', 'add_limit', 'set_concurrency']\nxs = [[100000, 1], [50000, 2], [10000, 30000]]\nt, nxt, ids = 0, 0, []\nfor _ in range(49997):\n    t += r.randint(0, 2)\n    c = 'hot' if r.random() < 0.8 else 'c' + str(r.randint(1, 1000))\n    x = r.random()\n    if x < 0.6:\n        rid = 'q' + str(nxt); nxt += 1; ids.append(rid)\n        ops.append('start'); xs.append([c, t, rid, r.randint(1, 3)])\n    elif x < 0.85:\n        ops.append('finish'); xs.append([ids[r.randint(max(0, len(ids) - 20000), len(ids) - 1)], t])\n    else:\n        ops.append('allow'); xs.append([c, t, r.randint(1, 3)])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "step 3: large: 50,000 calls with streams timing out", "perf": true},
