{
  "id": "rate-limiter-3",
  "title": "Rate Limiter: Concurrency Slots",
  "difficulty": "H",
  "topics": ["design", "queue", "hash set", "rate limiting"],
  "kind": "design",
  "className": "RateLimiter",
  "starter": "class RateLimiter:\n\n    def __init__(self, capacity: int, interval: int):\n        pass\n\n    def add_limit(self, capacity: int, interval: int) -> None:\n        pass\n\n    def allow(self, client: str, t: int, cost: int = 1) -> bool:\n        pass\n\n    def set_concurrency(self, slots: int, timeout: int) -> None:\n        pass\n\n    def start(self, client: str, t: int, request_id: str, cost: int = 1) -> bool:\n        pass\n\n    def finish(self, request_id: str, t: int) -> bool:\n        pass\n",
  "tests": [
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "start", "allow", "allow", "finish", "start", "finish", "finish"], "args": [[100, 10], [2, 1000], ["a", 0, "r1"], ["a", 5, "r2"], ["a", 6, "r3"], ["a", 7], ["b", 7], ["r1", 20], ["a", 20, "r4"], ["r3", 30], ["r1", 30]], "expected": [null, null, true, true, false, false, true, true, true, false, false], "show": true},
    {"ops": ["RateLimiter", "set_concurrency", "start", "allow", "allow", "finish", "start", "start"], "args": [[100, 10], [1, 100], ["a", 0, "s1"], ["a", 50], ["a", 100], ["s1", 120], ["a", 130, "s2"], ["a", 131, "s3"]], "expected": [null, null, true, false, true, false, true, false], "show": true},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "start", "finish", "finish", "start", "start"], "args": [[5, 100], [2, 10000], ["a", 0, "x", 4], ["a", 0, "y", 2], ["a", 0, "z", 1], ["y", 1], ["x", 1], ["a", 1, "w", 1], ["a", 100, "v", 1]], "expected": [null, null, true, false, true, false, true, false, true], "show": true},
    {"ops": ["RateLimiter", "start", "start", "start", "start", "allow", "finish", "finish", "finish", "finish"], "args": [[3, 100], ["a", 0, "r1"], ["a", 0, "r2"], ["a", 0, "r3"], ["a", 0, "r4"], ["a", 0], ["r2", 1000000000], ["r2", 1000000000], ["r4", 1000000000], ["r1", 1000000000]], "expected": [null, true, true, true, false, false, true, false, false, true], "label": "without set_concurrency, start needs only tokens"},
    {"ops": ["RateLimiter", "set_concurrency", "finish", "start", "finish", "finish", "finish"], "args": [[5, 10], [1, 10], ["ghost", 0], ["a", 0, "real"], ["ghost", 1], ["real", 2], ["real", 3]], "expected": [null, null, false, true, false, true, false], "label": "finishing an id nobody started"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "finish", "start", "finish", "finish"], "args": [[5, 10], [1, 100], ["a", 0, "s"], ["s", 99], ["a", 99, "s2"], ["s2", 198], ["s2", 199]], "expected": [null, null, true, true, true, true, false], "label": "finished one millisecond before the deadline"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "finish", "start", "start"], "args": [[5, 10], [1, 100], ["a", 0, "s"], ["s", 100], ["a", 100, "s2"], ["a", 100, "s3"]], "expected": [null, null, true, false, true, false], "label": "finishing at the deadline is too late"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "allow", "allow", "start", "start"], "args": [[5, 10], [1, 50], ["a", 10, "s1"], ["a", 59, "s2"], ["a", 59], ["a", 60], ["a", 60, "s3"], ["a", 60, "s4"]], "expected": [null, null, true, false, false, true, true, false], "label": "the slot is free exactly at the deadline"},
    {"ops": ["RateLimiter", "set_concurrency", "allow", "allow", "allow", "start", "allow", "finish", "allow"], "args": [[10, 10], [1, 1000], ["a", 0], ["a", 0], ["a", 0], ["a", 0, "x"], ["a", 0], ["x", 1], ["a", 1]], "expected": [null, null, true, true, true, true, false, true, true], "label": "allow holds a slot only for an instant"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "start", "start", "finish", "start", "start"], "args": [[5, 10], [1, 1000], ["a", 0, "a1"], ["b", 0, "b1"], ["a", 0, "a2"], ["b", 0, "b2"], ["a1", 5], ["b", 5, "b3"], ["a", 5, "a3"]], "expected": [null, null, true, true, false, false, true, false, true], "label": "slots are per client"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "finish", "start", "finish", "allow", "allow"], "args": [[2, 1000], [1, 1000000], ["a", 0, "x"], ["a", 0, "y"], ["x", 1], ["a", 1, "z"], ["z", 3], ["a", 3], ["a", 1001]], "expected": [null, null, true, false, true, true, true, false, true], "label": "a start refused for a slot keeps its tokens"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "finish", "finish", "start"], "args": [[3, 1000], [1, 1000000], ["a", 0, "big", 5], ["a", 0, "small", 1], ["big", 1], ["small", 1], ["a", 1, "next", 2]], "expected": [null, null, false, true, false, true, true], "label": "a start refused for tokens holds no slot"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "allow", "finish", "finish", "start", "start", "start"], "args": [[10, 10], [2, 100], ["a", 0, "p"], ["a", 0, "q"], ["a", 150], ["p", 160], ["q", 170], ["a", 180, "r"], ["a", 180, "s"], ["a", 180, "u"]], "expected": [null, null, true, true, true, false, false, true, true, false], "label": "timed out, then finished: no slot comes back twice"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "finish", "start", "start", "allow"], "args": [[10, 10], [1, 100], ["a", 0, "p"], ["p", 500], ["a", 500, "q"], ["a", 500, "r"], ["a", 500]], "expected": [null, null, true, false, true, false, false], "label": "the timeout is noticed by finish itself"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "finish", "start", "allow", "allow", "allow", "finish"], "args": [[10, 10], [1, 100], ["a", 0, "p"], ["p", 10], ["a", 20, "q"], ["a", 100], ["a", 119], ["a", 120], ["q", 120]], "expected": [null, null, true, true, true, false, false, true, false], "label": "finished early, its deadline passes later"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "start", "finish", "start", "start", "finish", "finish", "finish", "start", "start", "start", "start", "finish", "start", "finish", "start", "start", "start", "finish"], "args": [[20, 1], [3, 1000], ["a", 0, "r1"], ["a", 10, "r2"], ["a", 20, "r3"], ["r2", 30], ["a", 40, "r4"], ["a", 50, "r5"], ["r1", 60], ["r3", 70], ["r4", 80], ["a", 90, "r6"], ["a", 90, "r7"], ["a", 90, "r8"], ["a", 90, "r9"], ["r7", 95], ["a", 1089, "r10"], ["r8", 1089], ["a", 1090, "r11"], ["a", 1090, "r12"], ["a", 1090, "r13"], ["r6", 1090]], "expected": [null, null, true, true, true, true, true, false, true, true, true, true, true, true, false, true, true, true, true, true, false, false], "label": "streams finished out of order"},
    {"ops": ["RateLimiter", "add_limit", "set_concurrency", "start", "start", "allow", "start", "start", "start", "finish", "finish", "start", "start"], "args": [[10, 100], [4, 1000], [2, 500], ["a", 0, "s1", 3], ["a", 0, "s2", 2], ["a", 0, 1], ["a", 250, "s3", 1], ["a", 1000, "s4", 1], ["a", 1000, "s5", 1], ["s1", 1000], ["s4", 1001], ["a", 2000, "s6", 2], ["a", 2000, "s7", 1]], "expected": [null, null, null, true, false, true, false, true, false, false, true, false, true], "label": "streams with costs under two limits"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "start", "start", "finish", "finish", "start"], "args": [[10, 10], [1, 1], ["a", 5, "x"], ["a", 5, "y"], ["a", 6, "z"], ["x", 6], ["z", 6], ["a", 6, "w"]], "expected": [null, null, true, false, true, false, true, true], "label": "timeout of one millisecond"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "allow", "finish", "allow"], "args": [[10, 10], [1, 1000000000], ["a", 999999995, "x"], ["a", 1000000000], ["x", 1000000000], ["a", 1000000000]], "expected": [null, null, true, false, true, true], "label": "deadline beyond the last call"},
    {"ops": ["RateLimiter", "set_concurrency", "allow", "start", "allow", "allow", "allow", "finish", "start", "finish", "finish", "finish", "finish", "start", "start", "start", "start", "finish", "finish", "start", "start", "finish", "start", "start", "finish", "allow", "start", "finish", "finish", "start", "finish", "start", "finish", "finish", "allow", "start", "allow", "start", "start", "allow", "finish", "finish", "finish", "allow", "start", "allow", "finish"], "args": [[4, 20], [2, 20], ["b", 9, 3], ["a", 9, "r0", 3], ["a", 9], ["a", 9], ["b", 9], ["zz", 9], ["b", 9, "r1", 3], ["r1", 13], ["r0", 13], ["zz", 13], ["zz", 16], ["a", 17, "r2", 2], ["b", 17, "r3"], ["a", 22, "r4"], ["a", 27, "r5"], ["r3", 32], ["r0", 33], ["b", 38, "r6"], ["a", 38, "r7", 1], ["r0", 38], ["a", 46, "r8", 1], ["b", 52, "r9", 1], ["r1", 56], ["a", 64, 2], ["b", 64, "r10", 2], ["r0", 68], ["r3", 76], ["b", 76, "r11", 3], ["r2", 82], ["b", 82, "r12"], ["r1", 82], ["r1", 90], ["b", 91], ["b", 91, "r13", 3], ["a", 91, 2], ["b", 91, "r14"], ["a", 91, "r15"], ["b", 98, 1], ["r15", 106], ["r4", 109], ["r1", 109], ["b", 110], ["b", 110, "r16"], ["a", 115], ["r2", 118]], "expected": [null, null, true, true, true, false, true, false, false, false, true, false, false, false, false, false, false, false, false, true, true, false, false, true, false, false, false, false, false, false, false, true, false, false, true, false, true, false, true, false, true, false, false, true, false, true, false], "label": "random 1"},
    {"ops": ["RateLimiter", "set_concurrency", "allow", "allow", "start", "allow", "allow", "start", "finish", "start", "allow", "allow", "start", "start", "start", "finish", "finish", "finish", "start", "allow", "start", "finish", "allow", "finish", "finish", "start", "start", "finish", "allow", "allow", "start", "allow", "allow", "finish", "start", "finish", "start", "start", "finish", "allow", "start", "finish", "finish", "start", "finish", "finish", "finish"], "args": [[3, 20], [2, 5], ["b", 0, 1], ["b", 0], ["a", 0, "r0"], ["b", 6, 1], ["a", 9], ["a", 10, "r1", 1], ["r0", 11], ["a", 11, "r2", 1], ["a", 12], ["b", 15, 2], ["b", 16, "r3", 1], ["b", 24, "r4", 2], ["a", 24, "r5"], ["r2", 26], ["zz", 26], ["r0", 31], ["b", 31, "r6", 3], ["a", 34], ["a", 34, "r7", 3], ["r2", 34], ["a", 34], ["r3", 42], ["r7", 42], ["b", 45, "r8"], ["b", 51, "r9"], ["r6", 53], ["a", 54, 1], ["b", 56, 2], ["b", 60, "r10"], ["a", 60], ["b", 60], ["zz", 60], ["a", 60, "r11", 2], ["r9", 62], ["b", 64, "r12", 2], ["a", 67, "r13"], ["r1", 73], ["b", 73, 3], ["a", 73, "r14", 1], ["r3", 73], ["r10", 74], ["b", 78, "r15", 3], ["r8", 84], ["r6", 92], ["zz", 92]], "expected": [null, null, true, true, true, true, true, true, false, false, false, false, false, false, true, false, false, false, false, false, false, false, false, false, false, true, true, false, true, false, true, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false], "label": "random 2"},
    {"ops": ["RateLimiter", "set_concurrency", "start", "allow", "finish", "finish", "allow", "start", "finish", "start", "start", "start", "start", "allow", "finish", "finish", "start", "start", "allow", "start", "allow", "allow", "allow", "allow", "allow", "allow", "finish", "allow", "start", "start", "start", "start", "finish", "allow", "finish", "allow", "finish", "finish", "finish", "allow", "allow", "finish", "start", "start", "start", "start", "start"], "args": [[6, 10], [3, 22], ["b", 9, "r0"], ["a", 17], ["r0", 17], ["r0", 24], ["b", 27], ["b", 30, "r1"], ["r1", 31], ["a", 33, "r2", 1], ["b", 40, "r3", 3], ["b", 40, "r4", 1], ["a", 40, "r5", 3], ["b", 40], ["r5", 40], ["r1", 40], ["a", 43, "r6", 2], ["a", 43, "r7", 3], ["a", 49], ["b", 49, "r8"], ["b", 56, 2], ["b", 57], ["b", 57], ["a", 57], ["b", 57, 2], ["b", 65], ["r8", 65], ["b", 70], ["a", 70, "r9", 1], ["b", 78, "r10", 2], ["b", 85, "r11", 1], ["a", 85, "r12"], ["r2", 91], ["b", 94, 3], ["zz", 94], ["a", 94], ["zz", 95], ["r7", 101], ["r5", 101], ["b", 101], ["a", 107, 1], ["r8", 113], ["a", 117, "r13"], ["b", 119, "r14"], ["b", 119, "r15"], ["a", 123, "r16"], ["b", 123, "r17", 3]], "expected": [null, null, true, true, true, false, true, true, true, true, true, true, true, true, true, false, true, false, true, true, false, false, false, true, false, true, true, true, true, false, true, true, false, false, false, true, false, false, false, true, true, false, true, true, true, true, false], "label": "random 3"},
    {"ops": ["RateLimiter", "allow", "allow", "start", "start", "finish", "start", "start", "finish", "finish", "start", "start", "allow", "start", "allow", "start", "finish", "start", "allow", "start", "allow", "start", "allow", "start", "finish", "finish", "finish", "start", "start", "allow", "allow", "start", "start", "allow", "start", "allow", "start", "allow", "finish", "allow", "start", "finish", "finish", "start", "allow", "finish"], "args": [[6, 10], ["a", 5], ["a", 11, 1], ["a", 17, "r0"], ["a", 17, "r1"], ["zz", 17], ["b", 17, "r2"], ["a", 17, "r3", 2], ["r1", 17], ["r0", 25], ["b", 32, "r4", 1], ["b", 32, "r5"], ["b", 38, 2], ["a", 38, "r6", 3], ["a", 38, 2], ["b", 43, "r7"], ["r2", 47], ["b", 53, "r8"], ["a", 61], ["a", 61, "r9", 1], ["a", 64], ["a", 72, "r10"], ["b", 73], ["a", 73, "r11"], ["r10", 73], ["r7", 77], ["r3", 84], ["a", 85, "r12"], ["a", 85, "r13"], ["a", 85], ["a", 85, 2], ["b", 89, "r14", 2], ["b", 89, "r15"], ["b", 89], ["b", 92, "r16", 2], ["b", 92], ["b", 92, "r17", 3], ["a", 97], ["r4", 99], ["b", 105], ["a", 105, "r18"], ["r7", 105], ["r17", 105], ["a", 106, "r19"], ["b", 106], ["r8", 108]], "expected": [null, true, true, true, true, false, true, true, true, true, true, true, true, true, false, true, true, true, true, true, false, true, true, false, true, true, true, true, true, false, false, true, true, true, false, true, false, true, true, true, true, false, false, false, false, true], "label": "random, no slot limit"},
    {"argsPy": "r = rng(404)\nops = ['RateLimiter', 'set_concurrency']\nxs = [[100000, 1], [10000, 1000000000]]\nfor i in range(10000):\n    ops.append('start'); xs.append(['big', i, 'r' + str(i)])\nt, nxt = 10000, 10000\nfor _ in range(40000):\n    t += r.randint(0, 3)\n    x = r.random()\n    if x < 0.4:\n        ops.append('finish'); xs.append(['r' + str(r.randint(0, nxt - 1)), t])\n    elif x < 0.8:\n        ops.append('start'); xs.append(['big', t, 'r' + str(nxt)]); nxt += 1\n    else:\n        ops.append('allow'); xs.append(['big', t])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: one client keeps 10,000 streams open", "perf": true},
    {"argsPy": "r = rng(505)\nops = ['RateLimiter', 'add_limit', 'set_concurrency']\nxs = [[100000, 1], [50000, 2], [10000, 30000]]\nt, nxt, ids = 0, 0, []\nfor _ in range(49997):\n    t += r.randint(0, 2)\n    c = 'hot' if r.random() < 0.8 else 'c' + str(r.randint(1, 1000))\n    x = r.random()\n    if x < 0.6:\n        rid = 'q' + str(nxt); nxt += 1; ids.append(rid)\n        ops.append('start'); xs.append([c, t, rid, r.randint(1, 3)])\n    elif x < 0.85:\n        ops.append('finish'); xs.append([ids[r.randint(max(0, len(ids) - 20000), len(ids) - 1)], t])\n    else:\n        ops.append('allow'); xs.append([c, t, r.randint(1, 3)])\nargs = {'ops': ops, 'args': xs}", "expected": null, "label": "large: 50,000 calls with streams timing out", "perf": true},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow"], "args": [[10, 100], ["a", 0, 7], ["a", 0, 4], ["a", 0, 3], ["a", 250, 3], ["a", 300, 3]], "expected": [null, true, false, true, false, true], "label": "step 2: example 1"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow"], "args": [[2, 1000], [1, 100], ["c", 0], ["c", 50], ["c", 100], ["c", 200]], "expected": [null, null, true, false, true, false], "label": "step 2: example 2"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow"], "args": [[50, 10], [5, 1000], ["d", 0, 6], ["d", 1000000, 6], ["d", 1000000, 5]], "expected": [null, null, false, false, true], "label": "step 2: example 3"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow"], "args": [[5, 100], ["a", 0, 5], ["a", 0, 1], ["a", 499, 5], ["a", 500, 5]], "expected": [null, true, false, false, true], "label": "step 2: cost equal to a full bucket"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow"], "args": [[3, 10], ["a", 0, 4], ["a", 0, 3], ["a", 1000000000, 4], ["a", 1000000000, 3]], "expected": [null, false, true, false, true], "label": "step 2: a cost above capacity never passes"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow"], "args": [[10, 10], ["a", 0, 8], ["a", 5, 3], ["a", 5, 2], ["a", 10, 1], ["a", 10, 1]], "expected": [null, true, false, true, true, false], "label": "step 2: a refused request takes nothing"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[10, 100], ["a", 0, 10], ["a", 250, 3], ["a", 299, 3], ["a", 300, 3], ["a", 350, 1], ["a", 400, 1]], "expected": [null, true, false, false, true, false, true], "label": "step 2: partial refill with costs"},
    {"ops": ["RateLimiter", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[2, 100], ["a", 0], ["a", 0, 1], ["a", 0], ["a", 100, 1], ["a", 200], ["a", 200, 1]], "expected": [null, true, true, false, true, true, false], "label": "step 2: cost given as 1 and left out are the same"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[1, 100], [2, 1000], ["c", 0], ["c", 50], ["c", 100], ["c", 200], ["c", 1000], ["c", 1100]], "expected": [null, null, true, false, true, false, true, false], "label": "step 2: the first limit refuses, the second keeps its tokens"},
    {"ops": ["RateLimiter", "add_limit", "add_limit", "add_limit", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 1000], [3, 1000], [1, 100], [10, 10], [10, 10], ["a", 0], ["a", 50], ["a", 100], ["a", 150], ["a", 200], ["a", 250], ["a", 300]], "expected": [null, null, null, null, null, true, false, true, false, true, false, false], "label": "step 2: the third of five limits refuses, the first two keep their tokens"},
    {"ops": ["RateLimiter", "add_limit", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[10, 1000], [20, 500], [4, 10], ["a", 0, 4], ["a", 20, 4], ["a", 20, 2], ["a", 40, 4], ["a", 1000, 4], ["a", 1000, 3]], "expected": [null, null, null, true, false, true, false, true, false], "label": "step 2: the last limit refuses a big request, a small one still fits"},
    {"ops": ["RateLimiter", "add_limit", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[4, 50], [6, 200], [10, 1000], ["a", 0, 3], ["a", 10, 2], ["a", 100, 2], ["a", 150, 2], ["a", 400, 2], ["a", 600, 1], ["a", 1000, 3], ["a", 5000, 4], ["a", 5000, 1], ["a", 5050, 1], ["a", 5200, 2]], "expected": [null, null, null, true, false, true, false, true, true, true, true, false, false, false], "label": "step 2: each limit is the tight one in turn"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow"], "args": [[3, 100], [3, 100], ["a", 0, 2], ["a", 0, 2], ["a", 100, 2], ["a", 150, 1], ["a", 250, 2]], "expected": [null, null, true, false, true, false, false], "label": "step 2: the same limit added twice"},
    {"ops": ["RateLimiter", "add_limit", "allow", "allow", "allow", "allow", "allow", "allow"], "args": [[5, 100], [2, 1000], ["a", 0, 2], ["b", 0, 2], ["a", 10, 1], ["b", 1000, 2], ["a", 1000, 2], ["c", 1000, 3]], "expected": [null, null, true, true, false, false, false, false], "label": "step 2: every client gets a bucket for every limit"},
