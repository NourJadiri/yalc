{
  "id": "checkout-1",
  "title": "Checkout: Scan and Total",
  "difficulty": "E",
  "topics": ["design", "hash map"],
  "kind": "design",
  "className": "Checkout",
  "starter": "class Checkout:\n\n    def __init__(self):\n        pass\n\n    def add_product(self, sku: str, name: str, price: int) -> bool:\n        pass\n\n    def scan(self, sku: str, qty: int = 1) -> bool:\n        pass\n\n    def total(self) -> int:\n        pass\n",
  "tests": [
    {"ops": ["Checkout", "add_product", "add_product", "scan", "scan", "scan", "total"], "args": [[], ["MILK", "Milk", 129], ["EGGS", "Eggs", 349], ["MILK"], ["EGGS", 2], ["MILK"], []], "expected": [null, true, true, true, true, true, 956], "show": true},
    {"ops": ["Checkout", "add_product", "scan", "add_product", "scan", "total"], "args": [[], ["TEA", "Green Tea", 450], ["COFFEE"], ["TEA", "Black Tea", 399], ["TEA", 3], []], "expected": [null, true, false, false, true, 1350], "show": true},
    {"ops": ["Checkout", "total", "scan", "add_product", "scan", "total"], "args": [[], [], ["JAM"], ["JAM", "Jam", 275], ["JAM", 4], []], "expected": [null, 0, false, true, true, 1100], "show": true},
    {"ops": ["Checkout", "scan", "scan", "total"], "args": [[], ["A1"], ["A1", 5], []], "expected": [null, false, false, 0], "label": "scan with an empty catalog"},
    {"ops": ["Checkout", "add_product", "scan", "add_product", "scan", "total"], "args": [[], ["SOAP", "Soap", 199], ["SOAP"], ["SOAP", "Soap", 249], ["SOAP", 2], []], "expected": [null, true, true, false, true, 597], "label": "a taken sku keeps its first price"},
    {"ops": ["Checkout", "add_product", "add_product", "add_product", "scan", "total"], "args": [[], ["X9", "Rice", 300], ["X9", "Rice", 100], ["X9", "Pasta", 300], ["X9"], []], "expected": [null, true, false, false, true, 300], "label": "the same sku offered three times"},
    {"ops": ["Checkout", "add_product", "add_product", "scan", "total", "add_product", "scan", "total"], "args": [[], ["OIL", "Olive Oil", 899], ["SALT", "Salt", 89], ["OIL"], [], ["OIL", "Sunflower Oil", 1], ["OIL", 2], []], "expected": [null, true, true, true, 899, false, true, 2697], "label": "a refused add_product between scans"},
    {"ops": ["Checkout", "add_product", "scan", "scan", "total"], "args": [[], ["PEN", "Pen", 120], ["PEN", 1], ["PEN"], []], "expected": [null, true, true, true, 240], "label": "qty 1 written out equals the default"},
    {"ops": ["Checkout", "add_product", "scan", "total"], "args": [[], ["GOLD", "Gold Bar", 100000], ["GOLD", 10000], []], "expected": [null, true, true, 1000000000], "label": "the largest line"},
    {"ops": ["Checkout", "add_product", "scan", "total", "scan", "total"], "args": [[], ["GUM", "Gum", 1], ["GUM"], [], ["GUM", 1], []], "expected": [null, true, true, 1, true, 2], "label": "the smallest price"},
    {"ops": ["Checkout", "add_product", "scan", "total", "total", "total"], "args": [[], ["CAKE", "Cake", 1250], ["CAKE", 2], [], [], []], "expected": [null, true, true, 2500, 2500, 2500], "label": "total changes nothing"},
    {"ops": ["Checkout", "add_product", "scan", "scan", "scan", "total"], "args": [[], ["BEAN", "Beans", 95], ["BEAN"], ["BEANS", 4], ["BEAN", 3], []], "expected": [null, true, true, false, true, 380], "label": "a failed scan between good ones adds nothing"},
    {"ops": ["Checkout", "add_product", "scan", "add_product", "scan", "total", "add_product", "scan", "total"], "args": [[], ["A", "Apple Pie", 400], ["A"], ["B", "Bun", 60], ["B", 3], [], ["C", "Cola", 150], ["C"], []], "expected": [null, true, true, true, true, 580, true, true, 730], "label": "products added between scans"},
    {"ops": ["Checkout", "add_product", "scan", "total", "scan", "total", "scan", "total", "scan", "total", "scan", "total", "scan", "total"], "args": [[], ["LEMON", "Lemon", 45], ["LEMON"], [], ["LEMON", 3], [], ["LEMON"], [], ["LEMON", 10], [], ["LEMON", 1], [], ["LEMON", 7], []], "expected": [null, true, true, 45, true, 180, true, 225, true, 675, true, 720, true, 1035], "label": "one sku scanned many times"},
    {"ops": ["Checkout", "scan", "add_product", "add_product", "scan", "total", "add_product", "total", "scan", "scan", "scan", "total", "scan", "total", "scan", "add_product", "scan", "scan", "scan", "total", "add_product", "scan", "add_product", "total", "add_product", "add_product", "total", "scan", "scan", "scan", "total", "add_product", "total", "add_product", "total", "scan", "add_product", "scan", "total", "total", "add_product"], "args": [[], ["E5", 15], ["E5", "Cherry Tomatoes", 645], ["C3", "Bread", 93], ["D4", 20], [], ["A1", "Bread", 901], [], ["E5", 3829], ["F6"], ["D4", 4162], [], ["A1"], [], ["4011"], ["A1", "Oats", 702], ["A1", 13], ["B2", 9], ["A1", 4], [], ["D4", "Oats", 499], ["B2", 6869], ["D4", "Bread", 35363], [], ["B2", "Cherry Tomatoes", 875], ["B2", "Bread", 453], [], ["C3", 3], ["B2"], ["E5", 19], [], ["B2", "Eggs", 931], [], ["F6", "Rice", 90044], [], ["D4"], ["E5", "Eggs", 96971], ["4011", 16], [], [], ["D4", "Rice", 670]], "expected": [null, false, true, true, false, 0, true, 0, true, false, false, 2469705, true, 2470606, false, false, true, false, true, 2485923, true, false, false, 2485923, true, false, 2485923, true, true, true, 2499332, false, 2499332, true, 2499332, true, false, false, 2499831, 2499831, false], "label": "random 1"},
    {"ops": ["Checkout", "scan", "add_product", "scan", "add_product", "scan", "total", "add_product", "total", "add_product", "add_product", "total", "scan", "scan", "scan", "scan", "scan", "add_product", "scan", "scan", "scan", "scan", "scan", "scan", "scan", "total", "total", "total", "add_product", "scan", "total", "total", "scan", "scan", "total", "total", "add_product", "scan", "scan", "scan", "scan"], "args": [[], ["F6", 2337], ["C3", "Cherry Tomatoes", 84333], ["E5"], ["E5", "Bread", 451], ["B2"], [], ["F6", "Oats", 89318], [], ["A1", "Oats", 937], ["D4", "Cherry Tomatoes", 86621], [], ["E5", 2], ["A1", 9765], ["D4", 3144], ["C3", 13], ["C3", 17], ["4011", "Oats", 441], ["D4"], ["E5"], ["B2"], ["D4"], ["F6", 7525], ["C3", 16], ["E5", 7], [], [], [], ["4011", "Milk", 514], ["C3", 17], [], [], ["C3", 8639], ["C3"], [], [], ["C3", "Rice", 6029], ["4011", 3508], ["A1", 2159], ["B2"], ["A1", 20]], "expected": [null, false, true, false, true, false, 0, true, 0, true, true, 0, true, true, true, true, true, true, true, true, false, true, true, true, true, 957661249, 957661249, 957661249, false, true, 959094910, 959094910, true, true, 1687732030, 1687732030, false, true, true, false, true], "label": "random 2"},
    {"ops": ["Checkout", "scan", "total", "scan", "scan", "total", "scan", "total", "total", "total", "total", "scan", "total", "scan", "scan", "scan", "add_product", "scan", "scan", "scan", "add_product", "add_product", "scan", "total", "scan", "total", "add_product", "scan", "add_product", "total", "total", "scan", "total", "add_product", "total", "scan", "add_product", "scan", "total", "scan", "scan"], "args": [[], ["F6", 6], [], ["B2"], ["B2", 1], [], ["A1", 1392], [], [], [], [], ["4011"], [], ["D4", 14], ["E5", 9], ["F6", 6], ["C3", "Eggs", 60223], ["D4", 19], ["B2", 1201], ["D4", 14], ["4011", "Tea", 58343], ["D4", "Tea", 32936], ["4011", 17], [], ["E5"], [], ["E5", "Tea", 584], ["B2", 18], ["D4", "Tea", 610], [], [], ["E5"], [], ["C3", "Eggs", 579], [], ["4011", 5238], ["E5", "Rice", 530], ["C3", 13], [], ["F6", 4237], ["C3", 4709]], "expected": [null, false, 0, false, false, 0, false, 0, 0, 0, 0, false, 0, false, false, false, true, false, false, false, true, true, true, 991831, false, 991831, true, false, false, 991831, 991831, true, 992415, false, 992415, true, false, true, 307375948, false, true], "label": "random 3"},
    {"argsPy": "r = rng(101)\nops, xs = [\"Checkout\"], [[]]\nfor i in range(1000):\n    ops.append(\"add_product\"); xs.append([\"P\" + str(i), \"Item\", r.randint(1, 10**5)])\nfor _ in range(40000):\n    ops.append(\"scan\"); xs.append([\"P\" + str(r.randrange(1000)), r.randint(1, 10**4)])\n    ops.append(\"total\"); xs.append([])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: a total after every scan", "perf": true},
    {"argsPy": "r = rng(202)\nops, xs = [\"Checkout\"], [[]]\nfor i in range(500):\n    ops.append(\"add_product\"); xs.append([\"S\" + str(i), \"Thing\", r.randint(1, 1000)])\nfor _ in range(45000):\n    sku = \"S\" + str(r.randrange(500))\n    ops.append(\"scan\"); xs.append([sku] if r.random() < 0.5 else [sku, r.randint(1, 50)])\nfor _ in range(25000):\n    x = r.random()\n    if x < 0.6:\n        ops.append(\"total\"); xs.append([])\n    elif x < 0.8:\n        ops.append(\"scan\"); xs.append([\"S\" + str(r.randrange(1000))])\n    elif x < 0.9:\n        ops.append(\"add_product\"); xs.append([\"S\" + str(r.randrange(1000)), \"Late\", r.randint(1, 1000)])\n    else:\n        ops.append(\"scan\"); xs.append([\"S\" + str(r.randrange(500)), r.randint(1, 10**4)])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 45,000 lines, then totals and refused calls", "perf": true}
  ]
