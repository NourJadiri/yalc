{
  "id": "file-system-2",
  "title": "File System: Sizes",
  "difficulty": "M",
  "topics": ["design", "trie", "caching"],
  "kind": "design",
  "className": "FileSystem",
  "starter": "class FileSystem:\n\n    def __init__(self):\n        pass\n\n    def mkdir(self, path: str) -> bool:\n        pass\n\n    def write(self, path: str, content: str) -> bool:\n        pass\n\n    def read(self, path: str) -> Optional[str]:\n        pass\n\n    def ls(self, path: str) -> List[str]:\n        pass\n\n    def size(self, path: str) -> int:\n        pass\n",
  "tests": [
    {"ops": ["FileSystem", "mkdir", "write", "write", "size", "size", "size", "size"], "args": [[], ["/music/live"], ["/music/a.mp3", "12345"], ["/music/live/b.mp3", "123"], ["/music"], ["/music/live"], ["/music/a.mp3"], ["/"]], "expected": [null, true, true, true, 8, 3, 5, 8], "show": true},
    {"ops": ["FileSystem", "mkdir", "write", "size", "write", "size", "size", "size"], "args": [[], ["/a"], ["/a/f", "hello"], ["/a"], ["/a/f", "hi"], ["/a"], ["/a/f"], ["/"]], "expected": [null, true, true, 5, true, 2, 2, 2], "show": true},
    {"ops": ["FileSystem", "mkdir", "write", "size", "size", "size", "write", "size"], "args": [[], ["/e"], ["/e/blank", ""], ["/e/blank"], ["/e"], ["/e/nothing"], ["/e", "oops"], ["/"]], "expected": [null, true, true, 0, 0, -1, false, 0], "show": true},
    {"ops": ["FileSystem", "size", "size", "mkdir", "size", "size", "size"], "args": [[], ["/"], ["/x"], ["/x/y"], ["/x"], ["/x/y"], ["/"]], "expected": [null, 0, -1, true, 0, 0, 0], "label": "a new file system and empty folders"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "write", "write", "size", "size", "size", "size", "size", "size"], "args": [[], ["/a/b/c/d"], ["/a/f1", "1"], ["/a/b/f2", "22"], ["/a/b/c/f3", "333"], ["/a/b/c/d/f4", "4444"], ["/"], ["/a"], ["/a/b"], ["/a/b/c"], ["/a/b/c/d"], ["/a/b/c/d/f4"]], "expected": [null, true, true, true, true, true, 10, 10, 9, 7, 4, 4], "label": "files at every depth count"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "size", "size", "size", "size"], "args": [[], ["/p/q"], ["/p/q/f", "ab"], ["/p/q/f", "abcdef"], ["/p/q/f"], ["/p/q"], ["/p"], ["/"]], "expected": [null, true, true, true, 6, 6, 6, 6], "label": "overwrite with longer content"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "size", "write", "size", "write", "size", "size", "size"], "args": [[], ["/p/q"], ["/p/q/f", "abcdef"], ["/p/q/f", "abc"], ["/p"], ["/p/q/f", "abc"], ["/p"], ["/p/q/f", ""], ["/p/q/f"], ["/p"], ["/"]], "expected": [null, true, true, true, 3, true, 3, true, 0, 0, 0], "label": "shrink, the same again, then empty"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "write", "write", "write", "write", "size", "size", "size"], "args": [[], ["/d"], ["/d/f", "aaaa"], ["/d/f", "bb"], ["/d/f", "cccccc"], ["/d/f", "d"], ["/d/g", "xyz"], ["/d/f", "eeeee"], ["/d/f"], ["/d"], ["/"]], "expected": [null, true, true, true, true, true, true, true, 5, 8, 8], "label": "many overwrites of one file"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "write", "write", "write", "size", "size", "size"], "args": [[], ["/d/sub"], ["/d/f", "abc"], ["/d/sub", "zzzzzz"], ["/d/missing/f", "zz"], ["/d/f/g", "zz"], ["/", "zz"], ["/d"], ["/d/sub"], ["/"]], "expected": [null, true, true, false, false, false, false, 3, 0, 3], "label": "writes that fail change no size"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "mkdir", "mkdir", "size", "size", "size", "size", "size"], "args": [[], ["/a"], ["/a/f", "12345"], ["/a/b/c"], ["/a/f/x"], ["/a/f"], ["/a"], ["/a/b"], ["/a/b/c"], ["/a/f/x"], ["/"]], "expected": [null, true, true, true, false, false, 5, 0, 0, -1, 5], "label": "mkdir changes no size"},
    {"ops": ["FileSystem", "mkdir", "mkdir", "mkdir", "write", "write", "write", "write", "size", "size", "size", "size", "size"], "args": [[], ["/a"], ["/ab"], ["/b"], ["/a/x", "1"], ["/ab/x", "22"], ["/b/x", "333"], ["/abc", "4444"], ["/a"], ["/ab"], ["/b"], ["/abc"], ["/"]], "expected": [null, true, true, true, true, true, true, true, 1, 2, 3, 4, 10], "label": "neighbours keep separate totals"},
    {"ops": ["FileSystem", "write", "size", "size", "size", "mkdir", "size"], "args": [[], ["/f", "abc"], ["/f"], ["/f/g"], ["/f/g/h"], ["/d"], ["/d/f"]], "expected": [null, true, 3, -1, -1, true, -1], "label": "paths through a file or missing"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "size", "size", "size", "write", "size"], "args": [[], ["/t"], ["/t/big", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"], ["/t/sp", "a b c"], ["/t/big"], ["/t/sp"], ["/t"], ["/t/big", "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"], ["/t"]], "expected": [null, true, true, true, 100, 5, 105, true, 105], "label": "the longest content, and spaces count"},
    {"argsPy": "ops, xs, p = [\"FileSystem\"], [[]], \"\"\nfor i in range(99):\n    p += \"/n\" + str(i)\nops.append(\"mkdir\"); xs.append([p])\nops.append(\"write\"); xs.append([p + \"/f\", \"abcdefghij\"])\nops.append(\"write\"); xs.append([\"/n0/g\", \"abc\"])\nfor q in [\"/\", \"/n0\", \"/n0/n1\", p, p + \"/f\", p + \"/x\"]:\n    ops.append(\"size\"); xs.append([q])\nops.append(\"write\"); xs.append([p + \"/f\", \"a\"])\nops.append(\"size\"); xs.append([\"/n0/n1\"])\nargs = {\"ops\": ops, \"args\": xs}", "expected": [null, true, true, true, 13, 13, 10, 10, 10, -1, true, 1], "label": "a path of 100 names"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "write", "read", "size", "size", "mkdir", "mkdir", "write", "read", "write", "read", "mkdir", "read", "size", "size", "write", "read", "write", "size", "write", "read", "read", "write", "read", "write", "size", "read", "size", "read", "write", "read", "size", "write", "mkdir", "size", "write", "read", "write", "write", "write", "write", "size", "read"], "args": [[], ["/a.b"], ["/a.b/_c", " y "], ["/a"], ["/a.b/_c", "xx "], ["/a.b/_c/a"], ["/a.b"], ["/a.b"], ["/_c"], ["/_c/a"], ["/_c/a/a.b", "z"], ["/a.b/a/a"], ["/b", ""], ["/a.b/_c"], ["/a/_c"], ["/_c/a/_c"], ["/a"], ["/_c/a"], ["/b", "yz"], ["/b"], ["/_c/b", "y"], ["/b/_c/b"], ["/_c/a", ""], ["/a.b/_c"], ["/a.b/_c"], ["/_c", "xyy"], ["/_c/a/a.b"], ["/_c/a/a", "yxz"], ["/"], ["/a.b/b/a"], ["/_c/b"], ["/a.b/a/b"], ["/_c/a/a", ""], ["/b"], ["/"], ["/a/b", "x"], ["/a/_c/a.b"], ["/a.b/a.b"], ["/_c/a", ""], ["/_c"], ["/_c/b", ""], ["/_c/a/b", "y "], ["/a/_c/b", "x"], ["/_c/a", "x"], ["/_c/a/a"], ["/_c"]], "expected": [null, true, true, true, true, null, 3, 3, true, true, true, null, true, "xx ", true, null, 0, 1, true, "yz", true, -1, false, "xx ", "xx ", false, "z", true, 10, null, 1, null, true, "yz", 7, true, true, -1, false, null, true, true, true, false, 0, null], "label": "random 1"},
    {"ops": ["FileSystem", "size", "ls", "size", "size", "ls", "write", "mkdir", "size", "ls", "write", "ls", "write", "size", "read", "size", "ls", "mkdir", "ls", "read", "size", "mkdir", "write", "size", "ls", "write", "write", "ls", "size", "mkdir", "write", "size", "write", "ls", "mkdir", "mkdir", "write", "mkdir", "ls", "write", "write", "ls", "write", "ls", "ls", "write"], "args": [[], ["/b"], ["/a"], ["/"], ["/"], ["/a.b"], ["/b", ""], ["/b"], ["/"], ["/b"], ["/a.b", "yzx"], ["/b"], ["/a.b", ""], ["/"], ["/b"], ["/a.b/b/b"], ["/"], ["/_c"], ["/"], ["/a.b"], ["/a/a.b"], ["/b"], ["/_c/b", " "], ["/_c"], ["/a"], ["/_c/_c", "zzy"], ["/_c/_c", "xzy"], ["/"], ["/_c/_c"], ["/_c"], ["/b", ""], ["/b"], ["/", ""], ["/_c/b"], ["/a/a"], ["/b/a"], ["/_c/a.b", " z"], ["/_c/_c"], ["/_c/a.b"], ["/a/a/b", "x"], ["/b/a.b/a.b", "z"], ["/a/a"], ["/a/b", ""], ["/_c/b"], ["/_c/b"], ["/_c", ""]], "expected": [null, -1, [], 0, 0, [], true, false, 0, ["b"], true, ["b"], true, 0, "", -1, ["a.b", "b"], true, ["_c", "a.b", "b"], "", -1, false, true, 1, [], true, true, ["_c", "a.b", "b"], 3, true, true, 0, false, ["b"], true, false, true, false, ["a.b"], true, false, ["b"], true, ["b"], ["b"], false], "label": "random 2"},
    {"ops": ["FileSystem", "mkdir", "size", "ls", "read", "write", "mkdir", "mkdir", "ls", "mkdir", "ls", "write", "size", "write", "size", "size", "write", "mkdir", "write", "size", "write", "size", "mkdir", "mkdir", "write", "write", "write", "mkdir", "size", "write", "write", "write", "size", "mkdir", "write", "write", "mkdir", "ls", "mkdir", "mkdir", "size", "ls", "mkdir", "write", "write", "mkdir"], "args": [[], ["/a"], ["/a/b/a.b"], ["/a.b"], ["/a/b"], ["/a.b/b", ""], ["/b/_c/a.b"], ["/b/_c/a.b"], ["/b"], ["/a"], ["/b"], ["/b", "x x"], ["/a/b/a"], ["/a/_c", "xy"], ["/a"], ["/a"], ["/a/_c", ""], ["/a/a"], ["/a/_c", ""], ["/a/_c"], ["/_c", "z "], ["/b"], ["/b/b"], ["/b/_c/a.b"], ["/a/a/_c", "xxx"], ["/a/_c", "zz "], ["/a/a/b", "z"], ["/b/a.b"], ["/a/a/_c"], ["/a/a/_c", ""], ["/_c/a", "  x"], ["/b/_c/_c", "x"], ["/b/_c/_c"], ["/a/a.b"], ["/b", "y"], ["/b", ""], ["/b/a/a"], ["/b/a/a"], ["/b"], ["/a"], ["/_c/_c/a.b"], ["/a/a/b"], ["/a/a.b/a"], ["/b/a/a", "x"], ["/_c", " yz"], ["/a/a"]], "expected": [null, true, -1, [], null, false, true, true, ["_c"], true, ["_c"], false, -1, true, 2, 2, true, true, true, 0, true, 0, true, true, true, true, true, true, 3, true, false, true, 1, true, false, false, true, [], true, true, -1, ["b"], true, false, true, true], "label": "random 3"},
    {"ops": ["FileSystem", "write", "write", "write", "mkdir", "read", "write", "write", "read", "ls", "size", "ls", "mkdir", "write", "read", "size", "mkdir", "write", "size", "mkdir", "mkdir", "size", "size", "ls", "read", "ls", "mkdir", "write", "ls", "read", "mkdir", "ls", "write", "size", "size", "write", "read", "size", "mkdir", "write", "size", "read", "size", "write", "ls", "size"], "args": [[], ["/_c", "zxy"], ["/a.b", "y"], ["/_c", "yzz"], ["/b"], ["/a.b"], ["/b/a.b", " "], ["/b/a.b", " "], ["/a.b/_c"], ["/b/b"], ["/b/a.b"], ["/b/a.b"], ["/b/a.b"], ["/a.b/a.b", "zyy"], ["/_c"], ["/b/a.b"], ["/_c"], ["/b/_c", "yzz"], ["/b/a.b"], ["/b/a.b"], ["/b/a"], ["/"], ["/b/a/a.b"], ["/a.b/a.b"], ["/b/a/a"], ["/b"], ["/b/a.b"], ["/a.b", ""], ["/b/a"], ["/_c"], ["/b/a/a.b"], ["/b"], ["/b/a/a.b", ""], ["/b/a/a.b"], ["/b/a.b"], ["/b/b", ""], ["/b/a/a.b"], ["/b/a/b"], ["/_c/a.b/b"], ["/a", "yy"], ["/b"], ["/b/a"], ["/b/a/a.b"], ["/b/a.b", ""], ["/b/_c"], ["/b/a.b"]], "expected": [null, true, true, true, true, "y", true, true, null, [], 1, ["a.b"], false, false, "yzz", 1, false, true, 1, false, true, 8, -1, [], null, ["_c", "a", "a.b"], false, true, [], "yzz", true, ["_c", "a", "a.b"], false, 0, 1, true, null, -1, false, true, 4, null, 0, true, ["_c"], 0], "label": "random 4"},
    {"argsPy": "r = rng(2)\nops, xs, levels = [\"FileSystem\"], [[]], []\nfor t in range(100):\n    p = \"/t\" + str(t)\n    levels.append(p)\n    for i in range(1, 99):\n        p += \"/d\" + str(i)\n        levels.append(p)\n    ops.append(\"mkdir\"); xs.append([p])\nfiles = []\nfor k in range(2500):\n    f = r.choice(levels) + \"/f\" + str(k)\n    files.append(f)\n    ops.append(\"write\"); xs.append([f, \"x\" * r.randint(0, 100)])\nfor k in range(5000):\n    ops.append(\"write\"); xs.append([r.choice(files), \"y\" * r.randint(0, 100)])\n    ops.append(\"size\"); xs.append([\"/\"])\n    if k % 5 == 0:\n        ops.append(\"size\"); xs.append([r.choice(levels)])\nargs = {\"ops\": ops, \"args\": xs}", "expected": null, "label": "large: 7,500 writes among 9,900 folders, size after each", "perf": true},
    {"ops": ["FileSystem", "mkdir", "write", "write", "ls", "ls", "read"], "args": [[], ["/docs/drafts"], ["/docs/todo.txt", "call bob"], ["/docs/drafts/a.md", "hi"], ["/docs"], ["/docs/todo.txt"], ["/docs/drafts/a.md"]], "expected": [null, true, true, true, ["drafts", "todo.txt"], ["todo.txt"], "hi"], "label": "step 1: example 1"},
    {"ops": ["FileSystem", "write", "mkdir", "write", "mkdir", "mkdir", "write", "read"], "args": [[], ["/logs/a.txt", "x"], ["/logs"], ["/logs/a.txt", "x"], ["/logs/a.txt/old"], ["/logs/a.txt"], ["/logs", "y"], ["/logs"]], "expected": [null, false, true, true, false, false, false, null], "label": "step 1: example 2"},
    {"ops": ["FileSystem", "ls", "write", "write", "read", "write", "read", "ls", "ls"], "args": [[], ["/"], ["/b", "old"], ["/b", "new"], ["/b"], ["/a", ""], ["/a"], ["/"], ["/c"]], "expected": [null, [], true, true, "new", true, "", ["a", "b"], []], "label": "step 1: example 3"},
    {"ops": ["FileSystem", "ls", "read", "mkdir", "ls", "read"], "args": [[], ["/"], ["/"], ["/"], ["/"], ["/nothing"]], "expected": [null, [], null, true, [], null], "label": "step 1: a new file system"},
    {"ops": ["FileSystem", "mkdir", "ls", "ls", "ls", "ls", "ls"], "args": [[], ["/a/b/c/d"], ["/"], ["/a"], ["/a/b"], ["/a/b/c"], ["/a/b/c/d"]], "expected": [null, true, ["a"], ["b"], ["c"], ["d"], []], "label": "step 1: mkdir makes every missing folder"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "mkdir", "ls", "read", "mkdir", "ls"], "args": [[], ["/x"], ["/x/f", "1"], ["/x"], ["/"], ["/x"], ["/x/f"], ["/x/y"], ["/x"]], "expected": [null, true, true, true, true, ["f"], "1", true, ["f", "y"]], "label": "step 1: mkdir on folders that already exist"},
    {"ops": ["FileSystem", "write", "mkdir", "read", "ls", "ls"], "args": [[], ["/notes", "keep"], ["/notes"], ["/notes"], ["/notes"], ["/"]], "expected": [null, true, false, "keep", ["notes"], ["notes"]], "label": "step 1: mkdir onto an existing file changes nothing"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "ls", "ls", "read", "write", "mkdir", "ls"], "args": [[], ["/a/b"], ["/a/b/f.txt", ""], ["/a/b/f.txt/c/d"], ["/a/b/f.txt/c"], ["/a/b"], ["/a/b/f.txt"], ["/top", "t"], ["/top/x"], ["/"]], "expected": [null, true, true, false, [], ["f.txt"], "", true, false, ["a", "top"]], "label": "step 1: mkdir through a file changes nothing"},
    {"ops": ["FileSystem", "write", "mkdir", "write", "ls", "mkdir", "write", "read"], "args": [[], ["/a/b/c.txt", "x"], ["/a"], ["/a/b/c.txt", "x"], ["/a"], ["/a/b"], ["/a/b/c.txt", "x"], ["/a/b/c.txt"]], "expected": [null, false, true, false, [], true, true, "x"], "label": "step 1: write never makes folders"},
    {"ops": ["FileSystem", "write", "write", "read", "read", "ls", "ls"], "args": [[], ["/f", "1"], ["/f/g", "2"], ["/f/g"], ["/f"], ["/f"], ["/f/g"]], "expected": [null, true, false, null, "1", ["f"], []], "label": "step 1: write under a file"},
    {"ops": ["FileSystem", "mkdir", "write", "write", "ls", "read", "ls", "read"], "args": [[], ["/d/e"], ["/d/e", "x"], ["/", "x"], ["/d/e"], ["/d/e"], ["/"], ["/"]], "expected": [null, true, false, false, [], null, ["d"], null], "label": "step 1: write onto a folder or the root"},
    {"ops": ["FileSystem", "mkdir", "write", "ls", "read", "write", "ls"], "args": [[], ["/x.txt"], ["/x.txt", "a"], ["/x.txt"], ["/x.txt"], ["/x.txt/y", "b"], ["/x.txt"]], "expected": [null, true, false, [], null, true, ["y"]], "label": "step 1: a folder named like a file"},
    {"ops": ["FileSystem", "write", "write", "read", "write", "read", "ls", "write", "read"], "args": [[], ["/f", "first"], ["/f", "second"], ["/f"], ["/f", ""], ["/f"], ["/"], ["/f", "third"], ["/f"]], "expected": [null, true, true, "second", true, "", ["f"], true, "third"], "label": "step 1: overwriting keeps one file"},
    {"ops": ["FileSystem", "mkdir", "read", "read", "ls", "mkdir", "ls", "ls", "ls", "read"], "args": [[], ["/d"], ["/d"], ["/d/x"], ["/x"], ["/x/y"], ["/x/y/z"], ["/x/z"], ["/xy"], ["/x/y/z"]], "expected": [null, true, null, null, [], true, [], [], [], null], "label": "step 1: folders and missing paths"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "write", "write", "mkdir", "write", "write", "mkdir", "write", "mkdir", "write", "ls"], "args": [[], ["/s"], ["/s/zeta", ""], ["/s/_tmp"], ["/s/10", ""], ["/s/9", ""], ["/s/-dash"], ["/s/.dot", ""], ["/s/a_b", ""], ["/s/a.b"], ["/s/a-b", ""], ["/s/alpha"], ["/s/a", ""], ["/s"]], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, ["-dash", ".dot", "10", "9", "_tmp", "a", "a-b", "a.b", "a_b", "alpha", "zeta"]], "label": "step 1: ls sorts by character code"},
    {"ops": ["FileSystem", "mkdir", "write", "ls", "ls"], "args": [[], ["/a/b/c"], ["/a/b/c/report.v2.txt", "r"], ["/a/b/c/report.v2.txt"], ["/a/b/c"]], "expected": [null, true, true, ["report.v2.txt"], ["report.v2.txt"]], "label": "step 1: ls of a file gives only its name"},
    {"ops": ["FileSystem", "mkdir", "mkdir", "write", "mkdir", "read", "read", "ls", "ls", "write", "read", "ls"], "args": [[], ["/a"], ["/b"], ["/a/x", "in a"], ["/b/x"], ["/a/x"], ["/b/x"], ["/a/x"], ["/b/x"], ["/b/x/x", "in b"], ["/b/x/x"], ["/b"]], "expected": [null, true, true, true, true, "in a", null, ["x"], [], true, "in b", ["x"]], "label": "step 1: the same name in two folders"},
    {"ops": ["FileSystem", "mkdir", "write", "mkdir", "write", "ls", "ls", "read", "read", "mkdir", "ls", "ls"], "args": [[], ["/a"], ["/ab", "t"], ["/a/c"], ["/abc", "u"], ["/a"], ["/"], ["/a"], ["/ab"], ["/ab/x"], ["/ab"], ["/a/c"]], "expected": [null, true, true, true, true, ["c"], ["a", "ab", "abc"], null, "t", false, ["ab"], []], "label": "step 1: a name that starts another name"},
